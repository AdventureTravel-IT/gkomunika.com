{% style %}
  .gkab {
    --gkab-blue: #005496;
    --gkab-sky: #00adee;
    --gkab-sky-60: #66cef5;
    --gkab-tint: #f3fbfe;
    --gkab-tint-2: #dbf5ff;
    --gkab-ink: #222222;
    --gkab-muted: #4a5560;
    --gkab-line: #d9e6ee;
    --gkab-white: #ffffff;
    --gkab-font-head: "Gotham Rounded", "Gotham", system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
    --gkab-font-body: "Gotham", system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif;

    font-family: var(--gkab-font-body);
    font-size: 16px;
    line-height: 1.65;
    color: var(--gkab-ink);
    background: var(--gkab-white);
    -webkit-text-size-adjust: 100%;
    width: 100%;
    margin: 0 auto;
  }
  .gkab *,
  .gkab *::before,
  .gkab *::after { box-sizing: border-box; }
  :where(.gkab) :where(h1, h2, h3, p, dl, dd, ul, ol, figure, blockquote) { margin: 0; padding: 0; }
  :where(.gkab) :where(ul, ol) { list-style: none; }
  :where(.gkab) img { display: block; max-width: 100%; }
  :where(.gkab) a { color: inherit; text-decoration: none; }
  .gkab :focus-visible { outline: 3px solid var(--gkab-sky); outline-offset: 3px; border-radius: 8px; }

  .gkab-wrap { width: 100%; max-width: 1120px; margin: 0 auto; padding: 0 24px; }

  /* Skala huruf: H1 30/48, H2 24/32, H3 18/22, body 16 */
  .gkab h1, .gkab h2, .gkab h3, .gkab-ticket-value { font-family: var(--gkab-font-head); font-weight: 700; }
  .gkab h1 { font-size: 30px; line-height: 1.15; letter-spacing: -0.01em; }
  .gkab h2 { font-size: 24px; line-height: 1.2; color: var(--gkab-blue); letter-spacing: -0.005em; }
  .gkab h3 { font-size: 18px; line-height: 1.3; }

  /* ---------- Foto (placeholder sampai src diisi) ---------- */
  .gkab-photo {
    position: relative;
    overflow: hidden;
    background: linear-gradient(45deg, var(--gkab-tint-2), var(--gkab-sky-60));
    border-radius: 24px;
  }
  .gkab-photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .gkab-photo img[src=""],
  .gkab-photo img:not([src]) { display: none; }
  .gkab-photo-label {
    position: absolute; inset: 0;
    display: flex; align-items: center; justify-content: center; text-align: center;
    padding: 24px; font-size: 16px; line-height: 1.5; color: var(--gkab-blue);
  }

  /* ---------- HERO (foto di atas, judul + paragraf di atas fade biru) ---------- */
  .gkab-hero {
    position: relative; overflow: hidden; color: var(--gkab-white);
    display: flex; flex-direction: column; padding-bottom: 72px;
    background: linear-gradient(45deg, var(--gkab-blue) 0%, var(--gkab-blue) 55%, #0a86c8 100%);
    border-radius: 0 0 32px 32px;
  }
  .gkab-hero-media { position: relative; order: 1; margin: 0; min-height: 220px; }
  .gkab-hero-img {
    display: block; width: 100%; height: auto; aspect-ratio: 5 / 4; object-fit: cover; object-position: 78% 40%;
    -webkit-mask-image: linear-gradient(to bottom, #000 52%, transparent 100%);
            mask-image: linear-gradient(to bottom, #000 52%, transparent 100%);
  }
  .gkab-hero-img[src=""], .gkab-hero-img:not([src]) { display: none; }
  .gkab-hero-title { position: relative; z-index: 2; order: 2; margin-top: -86px; }
  .gkab-hero h1 { max-width: 12ch; }
  .gkab-hero-copy p { margin-top: 16px; color: #eaf6fd; max-width: 56ch; }
  .gkab-hero-copy h1 + p,
  .gkab-hero-copy p:first-of-type { margin-top: 20px; }

  /* ---------- TIKET STATISTIK ---------- */
  .gkab-ticket-zone { position: relative; z-index: 2; margin-top: -40px; }
  .gkab-ticket {
    display: grid;
    background: var(--gkab-white);
    border-radius: 20px;
    box-shadow: 0 16px 40px rgba(0, 84, 150, 0.18);
    overflow: hidden;
  }
  .gkab-ticket-item { padding: 24px; display: flex; flex-direction: column; gap: 4px; }
  .gkab-ticket-item + .gkab-ticket-item { border-top: 2px dashed var(--gkab-line); }
  .gkab-ticket-label { font-size: 16px; color: var(--gkab-muted); order: -1; }
  .gkab-ticket-value { font-size: 36px; line-height: 1.1; color: var(--gkab-blue); font-variant-numeric: tabular-nums; }

  /* ---------- CERITA ---------- */
  .gkab-story { padding: 72px 0; }
  .gkab-story-grid { display: grid; gap: 40px; align-items: center; }
  .gkab-story-media { position: relative; width: 100%; max-width: 440px; margin: 0 auto; }
  .gkab-story-photo { position: relative; aspect-ratio: 4 / 5; width: 100%; background: transparent; }
  .gkab-story-photo img { object-position: 35% 85%; }
  .gkab-badge {
    position: absolute; z-index: 2; left: 16px; bottom: -16px; display: inline-flex; align-items: center; gap: 10px;
    padding: 12px 18px; border-radius: 999px; background: var(--gkab-white); color: var(--gkab-blue);
    font-family: var(--gkab-font-head); font-weight: 700; font-size: 16px; line-height: 1.3; box-shadow: 0 8px 24px rgba(0, 84, 150, 0.2);
  }
  .gkab-badge::before { content: ""; width: 10px; height: 10px; border-radius: 50%; background: var(--gkab-sky); flex: none; }
  .gkab-story-body { margin-top: 24px; display: grid; gap: 16px; max-width: 56ch; }
  .gkab-principle {
    margin-top: 32px; padding: 4px 0 4px 20px; border-left: 4px solid var(--gkab-sky);
    font-family: var(--gkab-font-head); font-weight: 700; font-size: 18px; line-height: 1.45; color: var(--gkab-blue); max-width: 40ch;
  }

  /* ---------- KOMITMEN ---------- */
  .gkab-commit {
    position: relative; overflow: hidden; isolation: isolate; color: var(--gkab-white);
    background: linear-gradient(45deg, var(--gkab-blue) 0%, var(--gkab-blue) 60%, #0a86c8 100%);
    padding: 72px 0;
  }
  .gkab-commit::before {
    content: ""; position: absolute; z-index: -1; width: 560px; height: 560px; right: -200px; top: -200px; border-radius: 50%;
    background: repeating-radial-gradient(circle at center, transparent 0 46px, rgba(255, 255, 255, 0.1) 46px 48px);
    -webkit-mask-image: radial-gradient(circle, #000 30%, transparent 72%);
            mask-image: radial-gradient(circle, #000 30%, transparent 72%);
  }
  .gkab-commit::after {
    content: ""; position: absolute; z-index: -1; width: 420px; height: 420px; left: -180px; bottom: -220px; border-radius: 50%;
    background: repeating-radial-gradient(circle at center, transparent 0 46px, rgba(255, 255, 255, 0.08) 46px 48px);
    -webkit-mask-image: radial-gradient(circle, #000 30%, transparent 72%);
            mask-image: radial-gradient(circle, #000 30%, transparent 72%);
  }
  .gkab-commit h2 { color: var(--gkab-white); }
  .gkab-commit-list { margin: 40px auto 0; display: grid; gap: 16px; max-width: 640px; }
  .gkab-commit-item {
    position: relative; overflow: hidden; background: var(--gkab-white); color: var(--gkab-ink);
    border-radius: 24px; padding: 32px 24px 36px; box-shadow: 0 16px 40px rgba(0, 40, 80, 0.22);
  }
  .gkab-commit-item::after { content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 6px; background: linear-gradient(45deg, var(--gkab-blue), var(--gkab-sky)); }
  .gkab-icon {
    width: 64px; height: 64px; margin: 0 auto; border-radius: 20px; display: flex; align-items: center; justify-content: center; color: var(--gkab-white);
    background: linear-gradient(45deg, var(--gkab-blue), var(--gkab-sky));
  }
  .gkab-icon svg { width: 32px; height: 32px; }
  .gkab-icon img { width: 32px; height: 32px; object-fit: contain; }
  .gkab-commit-item h3 { margin-top: 24px; text-align: center; color: var(--gkab-blue); }
  .gkab-commit-item p { margin-top: 12px; text-align: justify; text-justify: inter-word; text-align-last: left; hyphens: auto; }

  /* ---------- KEBIJAKAN ---------- */
  .gkab-policy { padding: 72px 0 88px; }
  .gkab-policy-panel { background: var(--gkab-tint); border-radius: 32px; padding: 32px 12px; }
  .gkab-policy-grid { display: grid; gap: 32px; }
  .gkab-policy-intro { margin-top: 16px; max-width: 44ch; }
  .gkab-policy-links { display: grid; gap: 12px; }
  .gkab-policy-link {
    display: grid; grid-template-columns: 48px 1fr; gap: 16px; align-items: center;
    min-height: 44px; padding: 16px; border-radius: 16px; background: var(--gkab-white);
    border: 1px solid var(--gkab-tint-2); transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .gkab-policy-link:hover { border-color: var(--gkab-sky); box-shadow: 0 8px 24px rgba(0, 84, 150, 0.12); }
  .gkab-policy-ico { width: 48px; height: 48px; border-radius: 14px; background: var(--gkab-tint-2); color: var(--gkab-blue); display: flex; align-items: center; justify-content: center; }
  .gkab-policy-ico svg { width: 24px; height: 24px; }
  .gkab-policy-ico img { width: 24px; height: 24px; object-fit: contain; }
  .gkab-policy-title { display: block; font-family: var(--gkab-font-head); font-weight: 700; font-size: 18px; line-height: 1.35; color: var(--gkab-blue); }
  .gkab-policy-desc { display: block; margin-top: 4px; font-size: 16px; line-height: 1.55; color: var(--gkab-muted); }
  .gkab-chev { display: none; width: 24px; height: 24px; color: var(--gkab-sky); transition: transform 0.2s ease; }
  .gkab-policy-link:hover .gkab-chev { transform: translateX(4px); }

  /* ---------- TABLET & DESKTOP ---------- */
  @media (min-width: 768px) {
    .gkab h1 { font-size: 48px; }
    .gkab h2 { font-size: 32px; }
    .gkab h3 { font-size: 22px; }
    .gkab-wrap { padding: 0 40px; }

    /* Tablet: tetap layout foto-dulu seperti mobile, foto dibuat lebih lebar */
    .gkab-hero-img { aspect-ratio: 16 / 10; object-position: 72% 40%; }
    .gkab-hero-title { margin-top: -110px; }
    .gkab-ticket { grid-template-columns: repeat(3, 1fr); }
    .gkab-ticket-item { padding: 32px clamp(20px, 3.5vw, 40px); }
    .gkab-ticket-item + .gkab-ticket-item { border-top: 0; border-left: 2px dashed var(--gkab-line); }
    .gkab-ticket-value { font-size: clamp(32px, 4vw, 48px); }

    .gkab-story { padding: 104px 0 96px; }
    .gkab-story-grid { grid-template-columns: 0.85fr 1.15fr; gap: clamp(32px, 6vw, 72px); }
    .gkab-story-media { margin: 0; }
    .gkab-principle { font-size: 22px; }

    .gkab-commit { padding: 104px 0; }
    .gkab-commit-list { margin-top: 56px; }
    .gkab-commit-item { padding: 36px 24px 40px; }

    .gkab-policy { padding: 104px 0 120px; }
    .gkab-policy-panel { padding: 56px; }
    .gkab-policy-title { font-size: 20px; }
    .gkab-policy-link { grid-template-columns: 48px 1fr 24px; }
    .gkab-chev { display: block; }
    .gkab-policy-grid { grid-template-columns: 0.8fr 1.2fr; gap: 56px; align-items: start; }
  }
  @media (min-width: 1024px) {
    .gkab-hero { display: block; padding-bottom: 0; border-radius: 0 0 48px 48px; }
    .gkab-hero-media { width: 100%; min-height: 0; aspect-ratio: auto; height: clamp(600px, 48.75vw, 720px); }
    /* Foto di kanan; sisi kirinya memudar ke biru supaya teks tidak menimpa wajah */
    .gkab-hero-img {
      position: absolute; top: 0; right: 0; width: auto; max-width: none; height: 100%; aspect-ratio: auto; object-position: 50% 40%;
      -webkit-mask-image: linear-gradient(to right, transparent 0, rgba(0, 0, 0, 0.2) 10%, rgba(0, 0, 0, 0.55) 22%, #000 40%);
              mask-image: linear-gradient(to right, transparent 0, rgba(0, 0, 0, 0.2) 10%, rgba(0, 0, 0, 0.55) 22%, #000 40%);
    }
    .gkab-hero-media::after {
      content: ""; position: absolute; inset: 0; pointer-events: none;
      background: linear-gradient(90deg, rgba(0, 84, 150, 0.9) 0%, rgba(0, 84, 150, 0.62) 34%, rgba(0, 84, 150, 0) 56%);
    }
    .gkab-hero-title { position: absolute; top: 56px; left: 0; right: 0; margin-top: 0; }
    .gkab-hero-copy { max-width: 470px; }
    .gkab-hero-copy p { margin-top: 20px; }
    .gkab-ticket-zone { margin-top: -64px; }
    .gkab-commit-list { max-width: none; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  }
{% endstyle %}

<div class="gkab" lang="id">
  <!-- HERO -->
  <section class="gkab-hero" aria-labelledby="gkab-h1">
    <figure class="gkab-hero-media">
      {%- if section.settings.hero_image != blank -%}
        {%- assign hero_alt = section.settings.hero_image.alt | default: section.settings.hero_title | escape -%}
        {{
          section.settings.hero_image
          | image_url: width: 1920
          | image_tag:
            class: 'gkab-hero-img',
            alt: hero_alt,
            loading: 'eager',
            widths: '540, 720, 1080, 1440, 1920'
        }}
      {%- else -%}
        <img
          class="gkab-hero-img"
          src="{{ section.settings.hero_image_url | default: 'https://cdn.shopify.com/s/files/1/0735/4204/1817/files/Hero_banner_about_us.jpg?v=1792663594' }}"
          alt="{{ section.settings.hero_title | escape }}"
          width="1920"
          height="1072"
          loading="eager"
        >
      {%- endif -%}
    </figure>
    <div class="gkab-hero-title">
      <div class="gkab-wrap">
        <div class="gkab-hero-copy">
          <h1 id="gkab-h1">{{ section.settings.hero_title | default: 'Menghubungkan Traveler Sejak 2016' }}</h1>
          {%- if section.settings.hero_text != blank -%}
            {{ section.settings.hero_text }}
          {%- else -%}
            <p>Global Komunika merupakan salah satu pelopor penyedia konektivitas perjalanan di Indonesia, yang menghadirkan solusi eSIM dan SIM Card internasional sejak 2016.</p>
            <p>Dengan jangkauan lebih dari 150 negara, kami membantu traveler tetap terhubung melalui koneksi andal, harga kompetitif dan solusi praktis untuk berbagai kebutuhan perjalanan.</p>
          {%- endif -%}
        </div>
      </div>
    </div>
  </section>

  <!-- STATISTIK -->
  {%- assign stat_blocks = section.blocks | where: 'type', 'stat' -%}
  <div class="gkab-ticket-zone">
    <div class="gkab-wrap">
      <dl class="gkab-ticket">
        {%- if stat_blocks.size > 0 -%}
          {%- for block in stat_blocks -%}
            <div class="gkab-ticket-item" {{ block.shopify_attributes }}>
              <dt class="gkab-ticket-label">{{ block.settings.label }}</dt>
              <dd class="gkab-ticket-value">
                {%- if block.settings.count_number > 0 -%}
                  <span data-gkab-count="{{ block.settings.count_number }}">{{ block.settings.value }}</span>{{ block.settings.suffix }}
                {%- else -%}
                  {{ block.settings.value }}{{ block.settings.suffix }}
                {%- endif -%}
              </dd>
            </div>
          {%- endfor -%}
        {%- else -%}
          <div class="gkab-ticket-item">
            <dt class="gkab-ticket-label">Tahun Berdiri</dt>
            <dd class="gkab-ticket-value">2016</dd>
          </div>
          <div class="gkab-ticket-item">
            <dt class="gkab-ticket-label">Jangkauan Negara</dt>
            <dd class="gkab-ticket-value"><span data-gkab-count="150">150</span>+</dd>
          </div>
          <div class="gkab-ticket-item">
            <dt class="gkab-ticket-label">Produk Terjual</dt>
            <dd class="gkab-ticket-value"><span data-gkab-count="500000">500.000</span>+</dd>
          </div>
        {%- endif -%}
      </dl>
    </div>
  </div>

  <!-- CERITA -->
  <section class="gkab-story" aria-labelledby="gkab-h-story">
    <div class="gkab-wrap">
      <div class="gkab-story-grid">
        <div class="gkab-story-media">
          <figure class="gkab-photo gkab-story-photo">
            <span class="gkab-photo-label">FOTO FOUNDER (4:5, potret)</span>
            {%- if section.settings.founder_image != blank -%}
              {%- assign founder_alt = section.settings.founder_image.alt | default: 'Founder Global Komunika' | escape -%}
              {{
                section.settings.founder_image
                | image_url: width: 1000
                | image_tag:
                  alt: founder_alt,
                  loading: 'lazy',
                  widths: '400, 600, 800, 1000'
              }}
            {%- else -%}
              <img
                src="{{ section.settings.founder_image_url | default: 'https://cdn.shopify.com/s/files/1/0735/4204/1817/files/pak_andy_bu_jess.jpg?v=1792663519' }}"
                alt="Founder Global Komunika"
                width="512"
                height="640"
                loading="lazy"
              >
            {%- endif -%}
          </figure>
          {%- if section.settings.founder_badge != blank -%}
            <p class="gkab-badge">{{ section.settings.founder_badge }}</p>
          {%- endif -%}
        </div>
        <div>
          <h2 id="gkab-h-story">{{ section.settings.story_title | default: 'Dari Traveler, untuk Traveler' }}</h2>
          <div class="gkab-story-body">
            {%- if section.settings.story_body != blank -%}
              {{ section.settings.story_body }}
            {%- else -%}
              <p>Global Komunika didirikan pada 2016, berawal dari kecintaan founder kami terhadap perjalanan mandiri sejak 2007.</p>
              <p>Berangkat dari keinginan untuk membuat konektivitas internasional lebih mudah dan terjangkau, Global Komunika terus berkembang menjadi penyedia layanan konektivitas perjalanan yang dipercaya oleh para traveler.</p>
            {%- endif -%}
          </div>
          {%- if section.settings.story_principle != blank -%}
            <blockquote class="gkab-principle">{{ section.settings.story_principle }}</blockquote>
          {%- endif -%}
        </div>
      </div>
    </div>
  </section>

  <!-- KOMITMEN -->
  {%- assign commit_blocks = section.blocks | where: 'type', 'commitment' -%}
  <section class="gkab-commit" aria-labelledby="gkab-h-commit">
    <div class="gkab-wrap">
      <h2 id="gkab-h-commit">{{ section.settings.commit_heading | default: 'Komitmen Kami' }}</h2>
      <ul class="gkab-commit-list">
        {%- if commit_blocks.size > 0 -%}
          {%- for block in commit_blocks -%}
            <li class="gkab-commit-item" {{ block.shopify_attributes }}>
              <span class="gkab-icon" aria-hidden="true">
                {%- case block.settings.icon -%}
                  {%- when 'signal' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="2.5" width="12" height="19" rx="2.5"/><path d="M11 18.5h2"/><path d="M9.2 10.6a4 4 0 0 1 5.6 0"/><path d="M7.4 8.4a6.6 6.6 0 0 1 9.2 0"/><path d="M12 13h.01"/></svg>
                  {%- when 'price' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9.5"/><text x="12" y="15.6" text-anchor="middle" font-size="9.5" font-weight="700" fill="currentColor" stroke="none" style="font-family:inherit">Rp</text></svg>
                  {%- when 'support' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H8l-5 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/><path d="M8.5 10.2l2.4 2.4 4.6-4.6"/></svg>
                  {%- when 'custom_image' -%}
                    {%- if block.settings.custom_icon != blank -%}
                      {{ block.settings.custom_icon | image_url: width: 64 | image_tag: loading: 'lazy', alt: block.settings.title }}
                    {%- else -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="2.5" width="12" height="19" rx="2.5"/><path d="M11 18.5h2"/><path d="M9.2 10.6a4 4 0 0 1 5.6 0"/><path d="M7.4 8.4a6.6 6.6 0 0 1 9.2 0"/><path d="M12 13h.01"/></svg>
                    {%- endif -%}
                  {%- else -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="2.5" width="12" height="19" rx="2.5"/><path d="M11 18.5h2"/><path d="M9.2 10.6a4 4 0 0 1 5.6 0"/><path d="M7.4 8.4a6.6 6.6 0 0 1 9.2 0"/><path d="M12 13h.01"/></svg>
                {%- endcase -%}
              </span>
              <h3>{{ block.settings.title }}</h3>
              <p>{{ block.settings.text }}</p>
            </li>
          {%- endfor -%}
        {%- else -%}
          <li class="gkab-commit-item">
            <span class="gkab-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="2.5" width="12" height="19" rx="2.5"/><path d="M11 18.5h2"/><path d="M9.2 10.6a4 4 0 0 1 5.6 0"/><path d="M7.4 8.4a6.6 6.6 0 0 1 9.2 0"/><path d="M12 13h.01"/></svg>
            </span>
            <h3>Koneksi Andal</h3>
            <p>Membantu traveler tetap terhubung di berbagai destinasi melalui solusi konektivitas internasional yang dapat diandalkan.</p>
          </li>
          <li class="gkab-commit-item">
            <span class="gkab-icon" aria-hidden="true">
