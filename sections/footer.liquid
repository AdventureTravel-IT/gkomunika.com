{{ 'section-footer.css' | asset_url | stylesheet_tag }}

<div class="footer">
  <div class="footer-container__wrapper">
    <section class="footer__address">
      {% if section.settings.logo != blank %}
        {{
          section.settings.logo
          | image_url: width: 200
          | image_tag:
            class: 'footer__logo',
            loading: 'lazy',
            alt: 'Status Global Komunika',
            widths: '208, 364, 416, 728',
            sizes: '(max-width: 768px) 208px, 364px'
        }}

        <div class="footer__address-text">
          <h2 class="footer__heading-title address">{{ section.settings.heading }}</h2>
          {% if section.settings.short_link != blank %}
            <a href="{{ section.settings.short_link }}" target="_blank" rel="noopener noreferrer">
              <div class="footer__heading-desc">{{ section.settings.address }}</div>
            </a>
          {% else %}
            <div class="footer__heading-desc">{{ section.settings.address }}</div>
          {% endif %}
        </div>
      {% endif %}
    </section>

    <section class="footer__product">
      <h2 class="footer__heading-title">{{ section.settings.popular_country_heading }}</h2>
      <ul class="footer__wrapper">
        {% for block in section.blocks %}
          {% if block.type == 'country' %}
            {% if block.settings.country_name1 != blank %}
              <li>
                <a href="{{ routes.search_url }}?q={{ block.settings.country_name1 | escape }}">
                  {{ block.settings.country_name1 }}
                </a>
              </li>
            {% endif %}
            {% if block.settings.country_name2 != blank %}
              <li>
                <a href="{{ routes.search_url }}?q={{ block.settings.country_name2 | escape }}">
                  {{ block.settings.country_name2 }}
                </a>
              </li>
            {% endif %}
            {% if block.settings.country_name3 != blank %}
              <li>
                <a href="{{ routes.search_url }}?q={{ block.settings.country_name3 | escape }}">
                  {{ block.settings.country_name3 }}
                </a>
              </li>
            {% endif %}
            {% if block.settings.country_name4 != blank %}
              <li>
                <a href="{{ routes.search_url }}?q={{ block.settings.country_name4 | escape }}">
                  {{ block.settings.country_name4 }}
                </a>
              </li>
            {% endif %}
            {% if block.settings.country_name5 != blank %}
              <li>
                <a href="{{ routes.search_url }}?q={{ block.settings.country_name5 | escape }}">
                  {{ block.settings.country_name5 }}
                </a>
              </li>
            {% endif %}
            {% if block.settings.country_name6 != blank %}
              <li>
                <a href="{{ routes.search_url }}?q={{ block.settings.country_name6 | escape }}">
                  {{ block.settings.country_name6 }}
                </a>
              </li>
            {% endif %}
            {% if block.settings.country_name7 != blank %}
              <li>
                <a href="{{ routes.search_url }}?q={{ block.settings.country_name7 | escape }}">
                  {{ block.settings.country_name7 }}
                </a>
              </li>
            {% endif %}
            {% if block.settings.country_name8 != blank %}
              <li>
                <a href="{{ routes.search_url }}?q={{ block.settings.country_name8 | escape }}">
                  {{ block.settings.country_name8 }}
                </a>
              </li>
            {% endif %}
            {% if block.settings.country_name9 != blank %}
              <li>
                <a href="{{ routes.search_url }}?q={{ block.settings.country_name9 | escape }}">
                  {{ block.settings.country_name9 }}
                </a>
              </li>
            {% endif %}
            {% if block.settings.country_name10 != blank %}
              <li>
                <a href="{{ routes.search_url }}?q={{ block.settings.country_name10 | escape }}">
                  {{ block.settings.country_name10 }}
                </a>
              </li>
            {% endif %}
          {% endif %}
        {% endfor %}
      </ul>
    </section>

    <section class="footer__about">
      <h2 class="footer__heading-title">{{ section.settings.about_heading | default: 'Company' }}</h2>
      <ul class="footer__wrapper">
        {% assign has_company_links = false %}
        {% for block in section.blocks %}
          {% if block.type == 'link' %}
            {% assign has_company_links = true %}
            {% if block.settings.link_label1 != blank %}
              <li>
                <a href="{{ block.settings.link_url1 | default: '/pages/about-us' }}">{{ block.settings.link_label1 }}</a>
              </li>
            {% endif %}
            {% if block.settings.link_label2 != blank %}
              <li>
                <a href="{{ block.settings.link_url2 | default: '/pages/business' }}">{{ block.settings.link_label2 }}</a>
              </li>
            {% endif %}
            {% if block.settings.link_label3 != blank %}
              <li>
                <a href="{{ block.settings.link_url3 | default: '/pages/faq' }}">{{ block.settings.link_label3 }}</a>
              </li>
            {% endif %}
            {% if block.settings.link_label4 != blank %}
              <li>
                <a href="{{ block.settings.link_url4 | default: '/pages/news' }}">{{ block.settings.link_label4 }}</a>
              </li>
            {% endif %}
            {% if block.settings.link_label5 != blank %}
              <li>
                <a href="{{ block.settings.link_url5 | default: '#' }}">{{ block.settings.link_label5 }}</a>
              </li>
            {% endif %}
            {% if block.settings.link_label6 != blank %}
              <li>
                <a href="{{ block.settings.link_url6 | default: '#' }}">{{ block.settings.link_label6 }}</a>
              </li>
            {% endif %}
          {% elsif block.type == 'company_link' %}
            {% assign has_company_links = true %}
            <li>
              <a href="{{ block.settings.url | default: '#' }}">{{ block.settings.label }}</a>
            </li>
          {% elsif block.type == 'menu' %}
            {% assign has_company_links = true %}
            {% for link in block.settings.menu.links %}
              <li>
                <a href="{{ link.url }}">{{ link.title }}</a>
              </li>
            {% endfor %}
          {% endif %}
        {% endfor %}

        {% unless has_company_links %}
          <li><a href="/pages/about-us">About Us</a></li>
          <li><a href="/pages/business">Business</a></li>
          <li><a href="/pages/faq">FAQ</a></li>
          <li><a href="/pages/news">News</a></li>
        {% endunless %}
      </ul>
    </section>
  </div>
</div>

