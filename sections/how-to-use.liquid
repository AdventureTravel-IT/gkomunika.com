{% assign htu_blocks = section.blocks | where: 'type', 'htu_card' %}
{% assign wgk_blocks = section.blocks | where: 'type', 'wgk_card' %}
{% assign benefits_blocks = section.blocks | where: 'type', 'benefits_card' %}
{% assign review_blocks = section.blocks | where: 'type', 'review' %}
{% assign review_top_blocks = section.blocks | where: 'type', 'review_top' %}
{% assign review_bottom_blocks = section.blocks | where: 'type', 'review_bottom' %}

<!-- HOW TO USE -->
<section class="gkh-sec">
  <div class="gkh-wrap">
    <h2 class="gkh-title">{{ section.settings.htu_title | default: 'How to use' }}</h2>
    <div class="gkh-cards">
      {% if htu_blocks.size > 0 %}
        {% for block in htu_blocks %}
          <div class="gkh-card" {{ block.shopify_attributes }}>
            <div class="gkh-card__ic">
              {% if block.settings.icon != blank %}
                {% assign icon_name = block.settings.icon | append: '.svg' %}
                {{ icon_name | inline_asset_content }}
              {% else %}
                {% case forloop.index %}
                  {% when 1 %}{{ 'htu-phone.svg' | inline_asset_content }}
                  {% when 2 %}{{ 'htu-mail.svg' | inline_asset_content }}
                  {% when 3 %}{{ 'htu-activate.svg' | inline_asset_content }}
                  {% else %}{{ 'htu-phone.svg' | inline_asset_content }}
                {% endcase %}
              {% endif %}
            </div>
            <h3 class="gkh-card__t">{{ block.settings.title }}</h3>
            <p class="gkh-card__p">{{ block.settings.paragraph }}</p>
          </div>
        {% endfor %}
      {% else %}
        <div class="gkh-card">
          <div class="gkh-card__ic">{{ 'htu-phone.svg' | inline_asset_content }}</div>
          <h3 class="gkh-card__t">Choose</h3>
          <p class="gkh-card__p">Select your destination and find the best data plan for your trip.</p>
        </div>
        <div class="gkh-card">
          <div class="gkh-card__ic">{{ 'htu-mail.svg' | inline_asset_content }}</div>
          <h3 class="gkh-card__t">Scan</h3>
          <p class="gkh-card__p">Receive your QR code via email after purchase. Scan it to install your eSIM in just a few steps.</p>
        </div>
        <div class="gkh-card">
          <div class="gkh-card__ic">{{ 'htu-activate.svg' | inline_asset_content }}</div>
          <h3 class="gkh-card__t">Connect</h3>
          <p class="gkh-card__p">Activate your eSIM at your destination and enjoy seamless connectivity throughout your trip.</p>
        </div>
      {% endif %}
    </div>
  </div>
</section>

<!-- WHY GLOBAL KOMUNIKA? -->
<section class="gkh-sec">
  <div class="gkh-wrap">
    <h2 class="gkh-title">{{ section.settings.wgk_title | default: 'Why Global Komunika?' }}</h2>
    <div class="gkh-cards">
      {% if wgk_blocks.size > 0 %}
        {% for block in wgk_blocks %}
          <div class="gkh-card" {{ block.shopify_attributes }}>
            <div class="gkh-card__ic">
              {% if block.settings.icon != blank %}
                {% assign icon_name = block.settings.icon | append: '.svg' %}
                {{ icon_name | inline_asset_content }}
              {% else %}
                {% case forloop.index %}
                  {% when 1 %}{{ 'htu-verified.svg' | inline_asset_content }}
                  {% when 2 %}{{ 'htu-user.svg' | inline_asset_content }}
                  {% when 3 %}{{ 'htu-secure.svg' | inline_asset_content }}
                  {% else %}{{ 'htu-verified.svg' | inline_asset_content }}
                {% endcase %}
              {% endif %}
            </div>
            <h3 class="gkh-card__t">{{ block.settings.title }}</h3>
            <p class="gkh-card__p">{{ block.settings.paragraph }}</p>
          </div>
        {% endfor %}
      {% else %}
        <div class="gkh-card">
          <div class="gkh-card__ic">{{ 'htu-verified.svg' | inline_asset_content }}</div>
          <h3 class="gkh-card__t">Pioneering eSIM Since 2016</h3>
          <p class="gkh-card__p">Reliable connectivity across 150+ countries, backed by nearly a decade of experience.</p>
        </div>
        <div class="gkh-card">
          <div class="gkh-card__ic">{{ 'htu-user.svg' | inline_asset_content }}</div>
          <h3 class="gkh-card__t">Over 500,000 eSIMs Sold</h3>
          <p class="gkh-card__p">Trusted by travelers to stay connected wherever their journeys take them.</p>
        </div>
        <div class="gkh-card">
          <div class="gkh-card__ic">{{ 'htu-secure.svg' | inline_asset_content }}</div>
          <h3 class="gkh-card__t">100% Activation Guarantee &amp; Great Value</h3>
          <p class="gkh-card__p">Seamless activation, reliable connectivity and competitive pricing for worry-free travel.</p>
        </div>
      {% endif %}
    </div>
  </div>
</section>

<!-- WHAT OUR CUSTOMERS SAY (SLIDER) -->
<section class="gkh-sec">
  <div class="gkh-wrap">
    <h2 class="gkh-title">{{ section.settings.review_title | default: 'What Our Customers Say' }}</h2>
    <div class="gkh-rslider" aria-roledescription="carousel" aria-label="Customer reviews" data-gkh-rslider>
      <button class="gkh-rnav gkh-rnav--prev" type="button" aria-label="Previous reviews">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg>
      </button>

      <div class="gkh-rtrack" tabindex="0">
        {% assign has_custom_reviews = false %}
        {% if review_blocks.size > 0 or review_top_blocks.size > 0 or review_bottom_blocks.size > 0 %}
          {% assign has_custom_reviews = true %}
        {% endif %}

        {% if has_custom_reviews %}
          {% for block in review_blocks %}
            <article class="gkh-rcard" {{ block.shopify_attributes }}>
              <div class="gkh-rcard__top">
                <h3 class="gkh-rcard__name">{{ block.settings.author }}</h3>
                <div class="gkh-stars" aria-label="5 out of 5 stars">
                  {% for i in (1..5) %}
                    <svg class="gkh-star" viewBox="0 0 24 24" width="20" height="20" fill="#FFD45F" aria-hidden="true"><path d="M21.57 9.14a2.37 2.37 0 0 0-1.93-1.63L15.9 7l-1.68-3.4a2.38 2.38 0 0 0-4.27 0L8.27 7l-3.75.54a2.39 2.39 0 0 0-1.32 4.04l2.71 2.64L5.27 18a2.38 2.38 0 0 0 2.35 2.79 2.42 2.42 0 0 0 1.11-.27l3.35-1.76 3.35 1.76a2.41 2.41 0 0 0 2.57-.23 2.369 2.369 0 0 0 .89-2.29l-.64-3.73L21 11.58a2.38 2.38 0 0 0 .57-2.44Z"></path></svg>
                  {% endfor %}
                </div>
              </div>
              <p class="gkh-rcard__text">{{ block.settings.comment }}</p>
            </article>
          {% endfor %}

          {% for block in review_top_blocks %}
