{%- assign current_lang = localization.language.iso_code | default: request.locale.iso_code | downcase -%}
{%- assign is_en = true -%}
{%- if current_lang contains 'id' or request.locale.root_url contains '/id' or routes.root_url contains '/id' or request.path contains '/id' -%}
  {%- assign is_en = false -%}
{%- endif -%}

{% assign htu_blocks = section.blocks | where: 'type', 'htu_card' %}
{% assign wgk_blocks = section.blocks | where: 'type', 'wgk_card' %}
{% assign benefits_blocks = section.blocks | where: 'type', 'benefits_card' %}
{% assign review_blocks = section.blocks | where: 'type', 'review' %}
{% assign review_top_blocks = section.blocks | where: 'type', 'review_top' %}
{% assign review_bottom_blocks = section.blocks | where: 'type', 'review_bottom' %}

<!-- HOW TO USE -->
<section class="gkh-sec">
  <div class="gkh-wrap">
    <h2 class="gkh-title">
      {%- if is_en -%}
        {{ section.settings.htu_title | default: 'How to use' }}
      {%- else -%}
        {{ 'homepage.htu_title' | t: default: 'Cara Menggunakan eSIM' }}
      {%- endif -%}
    </h2>
    <div class="gkh-cards">
      {% if htu_blocks.size > 0 %}
        {% for block in htu_blocks %}
          {%- assign card_title = block.settings.title -%}
          {%- assign card_desc = block.settings.paragraph -%}
          {%- unless is_en -%}
            {%- case forloop.index -%}
              {%- when 1 -%}
                {%- assign card_title = 'homepage.htu_choose_title' | t: default: 'Pilih' -%}
                {%- assign card_desc = 'homepage.htu_choose_desc' | t: default: 'Pilih negara tujuan dan temukan paket data yang sesuai dengan kebutuhan perjalananmu.' -%}
              {%- when 2 -%}
                {%- assign card_title = 'homepage.htu_scan_title' | t: default: 'Pindai' -%}
                {%- assign card_desc = 'homepage.htu_scan_desc' | t: default: 'Terima QR code melalui email setelah pembelian. Scan untuk memasang eSIM di HP-mu dengan mudah.' -%}
              {%- when 3 -%}
                {%- assign card_title = 'homepage.htu_connect_title' | t: default: 'Terhubung' -%}
                {%- assign card_desc = 'homepage.htu_connect_desc' | t: default: 'Aktifkan eSIM saat tiba di negara tujuan dan nikmati koneksi internet sepanjang perjalanan.' -%}
            {%- endcase -%}
          {%- endunless -%}
          <div class="gkh-card" {{ block.shopify_attributes }}>
            <div class="gkh-card__ic">
              {% if block.settings.icon != blank %}
                {% assign icon_name = block.settings.icon | append: '.svg' %}
                {{ icon_name | inline_asset_content }}
              {% else %}
                {% case forloop.index %}
                  {% when 1 %}{{ 'htu-phone.svg' | inline_asset_content }}
                  {% when 2 %}{{ 'htu-mail.svg' | inline_asset_content }}
                  {% when 3 %}{{ 'htu-activate.svg' | inline_asset_content }}
                  {% else %}{{ 'htu-phone.svg' | inline_asset_content }}
                {% endcase %}
              {% endif %}
            </div>
            <h3 class="gkh-card__t">{{ card_title }}</h3>
            <p class="gkh-card__p">{{ card_desc }}</p>
          </div>
        {% endfor %}
      {% else %}
        <div class="gkh-card">
          <div class="gkh-card__ic">{{ 'htu-phone.svg' | inline_asset_content }}</div>
          <h3 class="gkh-card__t">{% if is_en %}Choose{% else %}{{ 'homepage.htu_choose_title' | t: default: 'Pilih' }}{% endif %}</h3>
          <p class="gkh-card__p">{% if is_en %}Select your destination and find the best data plan for your trip.{% else %}{{ 'homepage.htu_choose_desc' | t: default: 'Pilih negara tujuan dan temukan paket data yang sesuai dengan kebutuhan perjalananmu.' }}{% endif %}</p>
        </div>
        <div class="gkh-card">
          <div class="gkh-card__ic">{{ 'htu-mail.svg' | inline_asset_content }}</div>
          <h3 class="gkh-card__t">{% if is_en %}Scan{% else %}{{ 'homepage.htu_scan_title' | t: default: 'Pindai' }}{% endif %}</h3>
          <p class="gkh-card__p">{% if is_en %}Receive your QR code via email after purchase. Scan it to install your eSIM in just a few steps.{% else %}{{ 'homepage.htu_scan_desc' | t: default: 'Terima QR code melalui email setelah pembelian. Scan untuk memasang eSIM di HP-mu dengan mudah.' }}{% endif %}</p>
        </div>
        <div class="gkh-card">
          <div class="gkh-card__ic">{{ 'htu-activate.svg' | inline_asset_content }}</div>
          <h3 class="gkh-card__t">{% if is_en %}Connect{% else %}{{ 'homepage.htu_connect_title' | t: default: 'Terhubung' }}{% endif %}</h3>
          <p class="gkh-card__p">{% if is_en %}Activate your eSIM at your destination and enjoy seamless connectivity throughout your trip.{% else %}{{ 'homepage.htu_connect_desc' | t: default: 'Aktifkan eSIM saat tiba di negara tujuan dan nikmati koneksi internet sepanjang perjalanan.' }}{% endif %}</p>
        </div>
      {% endif %}
    </div>
  </div>
</section>

<!-- WHY GLOBAL KOMUNIKA? -->
<section class="gkh-sec">
  <div class="gkh-wrap">
    <h2 class="gkh-title">
      {%- if is_en -%}
        {{ section.settings.wgk_title | default: 'Why Global Komunika?' }}
      {%- else -%}
        {{ 'homepage.wgk_title' | t: default: 'Mengapa Global Komunika?' }}
      {%- endif -%}
    </h2>
    <div class="gkh-cards">
      {% if wgk_blocks.size > 0 %}
        {% for block in wgk_blocks %}
          {%- assign wgk_title = block.settings.title -%}
          {%- assign wgk_desc = block.settings.paragraph -%}
          {%- unless is_en -%}
            {%- case forloop.index -%}
              {%- when 1 -%}
                {%- assign wgk_title = 'homepage.wgk_pioneer_title' | t: default: 'Pelopor eSIM Sejak 2016' -%}
                {%- assign wgk_desc = 'homepage.wgk_pioneer_desc' | t: default: 'Koneksi andal di 150+ negara, didukung pengalaman satu dekade lebih' -%}
              {%- when 2 -%}
                {%- assign wgk_title = 'homepage.wgk_sales_title' | t: default: 'Lebih dari 500.000 eSIM Terjual' -%}
                {%- assign wgk_desc = 'homepage.wgk_sales_desc' | t: default: 'Dipercaya oleh para traveler untuk tetap terhubung ke mana pun perjalanan membawa mereka.' -%}
              {%- when 3 -%}
                {%- assign wgk_title = 'homepage.wgk_guarantee_title' | t: default: 'Garansi Aktivasi 100% & Harga Kompetitif' -%}
                {%- assign wgk_desc = 'homepage.wgk_guarantee_desc' | t: default: 'Aktivasi mudah, koneksi andal, dan harga bersaing untuk perjalanan tanpa khawatir.' -%}
            {%- endcase -%}
          {%- endunless -%}
          <div class="gkh-card" {{ block.shopify_attributes }}>
            <div class="gkh-card__ic">
              {% if block.settings.icon != blank %}
                {% assign icon_name = block.settings.icon | append: '.svg' %}
                {{ icon_name | inline_asset_content }}
              {% else %}
                {% case forloop.index %}
                  {% when 1 %}{{ 'htu-verified.svg' | inline_asset_content }}
                  {% when 2 %}{{ 'htu-user.svg' | inline_asset_content }}
                  {% when 3 %}{{ 'htu-secure.svg' | inline_asset_content }}
                  {% else %}{{ 'htu-verified.svg' | inline_asset_content }}
                {% endcase %}
              {% endif %}
            </div>
            <h3 class="gkh-card__t">{{ wgk_title }}</h3>
            <p class="gkh-card__p">{{ wgk_desc }}</p>
          </div>
        {% endfor %}
      {% else %}
        <div class="gkh-card">
          <div class="gkh-card__ic">{{ 'htu-verified.svg' | inline_asset_content }}</div>
          <h3 class="gkh-card__t">{% if is_en %}Pioneering eSIM Since 2016{% else %}{{ 'homepage.wgk_pioneer_title' | t: default: 'Pelopor eSIM Sejak 2016' }}{% endif %}</h3>
          <p class="gkh-card__p">{% if is_en %}Reliable connectivity across 150+ countries, backed by nearly a decade of experience.{% else %}{{ 'homepage.wgk_pioneer_desc' | t: default: 'Koneksi andal di 150+ negara, didukung pengalaman satu dekade lebih' }}{% endif %}</p>
        </div>
        <div class="gkh-card">
          <div class="gkh-card__ic">{{ 'htu-user.svg' | inline_asset_content }}</div>
          <h3 class="gkh-card__t">{% if is_en %}Over 500,000 eSIMs Sold{% else %}{{ 'homepage.wgk_sales_title' | t: default: 'Lebih dari 500.000 eSIM Terjual' }}{% endif %}</h3>
          <p class="gkh-card__p">{% if is_en %}Trusted by travelers to stay connected wherever their journeys take them.{% else %}{{ 'homepage.wgk_sales_desc' | t: default: 'Dipercaya oleh para traveler untuk tetap terhubung ke mana pun perjalanan membawa mereka.' }}{% endif %}</p>
        </div>
        <div class="gkh-card">
          <div class="gkh-card__ic">{{ 'htu-secure.svg' | inline_asset_content }}</div>
          <h3 class="gkh-card__t">{% if is_en %}100% Activation Guarantee &amp; Great Value{% else %}{{ 'homepage.wgk_guarantee_title' | t: default: 'Garansi Aktivasi 100% & Harga Kompetitif' }}{% endif %}</h3>
          <p class="gkh-card__p">{% if is_en %}Seamless activation, reliable connectivity and competitive pricing for worry-free travel.{% else %}{{ 'homepage.wgk_guarantee_desc' | t: default: 'Aktivasi mudah, koneksi andal, dan harga bersaing untuk perjalanan tanpa khawatir.' }}{% endif %}</p>
        </div>
      {% endif %}
    </div>
  </div>
</section>

<!-- WHAT OUR CUSTOMERS SAY (SLIDER) -->
<section class="gkh-sec">
  <div class="gkh-wrap">
    <h2 class="gkh-title">
      {%- if is_en -%}
        {{ section.settings.review_title | default: 'What Our Customers Say' }}
      {%- else -%}
        {{ 'homepage.review_title' | t: default: 'Cerita dari Pelanggan Kami' }}
      {%- endif -%}
    </h2>
    <div class="gkh-rslider" aria-roledescription="carousel" aria-label="Customer reviews" data-gkh-rslider>
      <button class="gkh-rnav gkh-rnav--prev" type="button" aria-label="Previous reviews">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg>
      </button>

      <div class="gkh-rtrack" tabindex="0">
        {% assign has_custom_reviews = false %}
        {% if review_blocks.size > 0 or review_top_blocks.size > 0 or review_bottom_blocks.size > 0 %}
          {% assign has_custom_reviews = true %}
        {% endif %}

        {% if has_custom_reviews %}
          {% for block in review_blocks %}
            <article class="gkh-rcard" {{ block.shopify_attributes }}>
              <div class="gkh-rcard__top">
                <h3 class="gkh-rcard__name">{{ block.settings.author }}</h3>
                <div class="gkh-stars" aria-label="5 out of 5 stars">
                  {% for i in (1..5) %}
                    <svg class="gkh-star" viewBox="0 0 24 24" width="20" height="20" fill="#FFD45F" aria-hidden="true"><path d="M21.57 9.14a2.37 2.37 0 0 0-1.93-1.63L15.9 7l-1.68-3.4a2.38 2.38 0 0 0-4.27 0L8.27 7l-3.75.54a2.39 2.39 0 0 0-1.32 4.04l2.71 2.64L5.27 18a2.38 2.38 0 0 0 2.35 2.79 2.42 2.42 0 0 0 1.11-.27l3.35-1.76 3.35 1.76a2.41 2.41 0 0 0 2.57-.23 2.369 2.369 0 0 0 .89-2.29l-.64-3.73L21 11.58a2.38 2.38 0 0 0 .57-2.44Z"></path></svg>
                  {% endfor %}
                </div>
              </div>
              <p class="gkh-rcard__text">{{ block.settings.comment }}</p>
            </article>
          {% endfor %}

          {% for block in review_top_blocks %}
            {% if block.settings['profile-top'] != blank %}
              {%- assign r_comment = block.settings['comment-top'] -%}
              {%- unless is_en -%}
                {%- assign a_name = block.settings['profile-top'] | downcase | strip -%}
                {%- case a_name -%}
                  {%- when 'yoelia' -%}{%- assign r_comment = 'homepage.review_yoelia' | t: default: r_comment -%}
                  {%- when 'albert' -%}{%- assign r_comment = 'homepage.review_albert' | t: default: r_comment -%}
                  {%- when 'rama' -%}{%- assign r_comment = 'homepage.review_rama' | t: default: r_comment -%}
                  {%- when 'eva' -%}{%- assign r_comment = 'homepage.review_eva' | t: default: r_comment -%}
                  {%- when 'lia' -%}{%- assign r_comment = 'homepage.review_lia' | t: default: r_comment -%}
                  {%- when 'tiani' -%}{%- assign r_comment = 'homepage.review_tiani' | t: default: r_comment -%}
                  {%- when 'vino' -%}{%- assign r_comment = 'homepage.review_vino' | t: default: r_comment -%}
                  {%- when 'audria' -%}{%- assign r_comment = 'homepage.review_audria' | t: default: r_comment -%}
                {%- endcase -%}
              {%- endunless -%}
              <article class="gkh-rcard" {{ block.shopify_attributes }}>
                <div class="gkh-rcard__top">
                  <h3 class="gkh-rcard__name">{{ block.settings['profile-top'] }}</h3>
                  <div class="gkh-stars" aria-label="5 out of 5 stars">
                    {% for i in (1..5) %}
                      <svg class="gkh-star" viewBox="0 0 24 24" width="20" height="20" fill="#FFD45F" aria-hidden="true"><path d="M21.57 9.14a2.37 2.37 0 0 0-1.93-1.63L15.9 7l-1.68-3.4a2.38 2.38 0 0 0-4.27 0L8.27 7l-3.75.54a2.39 2.39 0 0 0-1.32 4.04l2.71 2.64L5.27 18a2.38 2.38 0 0 0 2.35 2.79 2.42 2.42 0 0 0 1.11-.27l3.35-1.76 3.35 1.76a2.41 2.41 0 0 0 2.57-.23 2.369 2.369 0 0 0 .89-2.29l-.64-3.73L21 11.58a2.38 2.38 0 0 0 .57-2.44Z"></path></svg>
                    {% endfor %}
                  </div>
                </div>
                <p class="gkh-rcard__text">{{ r_comment }}</p>
              </article>
            {% endif %}
            {% if block.settings['profile-top1'] != blank %}
              {%- assign r_comment1 = block.settings['comment-top1'] -%}
              {%- unless is_en -%}
                {%- assign a_name1 = block.settings['profile-top1'] | downcase | strip -%}
                {%- case a_name1 -%}
                  {%- when 'yoelia' -%}{%- assign r_comment1 = 'homepage.review_yoelia' | t: default: r_comment1 -%}
