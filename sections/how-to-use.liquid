<!-- BENEFITS OF USING ESIM -->
<section class="gkh-sec">
  <div class="gkh-wrap">
    <h2 class="gkh-title">
      {%- if is_en -%}
        {{ section.settings.benefits_title | default: 'Benefits of Using eSIM' }}
      {%- else -%}
        {{ 'homepage.benefits_title' | t: default: 'Keuntungan Menggunakan eSIM' }}
      {%- endif -%}
    </h2>
    <div class="gkh-cards">
      {% if benefits_blocks.size > 0 %}
        {% for block in benefits_blocks %}
          {%- assign b_title = block.settings.title -%}
          {%- assign b_desc = block.settings.paragraph -%}
          {%- unless is_en -%}
            {%- case forloop.index -%}
              {%- when 1 -%}
                {%- assign b_title = 'homepage.benefit_number_title' | t: default: 'Nomor Utama Tetap Aktif' -%}
                {%- assign b_desc = 'homepage.benefit_number_desc' | t: default: 'Tetap terima telepon, SMS dan OTP di nomor utamamu sambil menggunakan eSIM di luar negeri.' -%}
              {%- when 2 -%}
                {%- assign b_title = 'homepage.benefit_setup_title' | t: default: 'Aktivasi Cepat & Mudah' -%}
                {%- assign b_desc = 'homepage.benefit_setup_desc' | t: default: 'Tanpa perlu ganti kartu SIM atau datang ke toko. Cukup scan QR code untuk memasang eSIM.' -%}
              {%- when 3 -%}
                {%- assign b_title = 'homepage.benefit_security_title' | t: default: 'Koneksi Aman & Andal' -%}
                {%- assign b_desc = 'homepage.benefit_security_desc' | t: default: 'Nikmati koneksi internet yang aman dan andal selama perjalanan ke luar negeri.' -%}
            {%- endcase -%}
          {%- endunless -%}
          <div class="gkh-card" {{ block.shopify_attributes }}>
            <div class="gkh-card__ic">
              {% if block.settings.icon != blank %}
                {% assign icon_name = block.settings.icon | append: '.svg' %}
                {{ icon_name | inline_asset_content }}
              {% else %}
                {% case forloop.index %}
                  {% when 1 %}{{ 'htu-simcard.svg' | inline_asset_content }}
                  {% when 2 %}{{ 'htu-qrcode.svg' | inline_asset_content }}
                  {% when 3 %}{{ 'htu-secure.svg' | inline_asset_content }}
                  {% else %}{{ 'htu-simcard.svg' | inline_asset_content }}
                {% endcase %}
              {% endif %}
            </div>
            <h3 class="gkh-card__t">{{ b_title }}</h3>
            <p class="gkh-card__p">{{ b_desc }}</p>
          </div>
        {% endfor %}
      {% else %}
        <div class="gkh-card">
          <div class="gkh-card__ic">{{ 'htu-simcard.svg' | inline_asset_content }}</div>
          <h3 class="gkh-card__t">{% if is_en %}Keep Your Number Active{% else %}{{ 'homepage.benefit_number_title' | t: default: 'Nomor Utama Tetap Aktif' }}{% endif %}</h3>
          <p class="gkh-card__p">{% if is_en %}Stay reachable on your primary number for calls, SMS and OTPs while using eSIM abroad.{% else %}{{ 'homepage.benefit_number_desc' | t: default: 'Tetap terima telepon, SMS dan OTP di nomor utamamu sambil menggunakan eSIM di luar negeri.' }}{% endif %}</p>
        </div>
        <div class="gkh-card">
          <div class="gkh-card__ic">{{ 'htu-qrcode.svg' | inline_asset_content }}</div>
          <h3 class="gkh-card__t">{% if is_en %}Quick &amp; Easy Setup{% else %}{{ 'homepage.benefit_setup_title' | t: default: 'Aktivasi Cepat & Mudah' }}{% endif %}</h3>
          <p class="gkh-card__p">{% if is_en %}No physical SIM card or store visit needed. Simply scan the QR code to install your eSIM.{% else %}{{ 'homepage.benefit_setup_desc' | t: default: 'Tanpa perlu ganti kartu SIM atau datang ke toko. Cukup scan QR code untuk memasang eSIM.' }}{% endif %}</p>
        </div>
        <div class="gkh-card">
          <div class="gkh-card__ic">{{ 'htu-secure.svg' | inline_asset_content }}</div>
          <h3 class="gkh-card__t">{% if is_en %}Secure &amp; Reliable Connection{% else %}{{ 'homepage.benefit_security_title' | t: default: 'Koneksi Aman & Andal' }}{% endif %}</h3>
          <p class="gkh-card__p">{% if is_en %}Enjoy secure mobile connectivity wherever your travels take you.{% else %}{{ 'homepage.benefit_security_desc' | t: default: 'Nikmati koneksi internet yang aman dan andal selama perjalanan ke luar negeri.' }}{% endif %}</p>
        </div>
      {% endif %}
    </div>
  </div>
</section>

<script>
  (function () {
    var r = document.querySelector('[data-gkh-rslider]');
    if (!r) return;
    var tr = r.querySelector('.gkh-rtrack');
    var nx = r.querySelector('.gkh-rnav--next');
    var pv = r.querySelector('.gkh-rnav--prev');
    if (!tr || !nx || !pv) return;

    var timer = null;
    var paused = false;
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function step() {
      var c = tr.querySelector('.gkh-rcard');
      return c ? c.offsetWidth + 16 : tr.clientWidth;
    }

    function atEnd() {
      return tr.scrollLeft + tr.clientWidth >= tr.scrollWidth - 4;
    }

    function next() {
      if (atEnd()) {
        tr.scrollTo({ left: 0, behavior: 'smooth' });
      } else {
        tr.scrollBy({ left: step(), behavior: 'smooth' });
      }
    }

    function prev() {
      if (tr.scrollLeft <= 4) {
        tr.scrollTo({ left: tr.scrollWidth, behavior: 'smooth' });
      } else {
        tr.scrollBy({ left: -step(), behavior: 'smooth' });
      }
    }

    function start() {
      if (reduce || timer) return;
      timer = setInterval(function () {
        if (!paused && !document.hidden) next();
      }, 2000);
    }

    function hold() {
      paused = true;
    }

    function free() {
      paused = false;
    }

    nx.addEventListener('click', next);
    pv.addEventListener('click', prev);

    var box = tr.parentNode;
    ['mouseenter', 'focusin', 'touchstart', 'pointerdown'].forEach(function (e) {
      box.addEventListener(e, hold, { passive: true });
    });

    ['mouseleave', 'focusout', 'touchend', 'pointerup', 'touchcancel'].forEach(function (e) {
      box.addEventListener(e, function () {
        setTimeout(free, 1500);
      }, { passive: true });
    });

    start();
  })();
</script>

