<!-- BENEFITS OF USING ESIM -->
<section class="gkh-sec">
  <div class="gkh-wrap">
    <h2 class="gkh-title">{{ section.settings.benefits_title | default: 'Benefits of Using eSIM' }}</h2>
    <div class="gkh-cards">
      {% if benefits_blocks.size > 0 %}
        {% for block in benefits_blocks %}
          <div class="gkh-card" {{ block.shopify_attributes }}>
            <div class="gkh-card__ic">
              {% if block.settings.icon != blank %}
                {% assign icon_name = block.settings.icon | append: '.svg' %}
                {{ icon_name | inline_asset_content }}
              {% else %}
                {% case forloop.index %}
                  {% when 1 %}{{ 'htu-simcard.svg' | inline_asset_content }}
                  {% when 2 %}{{ 'htu-qrcode.svg' | inline_asset_content }}
                  {% when 3 %}{{ 'htu-secure.svg' | inline_asset_content }}
                  {% else %}{{ 'htu-simcard.svg' | inline_asset_content }}
                {% endcase %}
              {% endif %}
            </div>
            <h3 class="gkh-card__t">{{ block.settings.title }}</h3>
            <p class="gkh-card__p">{{ block.settings.paragraph }}</p>
          </div>
        {% endfor %}
      {% else %}
        <div class="gkh-card">
          <div class="gkh-card__ic">{{ 'htu-simcard.svg' | inline_asset_content }}</div>
          <h3 class="gkh-card__t">Keep Your Number Active</h3>
          <p class="gkh-card__p">Stay reachable on your primary number for calls, SMS and OTPs while using eSIM abroad.</p>
        </div>
        <div class="gkh-card">
          <div class="gkh-card__ic">{{ 'htu-qrcode.svg' | inline_asset_content }}</div>
          <h3 class="gkh-card__t">Quick &amp; Easy Setup</h3>
          <p class="gkh-card__p">No physical SIM card or store visit needed. Simply scan the QR code to install your eSIM.</p>
        </div>
        <div class="gkh-card">
          <div class="gkh-card__ic">{{ 'htu-secure.svg' | inline_asset_content }}</div>
          <h3 class="gkh-card__t">Secure &amp; Reliable Connection</h3>
          <p class="gkh-card__p">Enjoy secure mobile connectivity wherever your travels take you.</p>
        </div>
      {% endif %}
    </div>
  </div>
</section>

<script>
  (function () {
    var r = document.querySelector('[data-gkh-rslider]');
    if (!r) return;
    var tr = r.querySelector('.gkh-rtrack');
    var nx = r.querySelector('.gkh-rnav--next');
    var pv = r.querySelector('.gkh-rnav--prev');
    if (!tr || !nx || !pv) return;

    var timer = null;
    var paused = false;
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function step() {
      var c = tr.querySelector('.gkh-rcard');
      return c ? c.offsetWidth + 16 : tr.clientWidth;
    }

    function atEnd() {
      return tr.scrollLeft + tr.clientWidth >= tr.scrollWidth - 4;
    }

    function next() {
      if (atEnd()) {
        tr.scrollTo({ left: 0, behavior: 'smooth' });
      } else {
        tr.scrollBy({ left: step(), behavior: 'smooth' });
      }
    }

    function prev() {
      if (tr.scrollLeft <= 4) {
        tr.scrollTo({ left: tr.scrollWidth, behavior: 'smooth' });
      } else {
        tr.scrollBy({ left: -step(), behavior: 'smooth' });
      }
    }

    function start() {
      if (reduce || timer) return;
      timer = setInterval(function () {
        if (!paused && !document.hidden) next();
      }, 2000);
    }

    function hold() {
      paused = true;
    }

    function free() {
      paused = false;
    }

    nx.addEventListener('click', next);
    pv.addEventListener('click', prev);

    var box = tr.parentNode;
    ['mouseenter', 'focusin', 'touchstart', 'pointerdown'].forEach(function (e) {
      box.addEventListener(e, hold, { passive: true });
    });

    ['mouseleave', 'focusout', 'touchend', 'pointerup', 'touchcancel'].forEach(function (e) {
      box.addEventListener(e, function () {
        setTimeout(free, 1500);
      }, { passive: true });
    });

    start();
  })();
</script>

