<section class="gkh-hero" aria-label="Global Komunika eSIM">
  <div class="gkh-hero__media">
    {%- assign desktop_image = section.settings.image -%}
    {%- assign mobile_image = section.settings.image_mobile -%}

    {%- if desktop_image != blank -%}
      <picture>
        {%- if mobile_image != blank -%}
          <source media="(max-width: 899px)" srcset="{{ mobile_image | image_url: width: 900 }}">
        {%- endif -%}
        <img class="gkh-hero__img"
             src="{{ desktop_image | image_url: width: 2400 }}"
             alt="{{ desktop_image.alt | default: 'Global Komunika eSIM' | escape }}"
             loading="eager"
             fetchpriority="high"
             width="{{ desktop_image.width | default: 1920 }}"
             height="{{ desktop_image.height | default: 760 }}">
      </picture>
    {%- else -%}
      <img class="gkh-hero__img"
           src="https://cdn.shopify.com/s/files/1/0735/4204/1817/files/hero_homepage_banner.jpg?v=1792734835"
           alt="Traveler smiling while checking her phone with a coastal town in the background"
           loading="eager"
           fetchpriority="high"
           width="1920"
           height="760">
    {%- endif -%}
  </div>

  <div class="gkh-hero__content">
    {%- assign rendered_tag = false -%}
    {%- assign rendered_heading = false -%}
    {%- assign rendered_desc = false -%}
    {%- assign rendered_search = false -%}

    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'text' -%}
          {%- assign rendered_tag = true -%}
          <span class="gkh-hero__tag" {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
        {%- when 'heading' -%}
          {%- assign rendered_heading = true -%}
          <h1 class="gkh-hero__title" {{ block.shopify_attributes }}>{{ block.settings.heading }}</h1>
        {%- when 'desc' -%}
          {%- assign rendered_desc = true -%}
          <p class="gkh-hero__desc" {{ block.shopify_attributes }}>{{ block.settings.desc }}</p>
        {%- when 'search' -%}
          {%- assign rendered_search = true -%}
          <div {{ block.shopify_attributes }} style="width: 100%; max-width: 480px;">
            <form class="gkh-search" action="/search" method="get" role="search" data-country-autocomplete>
              <input class="gkh-search__input" type="search" name="q" placeholder="{{ section.settings.search_placeholder | default: 'Search Your Destination' }}" aria-label="{{ section.settings.search_placeholder | default: 'Search Your Destination' }}" autocomplete="off" data-country-input>
              <div data-country-suggestions class="max-h-[250px] overflow-auto bg-white rounded-[15px] p-[10px] shadow-lg" style="display:none;">
                <ul data-country-list class="flex flex-col"></ul>
              </div>
              <button class="gkh-search__btn" type="submit" aria-label="Search">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M16 16l5 5"/></svg>
              </button>
            </form>
          </div>
      {%- endcase -%}
    {%- endfor -%}

    {%- unless rendered_tag -%}
      <span class="gkh-hero__tag">{{ section.settings.tag | default: '#ALWAYSCONNECTED' }}</span>
    {%- endunless -%}
    {%- unless rendered_heading -%}
      <h1 class="gkh-hero__title">{{ section.settings.title | default: 'Instant eSIM by Global Komunika' }}</h1>
    {%- endunless -%}
    {%- unless rendered_desc -%}
      <p class="gkh-hero__desc">{{ section.settings.desc | default: 'Get your QR Code under 5 minutes right after you completed your order.' }}</p>
    {%- endunless -%}
    {%- unless rendered_search -%}
      <div style="width: 100%; max-width: 480px;">
        <form class="gkh-search" action="/search" method="get" role="search" data-country-autocomplete>
          <input class="gkh-search__input" type="search" name="q" placeholder="{{ section.settings.search_placeholder | default: 'Search Your Destination' }}" aria-label="{{ section.settings.search_placeholder | default: 'Search Your Destination' }}" autocomplete="off" data-country-input>
          <div data-country-suggestions class="max-h-[250px] overflow-auto bg-white rounded-[15px] p-[10px] shadow-lg" style="display:none;">
            <ul data-country-list class="flex flex-col"></ul>
          </div>
          <button class="gkh-search__btn" type="submit" aria-label="Search">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M16 16l5 5"/></svg>
          </button>
        </form>
      </div>
    {%- endunless -%}
  </div>

  {%- if section.settings.show_gcard != false -%}
    <div class="gkh-gcard">
      <div class="gkh-gcard__body">
        <p class="gkh-gcard__eyebrow">{{ section.settings.gcard_eyebrow | default: 'DISCOVER gSim!' }}</p>
        <h2 class="gkh-gcard__title">{{ section.settings.gcard_title | default: 'One gSim!<sup>TM</sup> Endless Destinations.' }}</h2>
        <p class="gkh-gcard__text">{{ section.settings.gcard_text | default: 'Activate once, top up anytime, and stay connected across multiple trips. No need to switch eSIMs.' }}</p>
      </div>
      <a class="gkh-gcard__cta" href="{{ section.settings.gcard_cta_url | default: '/pages/gsim' }}">
        {{ section.settings.gcard_cta_text | default: 'Explore gSim! &rarr;' }}
      </a>
    </div>
  {%- endif -%}
</section>

<script>
  (() => {
    if (window.__countryAutocompleteBootstrapped) return;
    window.__countryAutocompleteBootstrapped = true;

    const ENDPOINT = '/collections/all?view=country-api-json';

    const normalize = (str = '') => String(str).toLowerCase().trim().replace(/_/g, ' ').replace(/\s+/g, ' ');
    const toImgSrc = (url) => (!url ? null : url.startsWith('//') ? 'https:' + url : url);

    const escapeHtml = (s) =>
      String(s)
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#039;');

    function init(root) {
      if (root.dataset.autocompleteInitialized === 'true') return;
      root.dataset.autocompleteInitialized = 'true';

      const input = root.querySelector('[data-country-input]');
      const box = root.querySelector('[data-country-suggestions]');
      const list = root.querySelector('[data-country-list]');
      if (!input || !box || !list) return;

      document.body.appendChild(box);
      box.style.position = 'fixed';
      box.style.zIndex = '999999';
      box.style.display = 'none';

      const updatePos = () => {
        const rect = input.getBoundingClientRect();
        box.style.left = rect.left + 'px';
        box.style.top = rect.bottom + 8 + 'px';
        box.style.width = rect.width + 'px';
      };

      const showBox = () => {
        updatePos();
        box.style.display = 'block';
      };

      const hideBox = () => {
        box.style.display = 'none';
        list.innerHTML = '';
      };

      root.addEventListener('submit', (e) => {
        e.preventDefault();
        const q = input.value.trim();
        hideBox();
        window.location.href = q ? `/search?q=${encodeURIComponent(q)}` : '/search';
      });

      let index = null;
      let indexPromise = null;

      const buildIndex = (countries) => countries.map((c) => {
        const countryEn = (c.country_en || '').trim();
        const countryAliases = Array.isArray(c.country_alias) ? c.country_alias : [];
        const regions = Array.isArray(c.regions) ? c.regions : [];
        const regionTokens = regions.flatMap((r) => {
          const re = (r.region_en || '').trim();
          const rid = (r.region_id || '').trim();
          const rAliases = Array.isArray(r.region_alias) ? r.region_alias : [];
          return [re, rid, ...rAliases];
        });

        const tokens = [countryEn, ...countryAliases, ...regionTokens]
          .map((x) => normalize((x || '').trim()))
          .filter(Boolean);

        return {
          id: c.id,
          country_en: countryEn,
          country_id: c.country_id,
          country_flag: toImgSrc(c.country_flag),
          tokens: Array.from(new Set(tokens)),
        };
      });

      const loadIndex = () => {
        if (index) return Promise.resolve(index);
        if (indexPromise) return indexPromise;

        indexPromise = fetch(ENDPOINT, { credentials: 'same-origin' })
          .then((res) => {
            if (!res.ok) throw new Error(`HTTP ${res.status}`);
            return res.json();
          })
          .then((data) => {
            const countries = Array.isArray(data.search_keys) ? data.search_keys : [];
            index = buildIndex(countries);
            return index;
          })
          .catch((error) => {
            indexPromise = null;
            return [];
          });

        return indexPromise;
      };

      input.addEventListener('focus', () => {
        loadIndex();
      }, { once: true });

      const render = (items) => {
        if (!items || !items.length) {
          hideBox();
          return;
        }

        list.innerHTML = items
          .slice(0, 8)
          .map((item) => {
            const name = item.country_en || item.country_id || '';
            const flag = item.country_flag ? `<img src="${escapeHtml(item.country_flag)}" alt="" style="width:28px;height:28px;border-radius:6px;object-fit:cover;margin-right:10px;">` : '';
            return `
              <li style="list-style:none;padding:8px 12px;cursor:pointer;display:flex;align-items:center;border-radius:8px;font-size:15px;color:var(--gkh-primary);transition:background 0.15s;"
                  onmouseover="this.style.background='#f3fbfe'" onmouseout="this.style.background='transparent'"
                  data-name="${escapeHtml(name)}">
                ${flag}
                <span>${escapeHtml(name)}</span>
              </li>
            `;
          })
          .join('');

        list.querySelectorAll('li').forEach((li) => {
          li.addEventListener('click', () => {
            const val = li.getAttribute('data-name');
            input.value = val;
            hideBox();
            window.location.href = `/search?q=${encodeURIComponent(val)}`;
          });
        });

        showBox();
      };

      input.addEventListener('input', () => {
        const query = normalize(input.value);
        if (!query) {
          hideBox();
          return;
        }

        loadIndex().then((idx) => {
          const results = idx.filter((item) =>
            item.tokens.some((token) => token.includes(query))
          );
          render(results);
        });
      });

      document.addEventListener('click', (e) => {
        if (!root.contains(e.target) && !box.contains(e.target)) {
          hideBox();
        }
      });
      window.addEventListener('resize', updatePos);
      window.addEventListener('scroll', updatePos, { passive: true });
    }

    document.querySelectorAll('[data-country-autocomplete]').forEach(init);
  })();
</script>

{% schema %}
{
  "name": "Image Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero Image (Desktop)"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Hero Image (Mobile)",
      "info": "Optional mobile image. If blank, desktop image is used."
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search Placeholder",
      "default": "Search Your Destination"
    },
    {
      "type": "header",
      "content": "Discover gSim Card"
    },
    {
      "type": "checkbox",
      "id": "show_gcard",
      "label": "Show Discover gSim Card",
      "default": true
    },
    {
      "type": "text",
      "id": "gcard_eyebrow",
      "label": "Card Eyebrow",
      "default": "DISCOVER gSim!"
    },
    {
      "type": "text",
      "id": "gcard_title",
      "label": "Card Title",
      "default": "One gSim!<sup>TM</sup> Endless Destinations."
    },
    {
      "type": "textarea",
      "id": "gcard_text",
      "label": "Card Description",
      "default": "Activate once, top up anytime, and stay connected across multiple trips. No need to switch eSIMs."
    },
    {
      "type": "text",
      "id": "gcard_cta_text",
      "label": "Button Label",
      "default": "Explore gSim! →"
    },
    {
      "type": "url",
      "id": "gcard_cta_url",
      "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading Text",
          "default": "Instant eSIM by Global Komunika"
        },
        {
          "type": "select",
          "id": "heading_size",
          "options": [
            { "value": "h1", "label": "H1" },
            { "value": "h2", "label": "H2" },
            { "value": "h3", "label": "H3" }
          ],
          "default": "h1",
          "label": "Heading Size"
        }
      ]
    },
    {
      "type": "text",
      "name": "Tag / Text",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Tag Text",
          "default": "#ALWAYSCONNECTED"
        }
      ]
    },
    {
      "type": "desc",
      "name": "Description",
      "settings": [
        {
          "type": "textarea",
          "id": "desc",
          "label": "Description Text",
          "default": "Get your QR Code under 5 minutes right after you completed your order."
        }
      ]
    },
    {
      "type": "search",
      "name": "Search Bar",
      "limit": 1,
      "settings": []
    }
  ],
  "presets": [
    {
      "name": "Image Banner",
      "category": "Section"
    }
  ]
}
{% endschema %}
