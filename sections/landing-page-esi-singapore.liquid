  <!-- ===== HERO ===== -->
  <section class="gksg-hero-wrap" id="gksg-hero">
    <div class="gksg-hero">
      <img
        class="gksg-hero-img"
        src="{{ hero_img_url }}"
        alt="eSIM Singapore Global Komunika"
        width="1440"
        height="440"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      >
      <div class="gksg-hero-in">
        <div class="gksg-hero-top">
          <a class="gksg-compat" href="{{ section.settings.hero_compat_url | default: '#gksg-cek-hp' }}">
            <svg class="gksg-i" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href="#gksg-i-info"/></svg>
            <span>{{ section.settings.hero_compat_text | default: 'Cek HP Support eSIM' }}</span>
          </a>
        </div>
        <div class="gksg-hero-body">
          {%- if section.settings.hero_title != blank -%}
            <h1 class="gksg-h1">{{ section.settings.hero_title }}</h1>
          {%- else -%}
            <h1 class="gksg-h1"><span class="gksg-h1-big"><span class="gksg-hl">eSIM</span> <span>Singapore<span class="gksg-sr">,</span></span></span>
          <span class="gksg-h1-sub">Internet Praktis untuk Traveling Tanpa Ganti SIM Card</span></h1>
          {%- endif -%}
          {%- if section.settings.hero_sub != blank -%}
            <p class="gksg-hero-lead">{{ section.settings.hero_sub }}</p>
          {%- else -%}
            <p class="gksg-hero-lead">Liburan ke Singapore lebih tenang dengan eSIM dari Global Komunika. QR Code dikirim ke email, langsung aktif saat tiba di Changi, dan nomor WhatsApp Indonesia tetap aktif.</p>
          {%- endif -%}
          <div class="gksg-hero-foot">
            <div class="gksg-hero-price">
              <span class="gksg-hero-price-lbl">Mulai dari</span>
              <b>{{ section.settings.hero_price | default: 'Rp39.000' }}</b>
            </div>
            <a class="gksg-btn" href="{{ section.settings.hero_btn_url | default: '#gksg-paket' }}">{{ section.settings.hero_btn_text | default: 'Lihat paket' }}</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== PILIH PAKET ===== -->
  <section class="gksg-sec gksg-sec--mist" id="gksg-paket">
    <div class="gksg-wrap">
      <div class="gksg-head">
        <div>
          <h2 class="gksg-h2">{{ section.settings.packages_title | default: 'Pilih Paket Internet Singapore Sesuai Kebutuhan' }}</h2>
          {%- if section.settings.packages_lead != blank -%}
            <p class="gksg-lead">{{ section.settings.packages_lead }}</p>
          {%- elsif 'Cek harga eSIM Singapore dan pilih paket data sesuai durasi perjalanan serta kebutuhan internet kamu' != '' -%}
            <p class="gksg-lead">Cek harga eSIM Singapore dan pilih paket data sesuai durasi perjalanan serta kebutuhan internet kamu</p>
          {%- endif -%}
        </div>
        <div class="gksg-ctrls" data-gksg-for="gksg-track-c" aria-label="Navigasi paket">
          <button class="gksg-arrow" type="button" data-gksg-dir="-1" aria-label="Geser ke kiri" disabled>
            <svg class="gksg-i" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href="#gksg-i-al"/></svg>
          </button>
          <button class="gksg-arrow" type="button" data-gksg-dir="1" aria-label="Geser ke kanan">
            <svg class="gksg-i" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href="#gksg-i-ar"/></svg>
          </button>
        </div>
      </div>

      <div class="gksg-track gksg-track-c" id="gksg-track-c" tabindex="0" role="region" aria-label="Pilihan paket internet Singapore">
        {%- assign product_count = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'product_card' -%}
            {%- assign product_count = product_count | plus: 1 -%}
            {%- assign card_product = block.settings.product -%}
            {%- assign card_title = block.settings.title -%}
            {%- if card_title == blank and card_product != blank -%}
              {%- assign card_title = card_product.title -%}
            {%- endif -%}
            {%- assign card_handle = block.settings.handle -%}
            {%- if card_handle == blank and card_product != blank -%}
              {%- assign card_handle = card_product.handle -%}
            {%- endif -%}
            {%- assign card_url = block.settings.button_url -%}
            {%- if card_url == blank and card_product != blank -%}
              {%- assign card_url = card_product.url -%}
            {%- elsif card_url == blank and card_handle != blank -%}
              {%- assign card_url = '/products/' | append: card_handle -%}
            {%- elsif card_url == blank -%}
              {%- assign card_url = '#' -%}
            {%- endif -%}
            {%- assign card_fallback = block.settings.price_fallback -%}
            {%- if card_fallback == blank and card_product != blank -%}
              {%- assign card_fallback = card_product.price_min | divided_by: 100 -%}
            {%- endif -%}
            {%- assign card_price = block.settings.price -%}
            {%- if card_price == blank and card_product != blank -%}
              {%- assign card_price = card_product.price_min | money -%}
            {%- endif -%}
            <article class="gksg-card {{ block.settings.card_extra_class }}" {{ block.shopify_attributes }}>
              <div class="gksg-c-head">
                <span class="gksg-ft">
                  <svg class="gksg-fl" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
                    <use href="#gksg-f-{{ block.settings.flag | default: 'sg' }}"/>
                  </svg>
                </span>
                <h3 class="gksg-c-title">
                  <span class="gksg-tag">{{ block.settings.tag | default: 'eSIM' }}</span>
                  <span class="gksg-c-name">{{ card_title }}</span>
                </h3>
              </div>
              <div class="gksg-cover">
                <svg class="gksg-i" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href="#gksg-i-globe"/></svg>
                <b>{{ block.settings.coverage | default: '1 negara' }}</b>
              </div>
              <div class="gksg-c-foot">
                <div class="gksg-price">
                  <small>{{ block.settings.price_prefix | default: 'Mulai dari' }}</small>
                  <b class="gksg-price-val" data-gksg-handle="{{ card_handle }}" data-gksg-fallback="{{ card_fallback }}">{{ card_price }}</b>
                </div>
                <a class="gksg-btn" href="{{ card_url }}">{{ block.settings.button_label | default: 'Lihat paket' }}</a>
              </div>
            </article>
          {%- endif -%}
        {%- endfor -%}

        {%- if product_count == 0 -%}
          <!-- Default Fallback Cards -->
          <article class="gksg-card ">
<div class="gksg-c-head"><span class="gksg-ft"><svg class="gksg-fl" viewBox="0 0 40 40" aria-hidden="true" focusable="false"><use href="#gksg-f-sg"/></svg></span><h3 class="gksg-c-title"><span class="gksg-tag">eSIM</span> <span class="gksg-c-name">Singapore</span></h3></div>
<div class="gksg-cover"><svg class="gksg-i" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href="#gksg-i-globe"/></svg><b>1 negara</b></div>
<div class="gksg-c-foot"><div class="gksg-price"><small>Mulai dari</small><b class="gksg-price-val" data-gksg-handle="esim-singapore" data-gksg-fallback="39000">Rp39.000</b></div><a class="gksg-btn" href="https://gkomunika.com/products/esim-singapore">Lihat paket</a></div>
