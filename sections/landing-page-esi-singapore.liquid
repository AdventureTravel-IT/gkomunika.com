<script>
(function () {
  'use strict';
  /* ===== PENGATURAN (ubah di sini) ===== */
  var CONFIG = {
    autoScrollMs: 2000,      /* testimoni: geser otomatis tiap 2 detik */
    resumeAfterMs: 4000,     /* jeda setelah pengunjung menyentuh / menggeser */
    priceCacheMs: 1800000    /* simpan harga 30 menit di browser */
  };

  function prefersReducedMotion() {
    try { return window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches; } catch (e) { return false; }
  }

  /* ===== Slider horizontal (paket + testimoni) ===== */
  function initTrack(track) {
    var id = track.id;
    var ctrls = id ? document.querySelectorAll('[data-gksg-for="' + id + '"]') : [];
    var prev = null, next = null, groups = [];
    Array.prototype.forEach.call(ctrls, function (c) {
      var p = c.querySelector('[data-gksg-dir="-1"]'), n = c.querySelector('[data-gksg-dir="1"]');
      if (p) prev = p; if (n) next = n; groups.push(c);
    });
    function step() {
      var first = track.firstElementChild;
      if (!first) return 300;
      var gap = parseFloat(window.getComputedStyle(track).columnGap) || 16;
      return first.getBoundingClientRect().width + gap;
    }
    function update() {
      var max = track.scrollWidth - track.clientWidth;
      var isStatic = max <= 4;
      groups.forEach(function (g) { g.classList.toggle('is-static', isStatic); });
      if (prev) prev.disabled = track.scrollLeft <= 4;
      if (next) next.disabled = track.scrollLeft >= max - 4;
    }
    function go(dir) { track.scrollBy({ left: dir * step(), behavior: 'smooth' }); }
    if (prev) prev.addEventListener('click', function () { go(-1); });
    if (next) next.addEventListener('click', function () { go(1); });
    track.addEventListener('scroll', function () { window.requestAnimationFrame(update); }, { passive: true });
    window.addEventListener('resize', update);
    track.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowRight') go(1);
      if (e.key === 'ArrowLeft') go(-1);
    });
    update();
    if (track.hasAttribute('data-gksg-auto')) initAuto(track, step, groups);
  }

  /* ===== Geser otomatis ===== */
  function initAuto(track, step, groups) {
    if (prefersReducedMotion()) return;
    var ms = parseInt(track.getAttribute('data-gksg-auto'), 10) || CONFIG.autoScrollMs;
    var box = track.parentNode;
    var pausedUntil = 0, hover = false, focus = false, visible = true;
    function pause() { pausedUntil = Date.now() + CONFIG.resumeAfterMs; }
    box.addEventListener('mouseenter', function () { hover = true; });
    box.addEventListener('mouseleave', function () { hover = false; });
    box.addEventListener('focusin', function () { focus = true; });
    box.addEventListener('focusout', function () { focus = false; });
    box.addEventListener('touchstart', pause, { passive: true });
    box.addEventListener('pointerdown', pause);
    groups.forEach(function (g) { g.addEventListener('click', pause); });
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(function (entries) { visible = entries[0].isIntersecting; }, { threshold: 0.25 }).observe(box);
    }
    window.setInterval(function () {
      if (document.hidden || !visible || hover || focus || Date.now() < pausedUntil) return;
      var max = track.scrollWidth - track.clientWidth;
      if (max <= 4) return;
      if (track.scrollLeft >= max - 4) track.scrollTo({ left: 0, behavior: 'smooth' });
      else track.scrollBy({ left: step(), behavior: 'smooth' });
    }, ms);
  }

  /* ===== Tab perbandingan (mobile) ===== */
  function initVs(vs) {
    var btns = vs.querySelectorAll('[data-gksg-tab]');
    Array.prototype.forEach.call(btns, function (b) {
      b.addEventListener('click', function () {
        var key = b.getAttribute('data-gksg-tab');
        vs.setAttribute('data-active', key);
        Array.prototype.forEach.call(btns, function (x) {
          var on = x === b;
          x.classList.toggle('is-on', on);
          x.setAttribute('aria-selected', on ? 'true' : 'false');
        });
      });
    });
  }

  /* ===== FAQ: satu terbuka pada satu waktu ===== */
  function initFaq(faq) {
    var items = faq.querySelectorAll('details');
    Array.prototype.forEach.call(items, function (d) {
      d.addEventListener('toggle', function () {
        if (!d.open) return;
        Array.prototype.forEach.call(items, function (o) { if (o !== d) o.open = false; });
      });
    });
  }

  /* ===== Harga termurah otomatis dari produk di website ===== */
  function formatRp(n) {
    var s = String(Math.round(n));
    try { s = Math.round(n).toLocaleString('id-ID'); } catch (e) { s = s.replace(/\B(?=(\d{3})+(?!\d))/g, '.'); }
    return 'Rp' + s;
  }
  function pickValue(raw, fallback) {
    var c = [raw, raw / 100], best = null, bestD = Infinity;
    for (var i = 0; i < c.length; i++) {
      if (!(c[i] > 0)) continue;
      var d = fallback > 0 ? Math.abs(Math.log(c[i] / fallback)) : i;
      if (d < bestD) { bestD = d; best = c[i]; }
    }
    return best;
  }
  function cheapest(data, fallback) {
    var v = data && data.variants;
    if (!v || !v.length) return null;
    var min = null;
    for (var i = 0; i < v.length; i++) {
      if (v[i].available === false) continue;
      var p = pickValue(Number(v[i].price), fallback);
      if (p && (min === null || p < min)) min = p;
    }
    return min;
  }
  function readCache(key) {
    try {
      var o = JSON.parse(window.sessionStorage.getItem(key));
      if (o && Date.now() - o.t < CONFIG.priceCacheMs) return o.p;
    } catch (e) {}
    return null;
  }
  function writeCache(key, p) {
    try { window.sessionStorage.setItem(key, JSON.stringify({ p: p, t: Date.now() })); } catch (e) {}
  }
  function initPrices() {
    var els = document.querySelectorAll('.gksg-price-val[data-gksg-handle]');
    var groups = {};
    Array.prototype.forEach.call(els, function (el) {
      var h = el.getAttribute('data-gksg-handle');
      (groups[h] = groups[h] || []).push(el);
    });
    Object.keys(groups).forEach(function (h) {
      var list = groups[h];
      var fb = Number(list[0].getAttribute('data-gksg-fallback')) || 0;
      function apply(p) { if (p > 0) list.forEach(function (el) { el.textContent = formatRp(p); }); }
      var cached = readCache('gksg:price:' + h);
      if (cached) { apply(cached); return; }
      if (!window.fetch) return;
      window.fetch('/products/' + h + '.js', { headers: { Accept: 'application/json' }, credentials: 'same-origin' })
        .then(function (r) { if (!r.ok) throw new Error('x'); return r.json(); })
        .then(function (data) {
          var p = cheapest(data, fb);
          if (p) { apply(p); writeCache('gksg:price:' + h, p); }
        })
        .catch(function () { /* gagal: tetap pakai harga bawaan di HTML */ });
    });
  }

  function init() {
    Array.prototype.forEach.call(document.querySelectorAll('.gksg-track'), initTrack);
    Array.prototype.forEach.call(document.querySelectorAll('[data-gksg-vs]'), initVs);
    Array.prototype.forEach.call(document.querySelectorAll('[data-gksg-faq]'), initFaq);
    initPrices();
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
</script>

