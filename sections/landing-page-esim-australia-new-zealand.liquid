        src="{{ hero_img_url }}"
        alt="eSIM Australia & New Zealand Global Komunika"
        width="1440"
        height="440"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      >
      <div class="gkau-hero-in">
        <div class="gkau-hero-top">
          <a class="gkau-compat" href="{{ section.settings.hero_compat_url | default: '#gkau-cek-hp' }}">
            <svg class="gkau-i" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href="#gkau-i-info"/></svg>
            <span>{{ section.settings.hero_compat_text | default: 'Cek HP Support eSIM' }}</span>
          </a>
        </div>
        <div class="gkau-hero-body">
          {%- if section.settings.hero_title != blank -%}
            <h1 class="gkau-h1">{{ section.settings.hero_title }}</h1>
          {%- else -%}
            <h1 class="gkau-h1"><span class="gkau-h1-big"><span class="gkau-hl">eSIM</span> <span>Australia &amp; New Zealand<span class="gkau-sr">,</span></span></span>
          <span class="gkau-h1-sub">Internet Praktis untuk Traveling</span></h1>
          {%- endif -%}
          {%- if section.settings.hero_sub != blank -%}
            <p class="gkau-hero-lead">{{ section.settings.hero_sub }}</p>
          {%- else -%}
            <p class="gkau-hero-lead">Liburan ke Australia & New Zealand lebih tenang dengan eSIM dari Global Komunika. QR Code dikirim ke email, langsung aktif begitu mendarat, dan nomor WhatsApp Indonesia tetap aktif.</p>
          {%- endif -%}
          <div class="gkau-hero-foot">
            <div class="gkau-hero-price">
              <span class="gkau-hero-price-lbl">Mulai dari</span>
              <b>{{ section.settings.hero_price | default: 'Rp19.000' }}</b>
