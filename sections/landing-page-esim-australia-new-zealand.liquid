{% comment %}
  Shopify Section for Global Komunika eSIM Australia & New Zealand Landing Page.
  Converted dynamically from esim-australia-new-zealand.html with full Theme Customizer support.
{% endcomment %}

{%- assign hero_img_url = section.settings.hero_image_url -%}
{%- if section.settings.hero_image != blank -%}
  {%- assign hero_img_url = section.settings.hero_image | image_url: width: 1400 -%}
{%- elsif hero_img_url == blank -%}
  {%- assign hero_img_url = 'https://cdn.shopify.com/s/files/1/0735/4204/1817/files/LP_AUZ_NZ.png?v=1794977727' -%}
{%- endif -%}

{%- assign wa_number = section.settings.whatsapp_number | default: '628156080055' -%}
{%- assign wa_text = section.settings.whatsapp_text | default: 'Halo Global Komunika, saya ingin tanya seputar eSIM Australia & New Zealand' | url_encode -%}

<style>
@font-face{font-family:"Gotham";font-weight:400;font-style:normal;font-display:swap;src:url("https://cdn.shopify.com/s/files/1/0735/4204/1817/files/Gotham-Book.otf?v=1794546841") format("opentype");}
@font-face{font-family:"Gotham";font-weight:700;font-style:normal;font-display:swap;src:url("https://cdn.shopify.com/s/files/1/0735/4204/1817/files/Gotham-Bold.otf?v=1794546841") format("opentype");}
html,body{margin:0;padding:0;background:#fff}


#gk-section-{{ section.id }}.gkau-page,
#gk-section-{{ section.id }} {
  --gkau-blue: {{ section.settings.brand_blue | default: '#005496' }};
  --gkau-cyan: {{ section.settings.brand_sky | default: '#00ADEE' }};
  --gkau-ink: #222222;
  --gkau-text: #2B2F33;
  --gkau-muted: #5A6570;
  --gkau-mist: #F4F7FA;
  --gkau-tint: #CCEFFC;
  --gkau-tint2: #E3F6FD;
  --gkau-line: #DDE4EA;
  --gkau-green: #2E884A;
  --gkau-star: #FBB526;
  box-sizing: border-box;
  color-scheme: light;
  position: relative;
  background: #fff;
  color: var(--gkau-text);
  font-family: "Gotham", "Gotham Rounded", "Montserrat", Arial, Helvetica, sans-serif;
  font-weight: 400;
  font-size: 16px;
  line-height: 1.6;
  -webkit-text-size-adjust: 100%;
  overflow-x: hidden;
  width: 100%;
}
#MainContent:has(#gk-section-{{ section.id }}) {
  max-width: 100% !important;
  padding-left: 0 !important;
  padding-right: 0 !important;
}

.gkau-page *,.gkau-page *::before,.gkau-page *::after{box-sizing:border-box}
:where(.gkau-page) :is(h1,h2,h3,p,ul,ol,li,blockquote,small,figure){margin:0;padding:0}
:where(.gkau-page) :is(ul,ol){list-style:none}
:where(.gkau-page) a{color:inherit}
.gkau-page button{font-family:inherit}
.gkau-page :focus-visible{outline:3px solid var(--gkau-cyan);outline-offset:3px;border-radius:6px}
.gkau-sr{position:absolute;width:1px;height:1px;margin:-1px;padding:0;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
.gkau-i{display:block;width:100%;height:100%}
.gkau-wrap{width:100%;max-width:1120px;margin:0 auto;padding:0 32px}
.gkau-sec{padding:72px 0 80px}
.gkau-sec--mist{background:var(--gkau-mist)}
.gkau-h2{font-size:30px;line-height:1.25;font-weight:700;letter-spacing:-.01em;color:var(--gkau-blue);max-width:760px}
.gkau-lead{margin-top:12px;color:var(--gkau-muted);max-width:640px}
.gkau-btn{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:12px 28px;border-radius:999px;background:var(--gkau-blue);color:#fff;font-family:inherit;font-weight:700;font-size:16px;line-height:1.2;text-decoration:none;border:2px solid var(--gkau-blue);white-space:nowrap;cursor:pointer;transition:background .2s,border-color .2s}
.gkau-btn:hover{background:#003F73;border-color:#003F73}
.gkau-btn--light{background:#fff;color:var(--gkau-blue);border-color:#fff}
.gkau-btn--light:hover{background:var(--gkau-tint2);border-color:var(--gkau-tint2)}
.gkau-tag{display:inline-block;font-weight:700;font-size:15px;line-height:1.45;color:#fff;background:var(--gkau-blue);border-radius:8px;padding:1px 10px;white-space:nowrap}
.gkau-tag-s{background:#8A97A3}
@media (prefers-reduced-motion:no-preference){.gkau-page{scroll-behavior:smooth}}

/* ===== HERO ===== */
.gkau-hero{position:relative;height:440px;overflow:hidden;background:linear-gradient(180deg,#00487F 0%,#0A6BB0 38%,#2F9BD6 68%,#8FCBEA 88%,#fff 100%);color:#fff}
.gkau-hero-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:0}
.gkau-hero-img[src=""]{display:none}
.gkau-hero::before{content:"";position:absolute;inset:0;z-index:1;background:linear-gradient(90deg,rgba(0,35,75,.52) 0%,rgba(0,35,75,.3) 42%,rgba(0,35,75,0) 72%),linear-gradient(180deg,rgba(0,40,80,.34) 0%,rgba(0,40,80,.12) 70%,rgba(0,40,80,0) 100%)}
.gkau-hero::after{content:"";position:absolute;left:0;right:0;bottom:0;height:150px;z-index:1;background:linear-gradient(180deg,rgba(255,255,255,0) 0%,#fff 92%)}
.gkau-hero-in{position:relative;z-index:2;max-width:1120px;margin:0 auto;padding:0 32px;height:100%}
.gkau-hero-top{display:flex;justify-content:flex-end;padding-top:28px}
.gkau-compat{display:inline-flex;align-items:center;gap:8px;min-height:44px;padding:10px 20px;border-radius:999px;background:#FBB526;color:#003F73;font-weight:700;font-size:15px;line-height:1.2;text-decoration:none;white-space:nowrap;box-shadow:0 6px 18px rgba(0,30,70,.25)}
.gkau-compat .gkau-i{width:18px;height:18px;flex:0 0 18px;color:#003F73}
.gkau-cmp-m{display:none}
.gkau-hero-row{display:flex;justify-content:space-between;align-items:flex-end;gap:24px;margin-top:84px}
.gkau-h1{font-weight:700;line-height:1.1;letter-spacing:-.01em;color:#fff;text-shadow:0 2px 14px rgba(0,30,70,.45)}
.gkau-hl{text-shadow:none}
.gkau-h1-big{display:flex;align-items:center;gap:14px;font-size:48px}
.gkau-hl{display:inline-block;background:#FBB526;color:var(--gkau-blue);border-radius:12px;padding:0 14px 4px}
.gkau-h1-sub{display:block;margin-top:14px;font-weight:400;font-size:22px;line-height:1.35;max-width:700px;color:#fff}
.gkau-chips{display:flex;gap:10px;flex-wrap:wrap;justify-content:flex-end;max-width:420px;padding-bottom:6px}
.gkau-chip{display:inline-flex;align-items:center;gap:8px;background:#fff;color:var(--gkau-ink);border-radius:999px;padding:8px 16px;font-weight:700;font-size:15px;line-height:1.3;box-shadow:0 4px 14px rgba(0,30,70,.18)}
.gkau-chip .gkau-i{width:18px;height:18px;flex:0 0 18px;color:var(--gkau-blue)}
.gkau-intro{max-width:1120px;margin:0 auto;padding:8px 32px 8px}
.gkau-intro-p{max-width:680px}
.gkau-cta-row{display:flex;align-items:center;gap:20px;margin-top:24px;flex-wrap:wrap}
.gkau-cta-row .gkau-btn{min-height:52px;padding:12px 28px}
.gkau-note{display:flex;align-items:center;gap:10px;font-size:14px;color:var(--gkau-muted)}
.gkau-note span.gkau-ni{width:24px;height:24px;border-radius:50%;background:var(--gkau-green);color:#fff;display:grid;place-items:center;flex:0 0 24px}
.gkau-note span.gkau-ni .gkau-i{width:13px;height:13px}

/* ===== PAKET ===== */
.gkau-head-row{display:flex;justify-content:space-between;align-items:flex-end;gap:24px}
.gkau-arrows{display:flex;gap:10px;flex:0 0 auto}
.gkau-arrow{width:48px;height:48px;border-radius:50%;border:2px solid var(--gkau-blue);background:#fff;color:var(--gkau-blue);display:grid;place-items:center;cursor:pointer;padding:0;transition:background .2s,color .2s,opacity .2s}
.gkau-arrow .gkau-i{width:20px;height:20px}
.gkau-arrow:hover:not(:disabled){background:var(--gkau-blue);color:#fff}
.gkau-arrow:disabled{opacity:.35;cursor:default}
.gkau-arrows.is-static{display:none}
.gkau-track{display:flex;gap:20px;overflow-x:auto;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;scrollbar-width:none;margin-top:36px;padding:4px 0 10px}
.gkau-track::-webkit-scrollbar{display:none}
.gkau-track>*{scroll-snap-align:start}
.gkau-track-pk>*{flex:0 0 480px}
.gkau-card{background:#fff;border:1px solid var(--gkau-line);border-radius:24px;padding:24px 28px;display:flex;flex-direction:column;gap:14px}
.gkau-c-head{display:flex;align-items:center;gap:16px;min-height:113px;padding-bottom:16px;border-bottom:1px solid var(--gkau-line)}
.gkau-ft{display:block;width:60px;height:60px;border-radius:14px;overflow:hidden;border:1px solid rgba(0,0,0,.12);background:#fff;flex:0 0 auto}
.gkau-fl{display:block;width:100%;height:100%}
.gkau-fg{display:grid;grid-template-columns:repeat(2,28px);grid-auto-rows:28px;gap:4px;width:60px;min-height:60px;align-content:center;flex:0 0 60px}
.gkau-fg .gkau-ft{width:28px;height:28px;border-radius:8px}
.gkau-ft-more{display:grid;place-items:center;background:#E8F0F7;border-color:#D3E0EB;color:var(--gkau-blue);font-weight:700;font-size:13px;line-height:1}
.gkau-c-title{display:flex;align-items:center;flex-wrap:wrap;gap:4px 10px;font-size:22px;line-height:1.3;font-weight:700;color:var(--gkau-blue)}
.gkau-cover{display:flex;align-items:center;gap:10px;font-size:18px;line-height:1.3;color:var(--gkau-ink)}
.gkau-cover .gkau-i{width:22px;height:22px;flex:0 0 22px;color:var(--gkau-blue)}
.gkau-cover b{font-weight:700}
.gkau-c-foot{margin-top:auto;display:flex;justify-content:space-between;align-items:center;gap:16px;border-top:1px solid var(--gkau-line);padding-top:16px}
.gkau-price small{display:block;font-size:14px;color:var(--gkau-muted);line-height:1.2}
.gkau-price b{display:block;font-size:28px;line-height:1.15;color:var(--gkau-ink);font-weight:700}
.gkau-gsim{margin-top:64px;display:grid;grid-template-columns:480px 480px;gap:20px;align-items:stretch}
.gkau-gmsg{display:flex;flex-direction:column}
.gkau-gh{font-size:28px;line-height:1.3;font-weight:700;color:var(--gkau-blue);max-width:480px}
.gkau-gpts{margin-top:24px;display:flex;flex-direction:column;gap:14px}
.gkau-gpts li{display:flex;align-items:center;gap:14px;min-height:48px;font-weight:700;font-size:17px;line-height:1.35;color:var(--gkau-blue)}
.gkau-gpts li span{flex:0 0 48px;width:48px;height:48px;border-radius:50%;background:var(--gkau-tint);color:var(--gkau-blue);display:grid;place-items:center}
.gkau-gpts li span .gkau-i{width:24px;height:24px}
.gkau-gsim .gkau-card{width:100%}
@media (max-width:1100px){.gkau-gsim{grid-template-columns:1fr;gap:28px}.gkau-gsim .gkau-card{max-width:480px}}

/* ===== BANDING ===== */
.gkau-seg{display:none}
.gkau-vs-grid{margin-top:40px;display:grid;grid-template-columns:1fr 1fr;column-gap:20px;align-items:start}
.gkau-vs-esim{background:var(--gkau-tint2);border-radius:24px;padding-bottom:10px}
.gkau-vs-h{display:flex;align-items:center;min-height:64px;padding:22px 28px 6px}
.gkau-vs-col li{display:flex;align-items:center;gap:16px;min-height:96px;padding:14px 28px}
.gkau-ic{flex:0 0 44px;width:44px;height:44px;border-radius:50%;display:grid;place-items:center}
.gkau-ic .gkau-i{width:22px;height:22px}
.gkau-vs-esim .gkau-ic{background:var(--gkau-blue);color:#fff}
.gkau-vs-sim .gkau-ic{background:#EEF2F5;color:#8A97A3}
.gkau-vs-sim li{border-bottom:1px solid #E3E9EE}
.gkau-vs-sim li:last-child{border-bottom:0}
.gkau-vs-col small{display:block;font-size:14px;line-height:1.3;color:var(--gkau-muted)}
.gkau-vs-esim b{display:block;font-size:17px;line-height:1.35;color:var(--gkau-blue);font-weight:700}
.gkau-val{display:block;font-size:17px;line-height:1.35;color:var(--gkau-muted)}

/* ===== CEK HP ===== */
.gkau-hp-list{margin-top:36px;display:flex;flex-direction:column;gap:16px}
.gkau-hp{background:#fff;border:1px solid var(--gkau-line);border-radius:24px;padding:24px 32px;display:grid;grid-template-columns:240px 1fr;gap:32px;align-items:center;min-height:113px}
.gkau-hp-who{display:flex;align-items:center;gap:14px}
.gkau-ico{flex:0 0 52px;width:52px;height:52px;border-radius:50%;background:var(--gkau-tint);color:var(--gkau-blue);display:grid;place-items:center}
.gkau-ico .gkau-i{width:26px;height:26px}
.gkau-hp-t{font-size:22px;line-height:1.3;color:var(--gkau-blue);font-weight:700}
.gkau-hp-how{border-left:1px solid var(--gkau-line);padding-left:32px;display:flex;flex-direction:column;gap:10px;justify-content:center}
.gkau-path{font-weight:700;font-size:17px;line-height:1.5;color:var(--gkau-ink)}
.gkau-pt{white-space:nowrap}
.gkau-pt-last{color:var(--gkau-blue)}
.gkau-sep{display:inline-block;width:7px;height:7px;border-right:2px solid #8A97A3;border-top:2px solid #8A97A3;transform:rotate(45deg);margin:0 11px 1px 7px}
.gkau-res{display:flex;gap:12px;align-items:flex-start}
.gkau-res-i{flex:0 0 26px;width:26px;height:26px;border-radius:50%;background:var(--gkau-green);color:#fff;display:grid;place-items:center;margin-top:1px}
.gkau-res-i .gkau-i{width:14px;height:14px}

/* ===== AKTIVASI ===== */
.gkau-act{margin-top:40px;display:grid;grid-template-columns:repeat(3,1fr);gap:20px;align-items:stretch}
.gkau-act-c{background:var(--gkau-mist);border-radius:24px;padding:28px;display:flex;flex-direction:column;gap:18px;position:relative}
.gkau-act-top{display:flex;flex-direction:column;gap:16px}
.gkau-num{width:48px;height:48px;border-radius:50%;background:var(--gkau-blue);color:#fff;display:grid;place-items:center;font-weight:700;font-size:20px}
.gkau-act-done .gkau-num{background:var(--gkau-green)}
.gkau-act-t{font-size:22px;line-height:1.3;color:var(--gkau-blue);font-weight:700;min-height:58px}
.gkau-act-p{color:#4A545E}
.gkau-act-c:not(:last-child)::after{content:"";position:absolute;top:52px;left:88px;right:-20px;height:2px;background:repeating-linear-gradient(90deg,#B8C4CE 0 6px,transparent 6px 12px)}

/* ===== MENGAPA ===== */
.gkau-sec--blue{background:var(--gkau-blue);color:#fff;padding:88px 0 96px}
.gkau-sec--blue .gkau-h2{color:#fff;font-size:32px;max-width:none}
.gkau-why{margin-top:40px;display:grid;grid-template-columns:repeat(3,1fr);background:rgba(255,255,255,.09);border:1px solid rgba(255,255,255,.18);border-radius:28px;padding:40px 0}
.gkau-why-c{display:flex;flex-direction:column;align-items:flex-start;gap:20px;padding:0 36px}
.gkau-why-c+.gkau-why-c{border-left:1px solid rgba(255,255,255,.22)}
.gkau-badge{display:inline-grid;place-items:center;min-height:48px;padding:0 24px;border-radius:14px;background:#fff;color:var(--gkau-blue);font-size:22px;line-height:1;font-weight:700;white-space:nowrap}
.gkau-why-t{font-size:20px;line-height:1.35;font-weight:700;color:#fff;min-height:54px}
.gkau-why-p{margin-top:-8px;color:#DCEBF7}

/* ===== TESTIMONI ===== */
.gkau-track-rv>*{flex:0 0 380px}
.gkau-rev{background:var(--gkau-mist);border-radius:24px;padding:26px 26px 24px;display:flex;flex-direction:column;gap:14px}
.gkau-stars{display:flex;gap:3px}
.gkau-stars .gkau-i{width:20px;height:20px;color:var(--gkau-star)}
.gkau-q{margin:0;color:var(--gkau-text)}
.gkau-rev-who{margin-top:auto;padding-top:16px;border-top:1px solid var(--gkau-line)}
.gkau-rev-who b{display:block;font-weight:700;color:var(--gkau-ink)}
.gkau-rev-who span{font-size:14px;color:var(--gkau-muted)}
.gkau-rv-ctrl{display:flex;gap:10px;margin-top:20px}

/* ===== FAQ ===== */
.gkau-faq{margin-top:32px;display:flex;flex-direction:column;gap:12px;max-width:820px}
.gkau-faq-i{background:#fff;border-radius:16px;border:1px solid var(--gkau-line)}
.gkau-faq-i[open]{border-color:var(--gkau-blue)}
.gkau-faq-s{list-style:none;cursor:pointer;display:flex;align-items:center;justify-content:space-between;gap:16px;min-height:56px;padding:14px 20px}
.gkau-faq-s::-webkit-details-marker{display:none}
.gkau-faq-s::after{content:"";flex:0 0 12px;width:12px;height:12px;border-right:2px solid var(--gkau-blue);border-bottom:2px solid var(--gkau-blue);transform:rotate(45deg);transition:transform .2s;margin-top:-4px}
.gkau-faq-i[open] .gkau-faq-s::after{transform:rotate(-135deg);margin-top:4px}
.gkau-faq-q{font-size:16px;line-height:1.4;font-weight:700;color:var(--gkau-ink)}
.gkau-faq-a{padding:0 20px 20px;color:var(--gkau-muted)}
.gkau-faq-p+.gkau-faq-p{margin-top:10px}
.gkau-faq-ol{margin-top:10px;display:flex;flex-direction:column;gap:6px;list-style:decimal;padding-left:20px}
.gkau-faq-ol li{display:list-item}
.gkau-link{color:var(--gkau-blue);font-weight:700}

/* ===== CTA AKHIR ===== */
.gkau-final{background:var(--gkau-blue);color:#fff;padding:88px 0;position:relative;overflow:hidden}
.gkau-final::before{content:"";position:absolute;right:-120px;top:-120px;width:360px;height:360px;border-radius:50%;background:linear-gradient(45deg,#005496 0%,#00ADEE 100%);opacity:.55}
.gkau-final .gkau-wrap{position:relative}
.gkau-final .gkau-h2{color:#fff;font-size:34px;max-width:640px}
.gkau-final-p{margin-top:14px;color:#DCEBF7;max-width:560px}
.gkau-final .gkau-btn{margin-top:28px}

/* ===== MOBILE ===== */
@media (max-width:767px){
  .gkau-wrap{padding:0 20px}
  .gkau-sec{padding:48px 0 56px}
  .gkau-h2{font-size:24px}
  .gkau-hero{height:470px}
  .gkau-hero::before{background:linear-gradient(180deg,rgba(0,35,75,.62) 0%,rgba(0,35,75,.52) 58%,rgba(0,35,75,0) 92%)}
  .gkau-hero-in{padding:0 20px}
  .gkau-hero-top{padding-top:20px}
  .gkau-compat{padding:8px 14px;font-size:14px}
  .gkau-cmp-d{display:none}.gkau-cmp-m{display:inline}
  .gkau-hero-row{flex-direction:column;align-items:flex-start;gap:16px;margin-top:64px}
  .gkau-h1-big{font-size:32px;gap:10px}
  .gkau-hl{padding:0 10px 3px;border-radius:10px}
  .gkau-h1-sub{font-size:18px;margin-top:10px}
  .gkau-chips{justify-content:flex-start;max-width:none;padding-bottom:0}
  .gkau-chip{font-size:14px;padding:7px 12px}
  .gkau-intro{padding:4px 20px 0}
  .gkau-cta-row .gkau-btn{width:100%}
  .gkau-head-row{flex-direction:column;align-items:flex-start;gap:20px}
  .gkau-track{margin:28px -20px 0;padding:4px 20px 10px;gap:14px;scroll-padding:0 20px}
  .gkau-track-pk>*{flex:0 0 min(340px,calc(100vw - 40px))}
  .gkau-card{padding:20px}
  .gkau-c-title{font-size:18px}
  .gkau-price b{font-size:24px}
  .gkau-c-foot .gkau-btn{padding:12px 14px;font-size:15px}
  .gkau-c-foot{gap:10px}
  .gkau-gsim{margin-top:44px;grid-template-columns:1fr;gap:24px}
  .gkau-gmsg{width:min(340px,calc(100vw - 40px))}
  .gkau-gsim .gkau-card{width:min(340px,calc(100vw - 40px))}
  .gkau-gh{font-size:22px}
  .gkau-gpts{margin-top:20px;gap:12px}
  .gkau-gpts li{font-size:16px;gap:12px}
  .gkau-gpts li span{flex:0 0 44px;width:44px;height:44px}
  .gkau-seg{display:flex;margin-top:28px;background:var(--gkau-mist);border-radius:999px;padding:4px;gap:4px}
  .gkau-seg-b{flex:1;display:grid;place-items:center;min-height:48px;border:0;border-radius:999px;background:transparent;font-weight:700;font-size:16px;color:var(--gkau-muted);cursor:pointer}
  .gkau-seg-b[data-gkau-tab="esim"].is-on{background:var(--gkau-blue);color:#fff}
  .gkau-seg-b[data-gkau-tab="sim"].is-on{background:#8A97A3;color:#fff}
  .gkau-vs-grid{display:block;margin-top:8px}
  .gkau-vs-esim{background:none;border-radius:0;padding-bottom:0}
  .gkau-vs-h{display:none}
  .gkau-vs[data-active="esim"] .gkau-vs-sim{display:none}
  .gkau-vs[data-active="sim"] .gkau-vs-esim{display:none}
  .gkau-vs-col li{min-height:0;padding:16px 0;border-bottom:1px solid #E3E9EE}
  .gkau-vs-col li:last-child{border-bottom:0}
  .gkau-vs-esim .gkau-ic{background:var(--gkau-tint);color:var(--gkau-blue)}
  .gkau-val{color:var(--gkau-text)}
  .gkau-hp-list{margin-top:28px;gap:12px}
  .gkau-hp{grid-template-columns:1fr;gap:14px;padding:20px;border-radius:22px;min-height:0;align-items:start}
  .gkau-ico{flex:0 0 44px;width:44px;height:44px}.gkau-ico .gkau-i{width:22px;height:22px}
  .gkau-hp-t{font-size:20px}
  .gkau-hp-how{border-left:0;padding-left:0}
  .gkau-path{font-size:16px}
  .gkau-act{grid-template-columns:1fr;gap:12px;margin-top:28px}
  .gkau-act-c{padding:22px;gap:14px;border-radius:22px}
  .gkau-act-top{flex-direction:row;align-items:center;gap:14px}
  .gkau-num{flex:0 0 44px;width:44px;height:44px;font-size:18px}
  .gkau-act-t{font-size:19px;min-height:0}
  .gkau-act-c:not(:last-child)::after{display:none}
  .gkau-sec--blue{padding:56px 0 60px}
  .gkau-sec--blue .gkau-h2{font-size:26px}
  .gkau-why{display:flex;flex-direction:column;gap:12px;margin-top:26px;background:none;border:0;padding:0}
  .gkau-why-c{background:rgba(255,255,255,.09);border:1px solid rgba(255,255,255,.18);border-radius:20px;padding:20px;gap:14px}
  .gkau-why-c+.gkau-why-c{border-left:1px solid rgba(255,255,255,.18)}
  .gkau-badge{min-height:40px;padding:0 18px;border-radius:12px;font-size:20px}
  .gkau-why-t{font-size:19px;min-height:0}
  .gkau-why-p{margin-top:-4px}
  .gkau-track-rv>*{flex:0 0 min(340px,calc(100vw - 56px))}
  .gkau-faq{margin-top:24px}
  .gkau-final{padding:56px 0}
  .gkau-final .gkau-h2{font-size:26px}
  .gkau-final .gkau-btn{width:100%}
}
@media (max-width:1000px) and (min-width:768px){
  .gkau-act{grid-template-columns:1fr}
  .gkau-act-c:not(:last-child)::after{display:none}
  .gkau-act-t{min-height:0}
  .gkau-why{grid-template-columns:1fr;padding:12px 0}
  .gkau-why-c{padding:24px 36px}
  .gkau-why-c+.gkau-why-c{border-left:0;border-top:1px solid rgba(255,255,255,.22)}
  .gkau-hp{grid-template-columns:200px 1fr}
}
@media (max-width:340px){.gkau-c-foot{flex-wrap:wrap}.gkau-c-foot .gkau-btn{width:100%}}
@media (max-width:380px){.gkau-price b{font-size:21px}.gkau-c-foot .gkau-btn{padding:12px 12px;font-size:14px}}
@media (prefers-reduced-motion:reduce){.gkau-page *{transition:none !important}}

.gkau-sec[hidden]{display:none}
.gkau-h1-big{flex-wrap:wrap;row-gap:4px}
@media (min-width:768px){.gkau-chips{max-width:360px}.gkau-h1{flex:0 0 auto}}


