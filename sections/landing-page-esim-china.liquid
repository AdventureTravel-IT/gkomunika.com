<style>
#gk-section-{{ section.id }} {
  --gkcn-blue: {{ section.settings.brand_blue | default: '#005496' }};
  --gkcn-sky: {{ section.settings.brand_sky | default: '#00ADEE' }};
  --gkcn-ink: #222222;
  --gkcn-mute: #5b6670;
  --gkcn-bg: #F5F8FB;
  --gkcn-line: #dfe6ec;
  --gkcn-white: #ffffff;
  --gkcn-red: #F61708;
  --gkcn-orange: #EA5A1B;
  --gkcn-teal: #66C0B6;
  --gkcn-green: #2E884A;
  --gkcn-yellow: #FBB526;
  font-family: "Gotham Rounded", system-ui, -apple-system, "Segoe UI", Arial, sans-serif;
  color: var(--gkcn-ink);
  font-size: 16px;
  line-height: 1.65;
  background: var(--gkcn-white);
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
  width: 100%;
}

#gk-section-{{ section.id }} *,
#gk-section-{{ section.id }} *::before,
#gk-section-{{ section.id }} *::after {
  box-sizing: border-box;
}

#gk-section-{{ section.id }} img {
  max-width: 100%;
  display: block;
}

:where(#gk-section-{{ section.id }}) h1,
:where(#gk-section-{{ section.id }}) h2,
:where(#gk-section-{{ section.id }}) h3,
:where(#gk-section-{{ section.id }}) p {
  margin: 0;
}

#gk-section-{{ section.id }} .gkcn-wrap {
  width: 100%;
  max-width: 1080px;
  margin: 0 auto;
  padding: 0 20px;
}

#gk-section-{{ section.id }} .gkcn-sec {
  padding: 64px 0;
}

#gk-section-{{ section.id }} .gkcn-sec--alt {
  background: var(--gkcn-bg);
}

#gk-section-{{ section.id }} .gkcn-h2 {
  font-weight: 700;
  font-size: 26px;
  line-height: 1.25;
  color: var(--gkcn-blue);
  letter-spacing: -.01em;
}

#gk-section-{{ section.id }} .gkcn-lead {
  margin-top: 12px;
  color: var(--gkcn-mute);
  max-width: 620px;
}

#gk-section-{{ section.id }} .gkcn-head {
  margin-bottom: 32px;
}

#gk-section-{{ section.id }} .gkcn-head--c {
  text-align: center;
}

#gk-section-{{ section.id }} .gkcn-head--c .gkcn-lead {
  margin-left: auto;
  margin-right: auto;
}

/* buttons */
#gk-section-{{ section.id }} .gkcn-btn,
.gkcn-sticky .gkcn-btn,
#gkcn-sticky-{{ section.id }} .gkcn-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 52px;
  padding: 0 28px;
  border-radius: 999px;
  font: 700 16px/1 "Gotham Rounded", system-ui, -apple-system, "Segoe UI", Arial, sans-serif;
  text-decoration: none;
  cursor: pointer;
  border: 2px solid var(--gkcn-blue, #005496);
  box-sizing: border-box;
  transition: background .2s, transform .2s, box-shadow .2s, border-color .2s;
}

#gk-section-{{ section.id }} .gkcn-btn--main,
.gkcn-sticky .gkcn-btn--main,
#gkcn-sticky-{{ section.id }} .gkcn-btn--main {
  background: var(--gkcn-blue, #005496);
  color: #fff;
  border: 2px solid var(--gkcn-blue, #005496);
  box-shadow: 0 8px 20px rgba(0,84,150,.25);
}

#gk-section-{{ section.id }} .gkcn-btn--main:hover,
.gkcn-sticky .gkcn-btn--main:hover,
#gkcn-sticky-{{ section.id }} .gkcn-btn--main:hover {
  background: #00427a;
  border-color: #00427a;
  color: #fff;
  transform: translateY(-1px);
}

#gk-section-{{ section.id }} .gkcn-btn--ghost,
.gkcn-sticky .gkcn-btn--ghost,
#gkcn-sticky-{{ section.id }} .gkcn-btn--ghost {
  background: #fff;
  color: var(--gkcn-blue, #005496);
  border: 2px solid var(--gkcn-blue, #005496);
}

#gk-section-{{ section.id }} .gkcn-btn--ghost:hover,
.gkcn-sticky .gkcn-btn--ghost:hover,
#gkcn-sticky-{{ section.id }} .gkcn-btn--ghost:hover {
  background: #eaf4fb;
  border-color: var(--gkcn-blue, #005496);
}

#gk-section-{{ section.id }} .gkcn-btn:focus-visible,
.gkcn-sticky .gkcn-btn:focus-visible,
#gkcn-sticky-{{ section.id }} .gkcn-btn:focus-visible,
#gk-section-{{ section.id }} .gkcn-tab:focus-visible,
#gk-section-{{ section.id }} .gkcn-faq summary:focus-visible {
  outline: 3px solid var(--gkcn-sky, #00ADEE);
  outline-offset: 3px;
}

/* hero */
#gk-section-{{ section.id }} .gkcn-hero {
  padding: 0 0 40px;
  background: linear-gradient(180deg, #eaf6fd 0%, #fff 100%);
}

#gk-section-{{ section.id }} .gkcn-hero-grid {
  display: grid;
  gap: 24px;
  align-items: center;
  padding-left: 0;
  padding-right: 0;
}

#gk-section-{{ section.id }} .gkcn-hero-media {
  order: -1;
  position: relative;
}

#gk-section-{{ section.id }} .gkcn-hero-media img {
  background: transparent;
  width: 100%;
  aspect-ratio: 4/3.3;
  object-fit: cover;
  object-position: 50% 30%;
  display: block;
}

#gk-section-{{ section.id }} .gkcn-hero-text {
  padding: 0 20px;
}

#gk-section-{{ section.id }} .gkcn-hero h1 {
  font-weight: 700;
  font-size: 31px;
  line-height: 1.25;
  color: var(--gkcn-blue);
  letter-spacing: -.015em;
}

#gk-section-{{ section.id }} .gkcn-hero-app {
  display: inline-flex;
  align-items: center;
  white-space: nowrap;
  vertical-align: middle;
  gap: 0.15em;
}

#gk-section-{{ section.id }} .gkcn-hero-app-icon {
  display: inline-block;
  width: 0.8em;
  height: 0.8em;
  object-fit: contain;
  vertical-align: middle;
  flex-shrink: 0;
}

#gk-section-{{ section.id }} .gkcn-hero-amp-br {
  display: inline;
}

#gk-section-{{ section.id }} .gkcn-hero-amp-wrap {
  display: inline-flex;
  align-items: center;
  white-space: nowrap;
  vertical-align: middle;
  gap: 0.18em;
}

#gk-section-{{ section.id }} .gkcn-hero-amp {
  font-weight: 700;
  color: inherit;
}

#gk-section-{{ section.id }} .gkcn-hero-sub {
  margin-top: 16px;
  font-size: 17px;
  color: #33414d;
  max-width: 520px;
}

#gk-section-{{ section.id }} .gkcn-price {
  margin-top: 24px;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 0;
  line-height: 1.2;
}

#gk-section-{{ section.id }} .gkcn-price small {
  font-size: 14px;
  color: var(--gkcn-mute);
  margin-bottom: 2px;
}

#gk-section-{{ section.id }} .gkcn-price strong {
  font-size: 34px;
  font-weight: 700;
  color: var(--gkcn-ink);
  letter-spacing: -.02em;
}

#gk-section-{{ section.id }} .gkcn-hero-cta {
  margin-top: 20px;
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
}

/* stats — biru + watermark GK sesuai hero.png Opsi 4 */
#gk-section-{{ section.id }} .gkcn-stats {
  position: relative;
  overflow: hidden;
  background: var(--gkcn-blue);
  color: #fff;
}

#gk-section-{{ section.id }} .gkcn-stats-wrap {
  position: relative;
}

#gk-section-{{ section.id }} .gkcn-stats-mark {
  position: absolute;
  right: -20px;
  top: 50%;
  transform: translateY(-50%);
  width: 220px;
  height: auto;
  opacity: {{ section.settings.stats_mark_opacity | default: 100 | divided_by: 100.0 }};
  pointer-events: none;
  user-select: none;
  -webkit-user-drag: none;
  z-index: 0;
}

#gk-section-{{ section.id }} .gkcn-stats-grid {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8px;
  padding: 26px 0 24px;
  text-align: center;
}

#gk-section-{{ section.id }} .gkcn-stats-grid::before {
  content: "";
  position: absolute;
  left: 16.6%;
  right: 16.6%;
  top: 44px;
  border-top: 2px dashed rgba(255,255,255,.45);
  z-index: 0;
  pointer-events: none;
}

#gk-section-{{ section.id }} .gkcn-stat {
  position: relative;
  z-index: 1;
}

#gk-section-{{ section.id }} .gkcn-stat svg {
  position: relative;
  z-index: 1;
  width: 40px;
  height: 40px;
  padding: 9px;
  border-radius: 50%;
  background: var(--gkcn-sky);
  box-shadow: 0 0 0 6px var(--gkcn-blue);
  stroke: #fff;
  fill: none;
  stroke-width: 1.8;
  stroke-linecap: round;
  stroke-linejoin: round;
  margin: 0 auto 10px;
  display: block;
}

#gk-section-{{ section.id }} .gkcn-stat b {
  display: block;
  font-size: 17px;
  line-height: 1.25;
}

#gk-section-{{ section.id }} .gkcn-stat span {
  font-size: 12px;
  color: #cfe8f7;
  line-height: 1.3;
  display: block;
  margin-top: 2px;
}

/* problem + compare */
#gk-section-{{ section.id }} .gkcn-problem {
  display: grid;
  gap: 28px;
  align-items: center;
}

#gk-section-{{ section.id }} .gkcn-compare {
  border: 1px solid var(--gkcn-line);
  border-radius: 20px;
  overflow: hidden;
  background: #fff;
}

#gk-section-{{ section.id }} .gkcn-compare table {
  width: 100%;
  border-collapse: collapse;
  font-size: 14.5px;
}

#gk-section-{{ section.id }} .gkcn-compare th,
#gk-section-{{ section.id }} .gkcn-compare td {
  padding: 14px 14px;
  text-align: left;
  border-bottom: 1px solid var(--gkcn-line);
  vertical-align: middle;
}

#gk-section-{{ section.id }} .gkcn-compare tr:last-child td {
  border-bottom: 0;
}

#gk-section-{{ section.id }} .gkcn-compare thead th {
  background: var(--gkcn-bg);
  font-size: 13px;
  color: var(--gkcn-mute);
  font-weight: 500;
}

#gk-section-{{ section.id }} .gkcn-compare thead th.gkcn-us {
  background: var(--gkcn-blue);
  color: #fff;
  font-weight: 700;
}

#gk-section-{{ section.id }} .gkcn-compare td.gkcn-us {
  background: #eef7fd;
  text-align: center;
}

#gk-section-{{ section.id }} .gkcn-compare td.gkcn-them,
#gk-section-{{ section.id }} .gkcn-compare th.gkcn-them {
  text-align: center;
}

#gk-section-{{ section.id }} .gkcn-yes,
#gk-section-{{ section.id }} .gkcn-no {
  display: inline-flex;
  width: 26px;
  height: 26px;
  border-radius: 50%;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 14px;
}

#gk-section-{{ section.id }} .gkcn-yes {
  background: var(--gkcn-green);
  color: #fff;
}

#gk-section-{{ section.id }} .gkcn-no {
  background: #fde4e2;
  color: #b3140a;
}

#gk-section-{{ section.id }} .gkcn-small {
  display: block;
  font-size: 12px;
  color: var(--gkcn-mute);
  margin-top: 4px;
}

/* benefits (feature cards) */
#gk-section-{{ section.id }} .gkcn-benefits {
  display: grid;
  gap: 14px;
  grid-template-columns: 1fr;
}

#gk-section-{{ section.id }} .gkcn-benefit {
  display: flex;
  gap: 16px;
  background: #fff;
  border: 1px solid var(--gkcn-line);
  border-radius: 18px;
  padding: 18px;
}

#gk-section-{{ section.id }} .gkcn-benefit i {
  flex: 0 0 46px;
  height: 46px;
  border-radius: 14px;
  background: #e6f5fd;
  display: flex;
  align-items: center;
  justify-content: center;
}

#gk-section-{{ section.id }} .gkcn-benefit svg {
  width: 24px;
  height: 24px;
  stroke: var(--gkcn-blue);
  fill: none;
  stroke-width: 1.8;
  stroke-linecap: round;
  stroke-linejoin: round;
}

#gk-section-{{ section.id }} .gkcn-benefit h3 {
  font-size: 16px;
  font-weight: 700;
  color: var(--gkcn-ink);
  line-height: 1.35;
}

#gk-section-{{ section.id }} .gkcn-benefit p {
  font-size: 14.5px;
  color: var(--gkcn-mute);
  margin-top: 4px;
}

/* steps */
#gk-section-{{ section.id }} .gkcn-steps {
  display: grid;
  gap: 16px;
  counter-reset: gkcnstep;
}

#gk-section-{{ section.id }} .gkcn-step {
  position: relative;
  background: #fff;
  border-radius: 20px;
  padding: 22px 20px 22px 76px;
  border: 1px solid var(--gkcn-line);
}

#gk-section-{{ section.id }} .gkcn-step::before {
  counter-increment: gkcnstep;
  content: counter(gkcnstep);
  position: absolute;
  left: 20px;
  top: 20px;
  width: 42px;
  height: 42px;
  border-radius: 50%;
  background: var(--gkcn-sky);
  color: #fff;
  font-weight: 700;
  font-size: 18px;
  display: flex;
  align-items: center;
  justify-content: center;
}

#gk-section-{{ section.id }} .gkcn-step h3 {
  font-size: 17px;
  font-weight: 700;
  color: var(--gkcn-blue);
}

#gk-section-{{ section.id }} .gkcn-step p {
  margin-top: 4px;
  font-size: 15px;
  color: var(--gkcn-mute);
}

/* reviews */
#gk-section-{{ section.id }} .gkcn-rv {
  position: relative;
  padding: 0 26px;
}

#gk-section-{{ section.id }} .gkcn-rv-view {
  overflow: hidden;
}

#gk-section-{{ section.id }} .gkcn-rv-track {
  --pv: 1;
  display: flex;
  gap: 14px;
  transition: transform .45s ease;
  will-change: transform;
}

#gk-section-{{ section.id }} .gkcn-rv-btn {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: #fff;
  border: 1px solid var(--gkcn-line);
  color: var(--gkcn-blue);
  font: 700 28px/1 "Gotham Rounded", system-ui, sans-serif;
  cursor: pointer;
  box-shadow: 0 4px 12px rgba(0,0,0,.12);
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 0 3px;
}

#gk-section-{{ section.id }} .gkcn-rv-btn:hover {
  background: #eaf4fb;
}

#gk-section-{{ section.id }} .gkcn-rv-btn:focus-visible {
  outline: 3px solid var(--gkcn-sky);
  outline-offset: 2px;
}

#gk-section-{{ section.id }} .gkcn-rv-prev {
  left: -14px;
}

#gk-section-{{ section.id }} .gkcn-rv-next {
  right: -14px;
}

#gk-section-{{ section.id }} .gkcn-review {
  flex: 0 0 calc((100% - 14px * (var(--pv) - 1)) / var(--pv));
  background: #fff;
  border: 1px solid var(--gkcn-line);
  border-radius: 18px;
  padding: 20px;
  display: flex;
  flex-direction: column;
}

#gk-section-{{ section.id }} .gkcn-stars {
  color: var(--gkcn-yellow);
  letter-spacing: 2px;
  font-size: 16px;
  line-height: 1;
}

#gk-section-{{ section.id }} .gkcn-review p {
  margin-top: 10px;
  font-size: 15px;
  flex: 1;
}

#gk-section-{{ section.id }} .gkcn-who {
  margin-top: 12px;
  font-size: 13px;
  font-weight: 700;
  color: var(--gkcn-blue);
}

#gk-section-{{ section.id }} .gkcn-who span {
  font-weight: 400;
  color: var(--gkcn-mute);
}

/* packages / products */
#gk-section-{{ section.id }} .gkcn-tabs {
  display: inline-flex;
  background: #e8eef4;
  border-radius: 999px;
  padding: 5px;
  margin-bottom: 22px;
}

#gk-section-{{ section.id }} .gkcn-tab {
  min-height: 44px;
  padding: 0 24px;
  border: 0;
  border-radius: 999px;
  background: transparent;
  font: 700 15px/1 "Gotham Rounded", system-ui, sans-serif;
  color: var(--gkcn-mute);
  cursor: pointer;
}

