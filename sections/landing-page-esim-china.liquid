{%- capture wa_badge -%}<span class="gkcn-hero-app"><img src="{{ hero_icon_wa_url }}" alt="WhatsApp" class="gkcn-hero-app-icon gkcn-hero-app-icon--wa" width="30" height="30" loading="eager"></span>{%- endcapture -%}
{%- capture ig_badge -%}<span class="gkcn-hero-app"><img src="{{ hero_icon_ig_url }}" alt="Instagram" class="gkcn-hero-app-icon gkcn-hero-app-icon--ig" width="30" height="30" loading="eager"></span>{%- endcapture -%}
{%- capture tt_badge -%}<span class="gkcn-hero-app"><img src="{{ hero_icon_tt_url }}" alt="TikTok" class="gkcn-hero-app-icon gkcn-hero-app-icon--tt" width="30" height="30" loading="eager"></span>{%- endcapture -%}
{%- capture gg_badge -%}<span class="gkcn-hero-app"><img src="{{ hero_icon_gg_url }}" alt="Google" class="gkcn-hero-app-icon gkcn-hero-app-icon--gg" width="30" height="30" loading="eager"></span>{%- endcapture -%}
{%- capture and_gg_badge -%}<br class="gkcn-hero-amp-br"><span class="gkcn-hero-amp-wrap"><span class="gkcn-hero-amp">&amp;</span>{{ gg_badge }}</span>{%- endcapture -%}

{%- assign hero_raw_title = section.settings.hero_title | default: 'Sampai China, WhatsApp Instagram TikTok & Google Langsung Jalan!' -%}
{%- assign show_hero_icons = section.settings.show_hero_app_icons -%}
{%- if show_hero_icons == nil -%}
  {%- assign show_hero_icons = true -%}
{%- endif -%}

{%- if show_hero_icons -%}
  {%- assign hero_clean_title = hero_raw_title
    | replace: '&amp;', '&'
    | replace: '&#38;', '&'
    | replace: '&#x26;', '&'
    | replace: '&nbsp;', ' '
  -%}
  {%- assign hero_rendered_title = hero_clean_title
    | replace: 'WhatsApp,', '##GK_WA##'
    | replace: 'Whatsapp,', '##GK_WA##'
    | replace: 'whatsapp,', '##GK_WA##'
    | replace: 'Instagram,', '##GK_IG##'
    | replace: 'instagram,', '##GK_IG##'
    | replace: 'TikTok,', '##GK_TT##'
    | replace: 'Tiktok,', '##GK_TT##'
    | replace: 'tiktok,', '##GK_TT##'
    | replace: 'WhatsApp', '##GK_WA##'
    | replace: 'Whatsapp', '##GK_WA##'
    | replace: 'whatsapp', '##GK_WA##'
    | replace: 'Instagram', '##GK_IG##'
    | replace: 'instagram', '##GK_IG##'
    | replace: 'TikTok', '##GK_TT##'
    | replace: 'Tiktok', '##GK_TT##'
    | replace: 'tiktok', '##GK_TT##'
    | replace: ' & Google', ' ##GK_AND_GG##'
    | replace: '& Google', '##GK_AND_GG##'
    | replace: ' & google', ' ##GK_AND_GG##'
    | replace: '& google', '##GK_AND_GG##'
    | replace: '&Google', '##GK_AND_GG##'
    | replace: '&google', '##GK_AND_GG##'
    | replace: ' dan Google', ' ##GK_AND_GG##'
    | replace: ' dan google', ' ##GK_AND_GG##'
    | replace: 'Google', '##GK_GG##'
    | replace: 'google', '##GK_GG##'
    | replace: '##GK_WA##', wa_badge
    | replace: '##GK_IG##', ig_badge
    | replace: '##GK_TT##', tt_badge
    | replace: '##GK_AND_GG##', and_gg_badge
    | replace: '##GK_GG##', gg_badge
  -%}
{%- else -%}
  {%- assign hero_rendered_title = hero_raw_title -%}
{%- endif -%}

<div class="gkcn" id="gk-section-{{ section.id }}">
  <!-- HERO -->
  <section class="gkcn-hero" id="gkcn-hero-{{ section.id }}">
    <div class="gkcn-wrap gkcn-hero-grid">
      <div class="gkcn-hero-text">
        <h1>{{ hero_rendered_title }}</h1>
        <p class="gkcn-hero-sub">{{ section.settings.hero_sub | default: 'Jangan sampai yang harusnya sibuk eksplor China, malah sibuk cari koneksi. Siapin eSIM sebelum terbang, biar liburan nggak pakai drama!' }}</p>
        <div class="gkcn-price">
          <small>Mulai dari</small>
          <strong>{{ section.settings.hero_price | default: 'Rp29.000' }}</strong>
        </div>
        <div class="gkcn-hero-cta">
          <a class="gkcn-btn gkcn-btn--main" href="{{ section.settings.hero_btn_url | default: '#gkcn-paket' }}">{{ section.settings.hero_btn_text | default: 'Lihat paket eSIM China' }}</a>
        </div>
      </div>
      <div class="gkcn-hero-media">
        <img src="{{ hero_img_url }}" alt="Traveler perempuan membuka peta di ponsel dengan latar Shanghai, ikon WhatsApp, Instagram, TikTok, dan Google melayang di sekitarnya" width="800" height="660" loading="eager">
      </div>
    </div>
  </section>

  <!-- STATS RIBBON -->
  <section class="gkcn-stats" aria-label="Pengalaman Global Komunika">
    <div class="gkcn-wrap gkcn-stats-wrap">
      <img
        class="gkcn-stats-mark"
        src="{{ stats_mark_url }}"
        alt=""
        aria-hidden="true"
        loading="eager"
        decoding="async"
        draggable="false"
        width="420"
        height="420"
      >
      <div class="gkcn-stats-grid">
        <div class="gkcn-stat">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3.2"/><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6"/><circle cx="17" cy="9" r="2.4"/><path d="M17 14c2.4 0 4 1.8 4 4.5"/></svg>
          <b>{{ section.settings.stat_1_val | default: '500.000+' }}</b>
          <span>{{ section.settings.stat_1_lbl | default: 'Dipercaya Traveler' }}</span>
        </div>
        <div class="gkcn-stat">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15" rx="3"/><path d="M8 3v4M16 3v4M3.5 10h17M9 15l2 2 4-4"/></svg>
          <b>{{ section.settings.stat_2_val | default: 'Sejak 2016' }}</b>
          <span>{{ section.settings.stat_2_lbl | default: 'Menemani traveler' }}</span>
        </div>
        <div class="gkcn-stat">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 14v-2a8 8 0 0 1 16 0v2"/><rect x="3" y="13" width="4" height="6" rx="1.5"/><rect x="17" y="13" width="4" height="6" rx="1.5"/><path d="M19 19c0 1.5-1.5 2-4 2"/></svg>
          <b>{{ section.settings.stat_3_val | default: 'Customer Support' }}</b>
          <span>{{ section.settings.stat_3_lbl | default: 'Siap bantu' }}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- PROBLEM + COMPARE -->
  <section class="gkcn-sec" id="gkcn-masalah">
    <div class="gkcn-wrap gkcn-problem">
