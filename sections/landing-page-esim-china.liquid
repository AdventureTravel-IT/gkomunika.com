<!-- STICKY CTA (mobile) – di luar wrapper agar position:fixed tidak terganggu overflow -->
<div class="gkcn-sticky" id="gkcn-sticky-{{ section.id }}" aria-hidden="true">
  <div class="gkcn-sticky-in">
    <div>
      <small>Mulai dari</small>
      <b>{{ section.settings.hero_price | default: 'Rp29.000' }}</b>
    </div>
    <a class="gkcn-btn gkcn-btn--main" href="#gkcn-paket" tabindex="-1">Lihat paket</a>
  </div>
</div>
<div class="gkcn-pad" aria-hidden="true"></div>

<script>
(function(){
  function initGK() {
    var root = document.getElementById('gk-section-{{ section.id }}');
    if (!root) return;
    var AUTOPLAY_MS = 3500;
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function carousel(wrap, autoplay) {
      var track = wrap.querySelector('.gkcn-rv-track, .gkcn-track');
      if (!track) return;
      var slides = track.children;
      if (!slides.length) return;
      var idx = 0, timer = null;

      function perView() { return window.innerWidth >= 760 ? 3 : 1; }
      function maxIdx() { return Math.max(0, slides.length - perView()); }
      function render() {
        var w = slides[0].offsetWidth;
        if (!w) return;
        var gap = parseFloat(getComputedStyle(track).gap) || 16;
        track.style.transform = 'translateX(' + (-idx * (w + gap)) + 'px)';
      }
      function go(i) {
        var m = maxIdx();
        idx = i > m ? 0 : (i < 0 ? m : i);
        render();
      }
      function start() {
        if (!autoplay || reduce || timer) return;
        timer = setInterval(function(){ go(idx + 1); }, AUTOPLAY_MS);
      }
      function stop() {
        if (timer) { clearInterval(timer); timer = null; }
      }

      var prevBtn = wrap.querySelector('.gkcn-rv-prev');
      var nextBtn = wrap.querySelector('.gkcn-rv-next');
      if (prevBtn) prevBtn.onclick = function() { go(idx - 1); };
      if (nextBtn) nextBtn.onclick = function() { go(idx + 1); };

      if (autoplay) {
        wrap.addEventListener('mouseenter', stop);
        wrap.addEventListener('mouseleave', start);
        wrap.addEventListener('touchstart', stop, {passive: true});
        wrap.addEventListener('touchend', function(){ setTimeout(start, 2500); }, {passive: true});
      }

      window.addEventListener('resize', function(){ go(Math.min(idx, maxIdx())); });
      wrap.gkcnReset = function(){ idx = 0; render(); };
      render();
      start();
    }

    var rv = root.querySelector('#gkcn-rv-{{ section.id }}');
    if (rv) carousel(rv, true);
    root.querySelectorAll('.gkcn-pk').forEach(function(p){ carousel(p, false); });

    var tabs = root.querySelectorAll('.gkcn-tab');
    tabs.forEach(function(tab){
      tab.onclick = function(){
        tabs.forEach(function(t){
          var on = (t === tab);
          t.setAttribute('aria-selected', on ? 'true' : 'false');
          var pane = root.querySelector('#' + t.getAttribute('aria-controls'));
          if (pane) {
            pane.hidden = !on;
            if (on && pane.gkcnReset) pane.gkcnReset();
          }
        });
      };
    });

    // Sticky CTA: tampil dari setelah Hero CTA sampai tiba di awal section "Udah Jadi Teman Traveling 500.000+ Orang!" (#gkcn-testimoni)
    var sticky = document.getElementById('gkcn-sticky-{{ section.id }}');
    var heroCta = root.querySelector('.gkcn-hero-cta') || root.querySelector('.gkcn-hero');
    var to = document.getElementById('gkcn-testimoni') || root.querySelector('#gkcn-testimoni');
    function updateSticky(){
      if (!sticky || !to) return;
      var heroBottom = heroCta ? heroCta.getBoundingClientRect().bottom : 0;
      var toTop = to.getBoundingClientRect().top;
      var pastHero = heroBottom <= 40;
      var beforeTestimoni = toTop > (window.innerHeight - 80);
      var show = pastHero && beforeTestimoni;
      sticky.classList.toggle('gkcn-on', show);
      sticky.setAttribute('aria-hidden', show ? 'false' : 'true');
      var a = sticky.querySelector('a');
      if (a) a.tabIndex = show ? 0 : -1;
    }
    if (sticky) {
      var stickyBtn = sticky.querySelector('a[href^="#"]');
      if (stickyBtn) {
        stickyBtn.addEventListener('click', function(e) {
          var targetId = this.getAttribute('href');
          var targetEl = targetId ? (root.querySelector(targetId) || document.querySelector(targetId)) : null;
          if (targetEl) {
            e.preventDefault();
            targetEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        });
      }
    }
    window.addEventListener('scroll', updateSticky, {passive: true});
    document.addEventListener('scroll', updateSticky, {passive: true});
    window.addEventListener('resize', updateSticky);
    window.addEventListener('orientationchange', updateSticky);
    setTimeout(updateSticky, 100);
    updateSticky();

    // Meta Pixel (671798165173716) Event Tracking
    var pixelId = '{{ section.settings.meta_pixel_id | default: "671798165173716" }}';
    if (typeof window.fbq === 'function') {
      window.fbq('init', pixelId);
    }

    // Tracking klik tombol "Pilih paket" -> ViewContent
    root.querySelectorAll('.gkcn-card .gkcn-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var card = btn.closest('.gkcn-card');
        var title = card && card.querySelector('h3') ? card.querySelector('h3').textContent.trim() : 'Paket eSIM China';
        var tag = card && card.querySelector('.gkcn-tag') ? card.querySelector('.gkcn-tag').textContent.trim() : 'eSIM';
        if (typeof window.fbq === 'function') {
          window.fbq('track', 'ViewContent', {
            content_name: title,
            content_category: tag
          });
        }
      });
    });

    // Tracking klik tombol WhatsApp -> Contact
    root.querySelectorAll('a[href*="wa.me"]').forEach(function(waBtn) {
      waBtn.addEventListener('click', function() {
        if (typeof window.fbq === 'function') {
          window.fbq('track', 'Contact', {
            content_name: 'WhatsApp Support',
            content_category: 'eSIM China'
          });
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGK);
  } else {
    initGK();
  }
  document.addEventListener('shopify:section:load', function(e){
    initGK();
  });
  document.addEventListener('shopify:section:select', function(e){
    initGK();
  });
})();
</script>

