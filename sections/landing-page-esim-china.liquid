/* sticky */
#gk-section-{{ section.id }} .gkcn-sticky,
.gkcn-sticky,
#gkcn-sticky-{{ section.id }} {
  --gkcn-blue: {{ section.settings.brand_blue | default: '#005496' }};
  --gkcn-sky: {{ section.settings.brand_sky | default: '#00ADEE' }};
  --gkcn-ink: #222222;
  --gkcn-mute: #5b6670;
  --gkcn-bg: #F5F8FB;
  --gkcn-line: #dfe6ec;
  font-family: "Gotham Rounded", system-ui, -apple-system, "Segoe UI", Arial, sans-serif;
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 998;
  padding: 10px 16px calc(10px + env(safe-area-inset-bottom, 0px));
  background: rgba(255, 255, 255, 0.96);
  border-top: 1px solid var(--gkcn-line, #dfe6ec);
  box-shadow: 0 -6px 20px rgba(0, 0, 0, 0.08);
  transform: translateY(110%);
  visibility: hidden;
  transition: transform 0.3s ease, visibility 0.3s ease;
  pointer-events: none;
  box-sizing: border-box;
}

.gkcn-sticky *,
.gkcn-sticky *::before,
.gkcn-sticky *::after,
#gkcn-sticky-{{ section.id }} *,
#gkcn-sticky-{{ section.id }} *::before,
#gkcn-sticky-{{ section.id }} *::after {
  box-sizing: border-box;
}

#gk-section-{{ section.id }} .gkcn-sticky.gkcn-on,
.gkcn-sticky.gkcn-on,
#gkcn-sticky-{{ section.id }}.gkcn-on {
  transform: translateY(0);
  visibility: visible;
  pointer-events: auto;
}

#gk-section-{{ section.id }} .gkcn-sticky-in,
.gkcn-sticky-in,
#gkcn-sticky-{{ section.id }} .gkcn-sticky-in {
  max-width: 1080px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

#gk-section-{{ section.id }} .gkcn-sticky small,
.gkcn-sticky small,
#gkcn-sticky-{{ section.id }} small {
  display: block;
  font-size: 12px;
  color: var(--gkcn-mute, #5b6670);
  line-height: 1.2;
}

#gk-section-{{ section.id }} .gkcn-sticky b,
.gkcn-sticky b,
#gkcn-sticky-{{ section.id }} b {
  font-size: 20px;
  line-height: 1.2;
  color: var(--gkcn-ink, #222222);
}

#gk-section-{{ section.id }} .gkcn-sticky .gkcn-btn,
.gkcn-sticky .gkcn-btn,
#gkcn-sticky-{{ section.id }} .gkcn-btn {
