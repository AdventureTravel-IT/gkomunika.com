          {%- if section.settings.packages_lead != blank -%}
            <p class="gkmy-lead">{{ section.settings.packages_lead }}</p>
          {%- elsif 'Cek harga eSIM Malaysia dan pilih paket data sesuai durasi perjalanan serta kebutuhan internet kamu' != '' -%}
            <p class="gkmy-lead">Cek harga eSIM Malaysia dan pilih paket data sesuai durasi perjalanan serta kebutuhan internet kamu</p>
          {%- endif -%}
        </div>
        <div class="gkmy-ctrls" data-gkmy-for="gkmy-track-c" aria-label="Navigasi paket">
          <button class="gkmy-arrow" type="button" data-gkmy-dir="-1" aria-label="Geser ke kiri" disabled>
            <svg class="gkmy-i" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href="#gkmy-i-al"/></svg>
          </button>
          <button class="gkmy-arrow" type="button" data-gkmy-dir="1" aria-label="Geser ke kanan">
