{% comment %}
  Shopify Section for Global Komunika eSIM Malaysia Landing Page.
  Converted dynamically from eSIM_Malaysia_Global_Komunika.html with full Theme Customizer support.
{% endcomment %}

{%- assign hero_img_url = section.settings.hero_image_url -%}
{%- if section.settings.hero_image != blank -%}
  {%- assign hero_img_url = section.settings.hero_image | image_url: width: 1400 -%}
{%- elsif hero_img_url == blank -%}
  {%- assign hero_img_url = 'https://cdn.shopify.com/s/files/1/0735/4204/1817/files/LP_MALAYSIA.png?v=1794971940' -%}
{%- endif -%}

{%- assign wa_number = section.settings.whatsapp_number | default: '628156080055' -%}
{%- assign wa_text = section.settings.whatsapp_text | default: 'Halo Global Komunika, saya ingin tanya seputar eSIM Malaysia' | url_encode -%}

<style>
@font-face{font-family:"Gotham";font-weight:400;font-style:normal;font-display:swap;src:url("https://cdn.shopify.com/s/files/1/0735/4204/1817/files/Gotham-Book.otf?v=1794546841") format("opentype");}
@font-face{font-family:"Gotham";font-weight:700;font-style:normal;font-display:swap;src:url("https://cdn.shopify.com/s/files/1/0735/4204/1817/files/Gotham-Bold.otf?v=1794546841") format("opentype");}



html,body{margin:0;padding:0;background:#fff}


#gk-section-{{ section.id }}.gkmy-page,
#gk-section-{{ section.id }} {
  --gkmy-blue: {{ section.settings.brand_blue | default: '#005496' }};
  --gkmy-cyan: {{ section.settings.brand_sky | default: '#00ADEE' }};
  --gkmy-ink: #222222;
  --gkmy-text: #2B2F33;
  --gkmy-muted: #5A6570;
  --gkmy-mist: #F4F7FA;
  --gkmy-tint: #CCEFFC;
  --gkmy-tint2: #E3F6FD;
  --gkmy-line: #DDE4EA;
  --gkmy-green: #2E884A;
  --gkmy-star: #FBB526;
  box-sizing: border-box;
  color-scheme: light;
  position: relative;
  background: #fff;
  color: var(--gkmy-text);
  font-family: "Gotham", "Gotham Rounded", "Montserrat", Arial, Helvetica, sans-serif;
  font-weight: 400;
  font-size: 16px;
  line-height: 1.6;
  -webkit-text-size-adjust: 100%;
  overflow-x: hidden;
  width: 100%;
}
#MainContent:has(#gk-section-{{ section.id }}) {
  max-width: 100% !important;
  padding-left: 0 !important;
  padding-right: 0 !important;
}

.gkmy-page *,.gkmy-page *::before,.gkmy-page *::after{box-sizing:border-box}
:where(.gkmy-page) :is(h1,h2,h3,p,ul,ol,li,blockquote,small,figure){margin:0;padding:0}
:where(.gkmy-page) :is(ul,ol){list-style:none}
:where(.gkmy-page) a{color:inherit}
.gkmy-page button{font-family:inherit}
.gkmy-page :focus-visible{outline:3px solid var(--gkmy-cyan);outline-offset:3px;border-radius:6px}
.gkmy-sr{position:absolute;width:1px;height:1px;margin:-1px;padding:0;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
.gkmy-i{display:block;width:100%;height:100%}
.gkmy-wrap{width:100%;max-width:1120px;margin:0 auto;padding:0 32px}
.gkmy-sec{padding:72px 0 80px}
.gkmy-sec--mist{background:var(--gkmy-mist)}
.gkmy-h2{font-size:30px;line-height:1.25;font-weight:700;letter-spacing:-.01em;color:var(--gkmy-blue);max-width:760px}
.gkmy-lead{margin-top:12px;color:var(--gkmy-muted);max-width:640px}
.gkmy-btn{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:12px 28px;border-radius:999px;background:var(--gkmy-blue);color:#fff;font-family:inherit;font-weight:700;font-size:16px;line-height:1.2;text-decoration:none;border:2px solid var(--gkmy-blue);white-space:nowrap;cursor:pointer;transition:background .2s,border-color .2s}
.gkmy-btn:hover{background:#003F73;border-color:#003F73}
.gkmy-btn--light{background:#fff;color:var(--gkmy-blue);border-color:#fff}
.gkmy-btn--light:hover{background:var(--gkmy-tint2);border-color:var(--gkmy-tint2)}
.gkmy-tag{display:inline-block;font-weight:700;font-size:15px;line-height:1.45;color:#fff;background:var(--gkmy-blue);border-radius:8px;padding:1px 10px;white-space:nowrap}
.gkmy-tag-s{background:#8A97A3}
@media (prefers-reduced-motion:no-preference){.gkmy-page{scroll-behavior:smooth}}

/* ===== HERO ===== */
.gkmy-hero{position:relative;height:440px;overflow:hidden;background:linear-gradient(180deg,#00487F 0%,#0A6BB0 38%,#2F9BD6 68%,#8FCBEA 88%,#fff 100%);color:#fff}
.gkmy-hero-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:0}
.gkmy-hero-img[src=""]{display:none}
.gkmy-hero::before{content:"";position:absolute;inset:0;z-index:1;background:linear-gradient(90deg,rgba(0,35,75,.52) 0%,rgba(0,35,75,.3) 42%,rgba(0,35,75,0) 72%),linear-gradient(180deg,rgba(0,40,80,.34) 0%,rgba(0,40,80,.12) 70%,rgba(0,40,80,0) 100%)}
.gkmy-hero::after{content:"";position:absolute;left:0;right:0;bottom:0;height:150px;z-index:1;background:linear-gradient(180deg,rgba(255,255,255,0) 0%,#fff 92%)}
.gkmy-hero-in{position:relative;z-index:2;max-width:1120px;margin:0 auto;padding:0 32px;height:100%}
.gkmy-hero-top{display:flex;justify-content:flex-end;padding-top:28px}
.gkmy-compat{display:inline-flex;align-items:center;gap:8px;min-height:44px;padding:10px 20px;border-radius:999px;background:#FBB526;color:#003F73;font-weight:700;font-size:15px;line-height:1.2;text-decoration:none;white-space:nowrap;box-shadow:0 6px 18px rgba(0,30,70,.25)}
.gkmy-compat .gkmy-i{width:18px;height:18px;flex:0 0 18px;color:#003F73}
.gkmy-cmp-m{display:none}
.gkmy-hero-row{display:flex;justify-content:space-between;align-items:flex-end;gap:24px;margin-top:84px}
.gkmy-h1{font-weight:700;line-height:1.1;letter-spacing:-.01em;color:#fff;text-shadow:0 2px 14px rgba(0,30,70,.45)}
.gkmy-hl{text-shadow:none}
.gkmy-h1-big{display:flex;align-items:center;gap:14px;font-size:48px}
.gkmy-hl{display:inline-block;background:#FBB526;color:var(--gkmy-blue);border-radius:12px;padding:0 14px 4px}
.gkmy-h1-sub{display:block;margin-top:14px;font-weight:400;font-size:22px;line-height:1.35;max-width:700px;color:#fff}
.gkmy-chips{display:flex;gap:10px;flex-wrap:wrap;justify-content:flex-end;max-width:420px;padding-bottom:6px}
.gkmy-chip{display:inline-flex;align-items:center;gap:8px;background:#fff;color:var(--gkmy-ink);border-radius:999px;padding:8px 16px;font-weight:700;font-size:15px;line-height:1.3;box-shadow:0 4px 14px rgba(0,30,70,.18)}
.gkmy-chip .gkmy-i{width:18px;height:18px;flex:0 0 18px;color:var(--gkmy-blue)}
.gkmy-intro{max-width:1120px;margin:0 auto;padding:8px 32px 8px}
.gkmy-intro-p{max-width:680px}
.gkmy-cta-row{display:flex;align-items:center;gap:20px;margin-top:24px;flex-wrap:wrap}
.gkmy-cta-row .gkmy-btn{min-height:52px;padding:12px 28px}
.gkmy-note{display:flex;align-items:center;gap:10px;font-size:14px;color:var(--gkmy-muted)}
.gkmy-note span.gkmy-ni{width:24px;height:24px;border-radius:50%;background:var(--gkmy-green);color:#fff;display:grid;place-items:center;flex:0 0 24px}
.gkmy-note span.gkmy-ni .gkmy-i{width:13px;height:13px}

/* ===== PAKET ===== */
.gkmy-head-row{display:flex;justify-content:space-between;align-items:flex-end;gap:24px}
.gkmy-arrows{display:flex;gap:10px;flex:0 0 auto}
.gkmy-arrow{width:48px;height:48px;border-radius:50%;border:2px solid var(--gkmy-blue);background:#fff;color:var(--gkmy-blue);display:grid;place-items:center;cursor:pointer;padding:0;transition:background .2s,color .2s,opacity .2s}
.gkmy-arrow .gkmy-i{width:20px;height:20px}
.gkmy-arrow:hover:not(:disabled){background:var(--gkmy-blue);color:#fff}
.gkmy-arrow:disabled{opacity:.35;cursor:default}
.gkmy-arrows.is-static{display:none}
.gkmy-track{display:flex;gap:20px;overflow-x:auto;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;scrollbar-width:none;margin-top:36px;padding:4px 0 10px}
.gkmy-track::-webkit-scrollbar{display:none}
.gkmy-track>*{scroll-snap-align:start}
.gkmy-track-pk>*{flex:0 0 480px}
.gkmy-card{background:#fff;border:1px solid var(--gkmy-line);border-radius:24px;padding:24px 28px;display:flex;flex-direction:column;gap:14px}
.gkmy-c-head{display:flex;align-items:center;gap:16px;min-height:113px;padding-bottom:16px;border-bottom:1px solid var(--gkmy-line)}
.gkmy-ft{display:block;width:60px;height:60px;border-radius:14px;overflow:hidden;border:1px solid rgba(0,0,0,.12);background:#fff;flex:0 0 auto}
.gkmy-fl{display:block;width:100%;height:100%}
.gkmy-fg{display:grid;grid-template-columns:repeat(2,28px);grid-auto-rows:28px;gap:4px;width:60px;min-height:60px;align-content:center;flex:0 0 60px}
.gkmy-fg .gkmy-ft{width:28px;height:28px;border-radius:8px}
.gkmy-ft-more{display:grid;place-items:center;background:#E8F0F7;border-color:#D3E0EB;color:var(--gkmy-blue);font-weight:700;font-size:13px;line-height:1}
.gkmy-c-title{display:flex;align-items:center;flex-wrap:wrap;gap:4px 10px;font-size:22px;line-height:1.3;font-weight:700;color:var(--gkmy-blue)}
.gkmy-cover{display:flex;align-items:center;gap:10px;font-size:18px;line-height:1.3;color:var(--gkmy-ink)}
.gkmy-cover .gkmy-i{width:22px;height:22px;flex:0 0 22px;color:var(--gkmy-blue)}
.gkmy-cover b{font-weight:700}
.gkmy-c-foot{margin-top:auto;display:flex;justify-content:space-between;align-items:center;gap:16px;border-top:1px solid var(--gkmy-line);padding-top:16px}
.gkmy-price small{display:block;font-size:14px;color:var(--gkmy-muted);line-height:1.2}
.gkmy-price b{display:block;font-size:28px;line-height:1.15;color:var(--gkmy-ink);font-weight:700}
.gkmy-gsim{margin-top:64px;display:grid;grid-template-columns:480px 480px;gap:20px;align-items:stretch}
.gkmy-gmsg{display:flex;flex-direction:column}
.gkmy-gh{font-size:28px;line-height:1.3;font-weight:700;color:var(--gkmy-blue);max-width:480px}
.gkmy-gpts{margin-top:24px;display:flex;flex-direction:column;gap:14px}
.gkmy-gpts li{display:flex;align-items:center;gap:14px;min-height:48px;font-weight:700;font-size:17px;line-height:1.35;color:var(--gkmy-blue)}
.gkmy-gpts li span{flex:0 0 48px;width:48px;height:48px;border-radius:50%;background:var(--gkmy-tint);color:var(--gkmy-blue);display:grid;place-items:center}
.gkmy-gpts li span .gkmy-i{width:24px;height:24px}
.gkmy-gsim .gkmy-card{width:100%}
@media (max-width:1100px){.gkmy-gsim{grid-template-columns:1fr;gap:28px}.gkmy-gsim .gkmy-card{max-width:480px}}

/* ===== BANDING ===== */
.gkmy-seg{display:none}
.gkmy-vs-grid{margin-top:40px;display:grid;grid-template-columns:1fr 1fr;column-gap:20px;align-items:start}
.gkmy-vs-esim{background:var(--gkmy-tint2);border-radius:24px;padding-bottom:10px}
.gkmy-vs-h{display:flex;align-items:center;min-height:64px;padding:22px 28px 6px}
.gkmy-vs-col li{display:flex;align-items:center;gap:16px;min-height:96px;padding:14px 28px}
.gkmy-ic{flex:0 0 44px;width:44px;height:44px;border-radius:50%;display:grid;place-items:center}
.gkmy-ic .gkmy-i{width:22px;height:22px}
.gkmy-vs-esim .gkmy-ic{background:var(--gkmy-blue);color:#fff}
.gkmy-vs-sim .gkmy-ic{background:#EEF2F5;color:#8A97A3}
.gkmy-vs-sim li{border-bottom:1px solid #E3E9EE}
.gkmy-vs-sim li:last-child{border-bottom:0}
.gkmy-vs-col small{display:block;font-size:14px;line-height:1.3;color:var(--gkmy-muted)}
.gkmy-vs-esim b{display:block;font-size:17px;line-height:1.35;color:var(--gkmy-blue);font-weight:700}
.gkmy-val{display:block;font-size:17px;line-height:1.35;color:var(--gkmy-muted)}

/* ===== CEK HP ===== */
.gkmy-hp-list{margin-top:36px;display:flex;flex-direction:column;gap:16px}
.gkmy-hp{background:#fff;border:1px solid var(--gkmy-line);border-radius:24px;padding:24px 32px;display:grid;grid-template-columns:240px 1fr;gap:32px;align-items:center;min-height:113px}
.gkmy-hp-who{display:flex;align-items:center;gap:14px}
.gkmy-ico{flex:0 0 52px;width:52px;height:52px;border-radius:50%;background:var(--gkmy-tint);color:var(--gkmy-blue);display:grid;place-items:center}
.gkmy-ico .gkmy-i{width:26px;height:26px}
.gkmy-hp-t{font-size:22px;line-height:1.3;color:var(--gkmy-blue);font-weight:700}
.gkmy-hp-how{border-left:1px solid var(--gkmy-line);padding-left:32px;display:flex;flex-direction:column;gap:10px;justify-content:center}
.gkmy-path{font-weight:700;font-size:17px;line-height:1.5;color:var(--gkmy-ink)}
.gkmy-pt{white-space:nowrap}
.gkmy-pt-last{color:var(--gkmy-blue)}
.gkmy-sep{display:inline-block;width:7px;height:7px;border-right:2px solid #8A97A3;border-top:2px solid #8A97A3;transform:rotate(45deg);margin:0 11px 1px 7px}
.gkmy-res{display:flex;gap:12px;align-items:flex-start}
.gkmy-res-i{flex:0 0 26px;width:26px;height:26px;border-radius:50%;background:var(--gkmy-green);color:#fff;display:grid;place-items:center;margin-top:1px}
.gkmy-res-i .gkmy-i{width:14px;height:14px}

/* ===== AKTIVASI ===== */
.gkmy-act{margin-top:40px;display:grid;grid-template-columns:repeat(3,1fr);gap:20px;align-items:stretch}
.gkmy-act-c{background:var(--gkmy-mist);border-radius:24px;padding:28px;display:flex;flex-direction:column;gap:18px;position:relative}
.gkmy-act-top{display:flex;flex-direction:column;gap:16px}
.gkmy-num{width:48px;height:48px;border-radius:50%;background:var(--gkmy-blue);color:#fff;display:grid;place-items:center;font-weight:700;font-size:20px}
.gkmy-act-done .gkmy-num{background:var(--gkmy-green)}
.gkmy-act-t{font-size:22px;line-height:1.3;color:var(--gkmy-blue);font-weight:700;min-height:58px}
.gkmy-act-p{color:#4A545E}
.gkmy-act-c:not(:last-child)::after{content:"";position:absolute;top:52px;left:88px;right:-20px;height:2px;background:repeating-linear-gradient(90deg,#B8C4CE 0 6px,transparent 6px 12px)}

/* ===== MENGAPA ===== */
.gkmy-sec--blue{background:var(--gkmy-blue);color:#fff;padding:88px 0 96px}
.gkmy-sec--blue .gkmy-h2{color:#fff;font-size:32px;max-width:none}
.gkmy-why{margin-top:40px;display:grid;grid-template-columns:repeat(3,1fr);background:rgba(255,255,255,.09);border:1px solid rgba(255,255,255,.18);border-radius:28px;padding:40px 0}
.gkmy-why-c{display:flex;flex-direction:column;align-items:flex-start;gap:20px;padding:0 36px}
.gkmy-why-c+.gkmy-why-c{border-left:1px solid rgba(255,255,255,.22)}
.gkmy-badge{display:inline-grid;place-items:center;min-height:48px;padding:0 24px;border-radius:14px;background:#fff;color:var(--gkmy-blue);font-size:22px;line-height:1;font-weight:700;white-space:nowrap}
.gkmy-why-t{font-size:20px;line-height:1.35;font-weight:700;color:#fff;min-height:54px}
.gkmy-why-p{margin-top:-8px;color:#DCEBF7}

/* ===== TESTIMONI ===== */
.gkmy-track-rv>*{flex:0 0 380px}
.gkmy-rev{background:var(--gkmy-mist);border-radius:24px;padding:26px 26px 24px;display:flex;flex-direction:column;gap:14px}
.gkmy-stars{display:flex;gap:3px}
.gkmy-stars .gkmy-i{width:20px;height:20px;color:var(--gkmy-star)}
.gkmy-q{margin:0;color:var(--gkmy-text)}
.gkmy-rev-who{margin-top:auto;padding-top:16px;border-top:1px solid var(--gkmy-line)}
.gkmy-rev-who b{display:block;font-weight:700;color:var(--gkmy-ink)}
.gkmy-rev-who span{font-size:14px;color:var(--gkmy-muted)}
.gkmy-rv-ctrl{display:flex;gap:10px;margin-top:20px}

/* ===== FAQ ===== */
.gkmy-faq{margin-top:32px;display:flex;flex-direction:column;gap:12px;max-width:820px}
.gkmy-faq-i{background:#fff;border-radius:16px;border:1px solid var(--gkmy-line)}
.gkmy-faq-i[open]{border-color:var(--gkmy-blue)}
.gkmy-faq-s{list-style:none;cursor:pointer;display:flex;align-items:center;justify-content:space-between;gap:16px;min-height:56px;padding:14px 20px}
.gkmy-faq-s::-webkit-details-marker{display:none}
.gkmy-faq-s::after{content:"";flex:0 0 12px;width:12px;height:12px;border-right:2px solid var(--gkmy-blue);border-bottom:2px solid var(--gkmy-blue);transform:rotate(45deg);transition:transform .2s;margin-top:-4px}
.gkmy-faq-i[open] .gkmy-faq-s::after{transform:rotate(-135deg);margin-top:4px}
.gkmy-faq-q{font-size:16px;line-height:1.4;font-weight:700;color:var(--gkmy-ink)}
.gkmy-faq-a{padding:0 20px 20px;color:var(--gkmy-muted)}
.gkmy-faq-p+.gkmy-faq-p{margin-top:10px}
.gkmy-faq-ol{margin-top:10px;display:flex;flex-direction:column;gap:6px;list-style:decimal;padding-left:20px}
.gkmy-faq-ol li{display:list-item}
.gkmy-link{color:var(--gkmy-blue);font-weight:700}

/* ===== CTA AKHIR ===== */
.gkmy-final{background:var(--gkmy-blue);color:#fff;padding:88px 0;position:relative;overflow:hidden}
.gkmy-final::before{content:"";position:absolute;right:-120px;top:-120px;width:360px;height:360px;border-radius:50%;background:linear-gradient(45deg,#005496 0%,#00ADEE 100%);opacity:.55}
.gkmy-final .gkmy-wrap{position:relative}
.gkmy-final .gkmy-h2{color:#fff;font-size:34px;max-width:640px}
.gkmy-final-p{margin-top:14px;color:#DCEBF7;max-width:560px}
.gkmy-final .gkmy-btn{margin-top:28px}

/* ===== MOBILE ===== */
@media (max-width:767px){
  .gkmy-wrap{padding:0 20px}
  .gkmy-sec{padding:48px 0 56px}
  .gkmy-h2{font-size:24px}
  .gkmy-hero{height:470px}
  .gkmy-hero::before{background:linear-gradient(180deg,rgba(0,35,75,.62) 0%,rgba(0,35,75,.52) 58%,rgba(0,35,75,0) 92%)}
  .gkmy-hero-in{padding:0 20px}
  .gkmy-hero-top{padding-top:20px}
  .gkmy-compat{padding:8px 14px;font-size:14px}
  .gkmy-cmp-d{display:none}.gkmy-cmp-m{display:inline}
  .gkmy-hero-row{flex-direction:column;align-items:flex-start;gap:16px;margin-top:64px}
  .gkmy-h1-big{font-size:32px;gap:10px}
  .gkmy-hl{padding:0 10px 3px;border-radius:10px}
  .gkmy-h1-sub{font-size:18px;margin-top:10px}
  .gkmy-chips{justify-content:flex-start;max-width:none;padding-bottom:0}
  .gkmy-chip{font-size:14px;padding:7px 12px}
  .gkmy-intro{padding:4px 20px 0}
  .gkmy-cta-row .gkmy-btn{width:100%}
  .gkmy-head-row{flex-direction:column;align-items:flex-start;gap:20px}
  .gkmy-track{margin:28px -20px 0;padding:4px 20px 10px;gap:14px;scroll-padding:0 20px}
  .gkmy-track-pk>*{flex:0 0 min(340px,calc(100vw - 40px))}
  .gkmy-card{padding:20px}
  .gkmy-c-title{font-size:18px}
  .gkmy-price b{font-size:24px}
  .gkmy-c-foot .gkmy-btn{padding:12px 14px;font-size:15px}
  .gkmy-c-foot{gap:10px}
  .gkmy-gsim{margin-top:44px;grid-template-columns:1fr;gap:24px}
  .gkmy-gmsg{width:min(340px,calc(100vw - 40px))}
  .gkmy-gsim .gkmy-card{width:min(340px,calc(100vw - 40px))}
  .gkmy-gh{font-size:22px}
  .gkmy-gpts{margin-top:20px;gap:12px}
  .gkmy-gpts li{font-size:16px;gap:12px}
  .gkmy-gpts li span{flex:0 0 44px;width:44px;height:44px}
  .gkmy-seg{display:flex;margin-top:28px;background:var(--gkmy-mist);border-radius:999px;padding:4px;gap:4px}
  .gkmy-seg-b{flex:1;display:grid;place-items:center;min-height:48px;border:0;border-radius:999px;background:transparent;font-weight:700;font-size:16px;color:var(--gkmy-muted);cursor:pointer}
  .gkmy-seg-b[data-gkmy-tab="esim"].is-on{background:var(--gkmy-blue);color:#fff}
  .gkmy-seg-b[data-gkmy-tab="sim"].is-on{background:#8A97A3;color:#fff}
  .gkmy-vs-grid{display:block;margin-top:8px}
  .gkmy-vs-esim{background:none;border-radius:0;padding-bottom:0}
  .gkmy-vs-h{display:none}
  .gkmy-vs[data-active="esim"] .gkmy-vs-sim{display:none}
  .gkmy-vs[data-active="sim"] .gkmy-vs-esim{display:none}
  .gkmy-vs-col li{min-height:0;padding:16px 0;border-bottom:1px solid #E3E9EE}
  .gkmy-vs-col li:last-child{border-bottom:0}
  .gkmy-vs-esim .gkmy-ic{background:var(--gkmy-tint);color:var(--gkmy-blue)}
  .gkmy-val{color:var(--gkmy-text)}
  .gkmy-hp-list{margin-top:28px;gap:12px}
  .gkmy-hp{grid-template-columns:1fr;gap:14px;padding:20px;border-radius:22px;min-height:0;align-items:start}
  .gkmy-ico{flex:0 0 44px;width:44px;height:44px}.gkmy-ico .gkmy-i{width:22px;height:22px}
  .gkmy-hp-t{font-size:20px}
  .gkmy-hp-how{border-left:0;padding-left:0}
  .gkmy-path{font-size:16px}
  .gkmy-act{grid-template-columns:1fr;gap:12px;margin-top:28px}
  .gkmy-act-c{padding:22px;gap:14px;border-radius:22px}
  .gkmy-act-top{flex-direction:row;align-items:center;gap:14px}
  .gkmy-num{flex:0 0 44px;width:44px;height:44px;font-size:18px}
  .gkmy-act-t{font-size:19px;min-height:0}
  .gkmy-act-c:not(:last-child)::after{display:none}
  .gkmy-sec--blue{padding:56px 0 60px}
  .gkmy-sec--blue .gkmy-h2{font-size:26px}
  .gkmy-why{display:flex;flex-direction:column;gap:12px;margin-top:26px;background:none;border:0;padding:0}
  .gkmy-why-c{background:rgba(255,255,255,.09);border:1px solid rgba(255,255,255,.18);border-radius:20px;padding:20px;gap:14px}
  .gkmy-why-c+.gkmy-why-c{border-left:1px solid rgba(255,255,255,.18)}
  .gkmy-badge{min-height:40px;padding:0 18px;border-radius:12px;font-size:20px}
  .gkmy-why-t{font-size:19px;min-height:0}
  .gkmy-why-p{margin-top:-4px}
  .gkmy-track-rv>*{flex:0 0 min(340px,calc(100vw - 56px))}
  .gkmy-faq{margin-top:24px}
  .gkmy-final{padding:56px 0}
  .gkmy-final .gkmy-h2{font-size:26px}
  .gkmy-final .gkmy-btn{width:100%}
}
@media (max-width:1000px) and (min-width:768px){
  .gkmy-act{grid-template-columns:1fr}
  .gkmy-act-c:not(:last-child)::after{display:none}
  .gkmy-act-t{min-height:0}
  .gkmy-why{grid-template-columns:1fr;padding:12px 0}
  .gkmy-why-c{padding:24px 36px}
  .gkmy-why-c+.gkmy-why-c{border-left:0;border-top:1px solid rgba(255,255,255,.22)}
  .gkmy-hp{grid-template-columns:200px 1fr}
}
@media (max-width:340px){.gkmy-c-foot{flex-wrap:wrap}.gkmy-c-foot .gkmy-btn{width:100%}}
@media (max-width:380px){.gkmy-price b{font-size:21px}.gkmy-c-foot .gkmy-btn{padding:12px 12px;font-size:14px}}
@media (prefers-reduced-motion:reduce){.gkmy-page *{transition:none !important}}

.gkmy-alt{margin-top:16px;background:#fff;border:1px solid var(--gkmy-line);border-radius:24px;padding:28px 32px}
.gkmy-alt-t{font-size:20px;line-height:1.3;font-weight:700;color:var(--gkmy-blue)}
.gkmy-alt-p{margin-top:10px;color:var(--gkmy-muted);max-width:760px}
.gkmy-alt .gkmy-btn{margin-top:20px}
@media (max-width:767px){.gkmy-alt{padding:20px;border-radius:22px;margin-top:12px}.gkmy-alt-t{font-size:18px}.gkmy-alt .gkmy-btn{width:100%;white-space:normal;text-align:center}}
.gkmy-hero-img{object-position:50% 28%}
.gkmy-ft-globe{display:grid;place-items:center;background:var(--gkmy-tint2);color:var(--gkmy-blue);border-color:#CFE3F1}
.gkmy-ft-globe .gkmy-i{width:34px;height:34px}
.gkmy-fg .gkmy-ft-globe .gkmy-i{width:18px;height:18px}
</style>

