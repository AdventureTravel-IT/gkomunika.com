  <!-- ===== HERO ===== -->
  <section class="gkmy-hero-wrap" id="gkmy-hero">
    <div class="gkmy-hero">
      <img
        class="gkmy-hero-img"
        src="{{ hero_img_url }}"
        alt="eSIM Malaysia Global Komunika"
        width="1440"
        height="440"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      >
      <div class="gkmy-hero-in">
        <div class="gkmy-hero-top">
          <a class="gkmy-compat" href="{{ section.settings.hero_compat_url | default: '#gkmy-cek-hp' }}">
            <svg class="gkmy-i" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href="#gkmy-i-info"/></svg>
            <span>{{ section.settings.hero_compat_text | default: 'Cek HP Support eSIM' }}</span>
          </a>
        </div>
        <div class="gkmy-hero-body">
          {%- if section.settings.hero_title != blank -%}
            <h1 class="gkmy-h1">{{ section.settings.hero_title }}</h1>
          {%- else -%}
            <h1 class="gkmy-h1"><span class="gkmy-h1-big"><span class="gkmy-hl">eSIM</span> <span>Malaysia<span class="gkmy-sr">,</span></span></span>
          <span class="gkmy-h1-sub">Internet Praktis untuk Traveling Tanpa Ganti SIM Card</span></h1>
          {%- endif -%}
          {%- if section.settings.hero_sub != blank -%}
            <p class="gkmy-hero-lead">{{ section.settings.hero_sub }}</p>
          {%- else -%}
            <p class="gkmy-hero-lead">Liburan ke Malaysia lebih tenang dengan eSIM dari Global Komunika. QR Code dikirim ke email, langsung aktif saat tiba di KLIA atau bandara lainnya di Malaysia, dan nomor WhatsApp Indonesia tetap aktif.</p>
          {%- endif -%}
          <div class="gkmy-hero-foot">
            <div class="gkmy-hero-price">
              <span class="gkmy-hero-price-lbl">Mulai dari</span>
              <b>{{ section.settings.hero_price | default: 'Rp39.000' }}</b>
            </div>
            <a class="gkmy-btn" href="{{ section.settings.hero_btn_url | default: '#gkmy-paket' }}">{{ section.settings.hero_btn_text | default: 'Lihat paket' }}</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== PILIH PAKET ===== -->
  <section class="gkmy-sec gkmy-sec--mist" id="gkmy-paket">
    <div class="gkmy-wrap">
