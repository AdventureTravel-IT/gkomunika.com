        {%- for block in section.blocks -%}
          {%- if block.type == 'product_card' -%}
            {%- assign product_count = product_count | plus: 1 -%}
            {%- assign card_product = block.settings.product -%}
            {%- assign card_title = block.settings.title -%}
            {%- if card_title == blank and card_product != blank -%}
              {%- assign card_title = card_product.title -%}
            {%- endif -%}
            {%- assign card_handle = block.settings.handle -%}
            {%- if card_handle == blank and card_product != blank -%}
              {%- assign card_handle = card_product.handle -%}
            {%- endif -%}
            {%- assign card_url = block.settings.button_url -%}
            {%- if card_url == blank and card_product != blank -%}
              {%- assign card_url = card_product.url -%}
            {%- elsif card_url == blank and card_handle != blank -%}
              {%- assign card_url = '/products/' | append: card_handle -%}
            {%- elsif card_url == blank -%}
              {%- assign card_url = '#' -%}
            {%- endif -%}
            {%- assign card_fallback = block.settings.price_fallback -%}
            {%- if card_fallback == blank and card_product != blank -%}
              {%- assign card_fallback = card_product.price_min | divided_by: 100 -%}
            {%- endif -%}
            {%- assign card_price = block.settings.price -%}
            {%- if card_price == blank and card_product != blank -%}
              {%- assign card_price = card_product.price_min | money -%}
            {%- endif -%}
            <article class="gkmy-card {{ block.settings.card_extra_class }}" {{ block.shopify_attributes }}>
              <div class="gkmy-c-head">
                <span class="gkmy-ft">
                  <svg class="gkmy-fl" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
                    <use href="#gkmy-f-{{ block.settings.flag | default: 'my' }}"/>
                  </svg>
                </span>
                <h3 class="gkmy-c-title">
                  <span class="gkmy-tag">{{ block.settings.tag | default: 'eSIM' }}</span>
                  <span class="gkmy-c-name">{{ card_title }}</span>
                </h3>
              </div>
              <div class="gkmy-cover">
                <svg class="gkmy-i" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href="#gkmy-i-globe"/></svg>
                <b>{{ block.settings.coverage | default: '1 negara' }}</b>
              </div>
              <div class="gkmy-c-foot">
                <div class="gkmy-price">
                  <small>{{ block.settings.price_prefix | default: 'Mulai dari' }}</small>
                  <b class="gkmy-price-val" data-gkmy-handle="{{ card_handle }}" data-gkmy-fallback="{{ card_fallback }}">{{ card_price }}</b>
                </div>
                <a class="gkmy-btn" href="{{ card_url }}">{{ block.settings.button_label | default: 'Lihat paket' }}</a>
              </div>
            </article>
          {%- endif -%}
        {%- endfor -%}

        {%- if product_count == 0 -%}
          <!-- Default Fallback Cards -->
          <article class="gkmy-card">
<div class="gkmy-c-head"><span class="gkmy-ft"><svg class="gkmy-fl" viewBox="0 0 40 40" aria-hidden="true" focusable="false"><use href="#gkmy-f-my"/></svg></span><h3 class="gkmy-c-title"><span class="gkmy-tag">eSIM</span> <span class="gkmy-c-name">Malaysia</span></h3></div>
<div class="gkmy-cover"><svg class="gkmy-i" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href="#gkmy-i-globe"/></svg><b>1 negara</b></div>
<div class="gkmy-c-foot"><div class="gkmy-price"><small>Mulai dari</small><b class="gkmy-price-val" data-gkmy-handle="esim-malaysia" data-gkmy-fallback="39000">Rp39.000</b></div><a class="gkmy-btn" href="https://gkomunika.com/products/esim-malaysia?variant=46706806391001">Lihat paket</a></div>
