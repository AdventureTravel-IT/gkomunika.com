{% comment %}
  Shopify Section for Global Komunika eSIM Singapore Landing Page.
  Exact 1:1 match with landing-page-esim-singapore-final.html with dynamic Customizer settings.
{% endcomment %}

{%- assign hero_img_url = 'https://cdn.shopify.com/s/files/1/0735/4204/1817/files/LP_Singapore.png?v=1794971946' -%}
{%- if section.settings.hero_image != blank -%}
  {%- assign hero_img_url = section.settings.hero_image | image_url: width: 1440 -%}
{%- elsif section.settings.hero_image_url != blank -%}
  {%- assign hero_img_url = section.settings.hero_image_url -%}
{%- endif -%}

<style>
@font-face{font-family:"Gotham";font-weight:400;font-style:normal;font-display:swap;src:url("https://cdn.shopify.com/s/files/1/0735/4204/1817/files/Gotham-Book.otf?v=1794546841") format("opentype");}
@font-face{font-family:"Gotham";font-weight:700;font-style:normal;font-display:swap;src:url("https://cdn.shopify.com/s/files/1/0735/4204/1817/files/Gotham-Bold.otf?v=1794546841") format("opentype");}

.gksg-page{--gksg-blue:#005496;--gksg-cyan:#00ADEE;--gksg-ink:#222222;--gksg-text:#2B2F33;--gksg-muted:#5A6570;--gksg-mist:#F4F7FA;--gksg-tint:#CCEFFC;--gksg-tint2:#E3F6FD;--gksg-line:#DDE4EA;--gksg-green:#2E884A;--gksg-star:#FBB526;box-sizing:border-box;color-scheme:light;position:relative;background:#fff;color:var(--gksg-text);font-family:"Gotham","Gotham Rounded","Montserrat",Arial,Helvetica,sans-serif;font-weight:400;font-size:16px;line-height:1.6;-webkit-text-size-adjust:100%;overflow-x:hidden}
.gksg-page *,.gksg-page *::before,.gksg-page *::after{box-sizing:border-box}
:where(.gksg-page) :is(h1,h2,h3,p,ul,ol,li,blockquote,small,figure){margin:0;padding:0}
:where(.gksg-page) :is(ul,ol){list-style:none}
:where(.gksg-page) a{color:inherit}
.gksg-page button{font-family:inherit}
.gksg-page :focus-visible{outline:3px solid var(--gksg-cyan);outline-offset:3px;border-radius:6px}
.gksg-sr{position:absolute;width:1px;height:1px;margin:-1px;padding:0;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
.gksg-i{display:block;width:100%;height:100%}
.gksg-wrap{width:100%;max-width:1120px;margin:0 auto;padding:0 32px}
.gksg-sec{padding:72px 0 80px}
.gksg-sec--mist{background:var(--gksg-mist)}
.gksg-h2{font-size:30px;line-height:1.25;font-weight:700;letter-spacing:-.01em;color:var(--gksg-blue);max-width:760px}
.gksg-lead{margin-top:12px;color:var(--gksg-muted);max-width:640px}
.gksg-btn{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:12px 28px;border-radius:999px;background:var(--gksg-blue);color:#fff;font-family:inherit;font-weight:700;font-size:16px;line-height:1.2;text-decoration:none;border:2px solid var(--gksg-blue);white-space:nowrap;cursor:pointer;transition:background .2s,border-color .2s}
.gksg-btn:hover{background:#003F73;border-color:#003F73}
.gksg-btn--light{background:#fff;color:var(--gksg-blue);border-color:#fff}
.gksg-btn--light:hover{background:var(--gksg-tint2);border-color:var(--gksg-tint2)}
.gksg-tag{display:inline-block;font-weight:700;font-size:15px;line-height:1.45;color:#fff;background:var(--gksg-blue);border-radius:8px;padding:1px 10px;white-space:nowrap}
.gksg-tag-s{background:#8A97A3}
@media (prefers-reduced-motion:no-preference){.gksg-page{scroll-behavior:smooth}}

/* ===== HERO ===== */
.gksg-hero{position:relative;height:440px;overflow:hidden;background:linear-gradient(180deg,#00487F 0%,#0A6BB0 38%,#2F9BD6 68%,#8FCBEA 88%,#fff 100%);color:#fff}
.gksg-hero-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:0}
.gksg-hero-img[src=""]{display:none}
.gksg-hero::before{content:"";position:absolute;inset:0;z-index:1;background:linear-gradient(90deg,rgba(0,35,75,.52) 0%,rgba(0,35,75,.3) 42%,rgba(0,35,75,0) 72%),linear-gradient(180deg,rgba(0,40,80,.34) 0%,rgba(0,40,80,.12) 70%,rgba(0,40,80,0) 100%)}
.gksg-hero::after{content:"";position:absolute;left:0;right:0;bottom:0;height:150px;z-index:1;background:linear-gradient(180deg,rgba(255,255,255,0) 0%,#fff 92%)}
.gksg-hero-in{position:relative;z-index:2;max-width:1120px;margin:0 auto;padding:0 32px;height:100%}
.gksg-hero-top{display:flex;justify-content:flex-end;padding-top:28px}
.gksg-compat{display:inline-flex;align-items:center;gap:8px;min-height:44px;padding:10px 20px;border-radius:999px;background:#FBB526;color:#003F73;font-weight:700;font-size:15px;line-height:1.2;text-decoration:none;white-space:nowrap;box-shadow:0 6px 18px rgba(0,30,70,.25)}
.gksg-compat .gksg-i{width:18px;height:18px;flex:0 0 18px;color:#003F73}
.gksg-cmp-m{display:none}
.gksg-hero-row{display:flex;justify-content:space-between;align-items:flex-end;gap:24px;margin-top:84px}
.gksg-h1{font-weight:700;line-height:1.1;letter-spacing:-.01em;color:#fff;text-shadow:0 2px 14px rgba(0,30,70,.45)}
.gksg-hl{text-shadow:none}
.gksg-h1-big{display:flex;align-items:center;gap:14px;font-size:48px}
.gksg-hl{display:inline-block;background:#FBB526;color:var(--gksg-blue);border-radius:12px;padding:0 14px 4px}
.gksg-h1-sub{display:block;margin-top:14px;font-weight:400;font-size:22px;line-height:1.35;max-width:700px;color:#fff}
.gksg-chips{display:flex;gap:10px;flex-wrap:wrap;justify-content:flex-end;max-width:420px;padding-bottom:6px}
.gksg-chip{display:inline-flex;align-items:center;gap:8px;background:#fff;color:var(--gksg-ink);border-radius:999px;padding:8px 16px;font-weight:700;font-size:15px;line-height:1.3;box-shadow:0 4px 14px rgba(0,30,70,.18)}
.gksg-chip .gksg-i{width:18px;height:18px;flex:0 0 18px;color:var(--gksg-blue)}
.gksg-intro{max-width:1120px;margin:0 auto;padding:8px 32px 8px}
.gksg-intro-p{max-width:680px}
.gksg-cta-row{display:flex;align-items:center;gap:20px;margin-top:24px;flex-wrap:wrap}
.gksg-cta-row .gksg-btn{min-height:52px;padding:12px 28px}
.gksg-note{display:flex;align-items:center;gap:10px;font-size:14px;color:var(--gksg-muted)}
.gksg-note span.gksg-ni{width:24px;height:24px;border-radius:50%;background:var(--gksg-green);color:#fff;display:grid;place-items:center;flex:0 0 24px}
.gksg-note span.gksg-ni .gksg-i{width:13px;height:13px}

/* ===== PAKET ===== */
.gksg-head-row{display:flex;justify-content:space-between;align-items:flex-end;gap:24px}
.gksg-arrows{display:flex;gap:10px;flex:0 0 auto}
.gksg-arrow{width:48px;height:48px;border-radius:50%;border:2px solid var(--gksg-blue);background:#fff;color:var(--gksg-blue);display:grid;place-items:center;cursor:pointer;padding:0;transition:background .2s,color .2s,opacity .2s}
.gksg-arrow .gksg-i{width:20px;height:20px}
.gksg-arrow:hover:not(:disabled){background:var(--gksg-blue);color:#fff}
.gksg-arrow:disabled{opacity:.35;cursor:default}
.gksg-arrows.is-static{display:none}
.gksg-track{display:flex;gap:20px;overflow-x:auto;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;scrollbar-width:none;margin-top:36px;padding:4px 0 10px}
.gksg-track::-webkit-scrollbar{display:none}
.gksg-track>*{scroll-snap-align:start}
.gksg-track-pk>*{flex:0 0 480px}
.gksg-card{background:#fff;border:1px solid var(--gksg-line);border-radius:24px;padding:24px 28px;display:flex;flex-direction:column;gap:14px}
.gksg-c-head{display:flex;align-items:center;gap:16px;min-height:113px;padding-bottom:16px;border-bottom:1px solid var(--gksg-line)}
.gksg-ft{display:block;width:60px;height:60px;border-radius:14px;overflow:hidden;border:1px solid rgba(0,0,0,.12);background:#fff;flex:0 0 auto}
.gksg-fl{display:block;width:100%;height:100%}
.gksg-fg{display:grid;grid-template-columns:repeat(2,28px);grid-auto-rows:28px;gap:4px;width:60px;min-height:60px;align-content:center;flex:0 0 60px}
.gksg-fg .gksg-ft{width:28px;height:28px;border-radius:8px}
.gksg-ft-more{display:grid;place-items:center;background:#E8F0F7;border-color:#D3E0EB;color:var(--gksg-blue);font-weight:700;font-size:13px;line-height:1}
.gksg-c-title{display:flex;align-items:center;flex-wrap:wrap;gap:4px 10px;font-size:22px;line-height:1.3;font-weight:700;color:var(--gksg-blue)}
.gksg-cover{display:flex;align-items:center;gap:10px;font-size:18px;line-height:1.3;color:var(--gksg-ink)}
.gksg-cover .gksg-i{width:22px;height:22px;flex:0 0 22px;color:var(--gksg-blue)}
.gksg-cover b{font-weight:700}
.gksg-c-foot{margin-top:auto;display:flex;justify-content:space-between;align-items:center;gap:16px;border-top:1px solid var(--gksg-line);padding-top:16px}
.gksg-price small{display:block;font-size:14px;color:var(--gksg-muted);line-height:1.2}
.gksg-price b{display:block;font-size:28px;line-height:1.15;color:var(--gksg-ink);font-weight:700}
.gksg-gsim{margin-top:64px;display:grid;grid-template-columns:480px 480px;gap:20px;align-items:stretch}
.gksg-gmsg{display:flex;flex-direction:column}
.gksg-gh{font-size:28px;line-height:1.3;font-weight:700;color:var(--gksg-blue);max-width:480px}
.gksg-gpts{margin-top:24px;display:flex;flex-direction:column;gap:14px}
.gksg-gpts li{display:flex;align-items:center;gap:14px;min-height:48px;font-weight:700;font-size:17px;line-height:1.35;color:var(--gksg-blue)}
.gksg-gpts li span{flex:0 0 48px;width:48px;height:48px;border-radius:50%;background:var(--gksg-tint);color:var(--gksg-blue);display:grid;place-items:center}
.gksg-gpts li span .gksg-i{width:24px;height:24px}
.gksg-gsim .gksg-card{width:100%}
@media (max-width:1100px){.gksg-gsim{grid-template-columns:1fr;gap:28px}.gksg-gsim .gksg-card{max-width:480px}}

/* ===== BANDING ===== */
.gksg-seg{display:none}
.gksg-vs-grid{margin-top:40px;display:grid;grid-template-columns:1fr 1fr;column-gap:20px;align-items:start}
.gksg-vs-esim{background:var(--gksg-tint2);border-radius:24px;padding-bottom:10px}
.gksg-vs-h{display:flex;align-items:center;min-height:64px;padding:22px 28px 6px}
.gksg-vs-col li{display:flex;align-items:center;gap:16px;min-height:96px;padding:14px 28px}
.gksg-ic{flex:0 0 44px;width:44px;height:44px;border-radius:50%;display:grid;place-items:center}
.gksg-ic .gksg-i{width:22px;height:22px}
.gksg-vs-esim .gksg-ic{background:var(--gksg-blue);color:#fff}
.gksg-vs-sim .gksg-ic{background:#EEF2F5;color:#8A97A3}
.gksg-vs-sim li{border-bottom:1px solid #E3E9EE}
.gksg-vs-sim li:last-child{border-bottom:0}
.gksg-vs-col small{display:block;font-size:14px;line-height:1.3;color:var(--gksg-muted)}
.gksg-vs-esim b{display:block;font-size:17px;line-height:1.35;color:var(--gksg-blue);font-weight:700}
.gksg-val{display:block;font-size:17px;line-height:1.35;color:var(--gksg-muted)}

/* ===== CEK HP ===== */
.gksg-hp-list{margin-top:36px;display:flex;flex-direction:column;gap:16px}
.gksg-hp{background:#fff;border:1px solid var(--gksg-line);border-radius:24px;padding:24px 32px;display:grid;grid-template-columns:240px 1fr;gap:32px;align-items:center;min-height:113px}
.gksg-hp-who{display:flex;align-items:center;gap:14px}
.gksg-ico{flex:0 0 52px;width:52px;height:52px;border-radius:50%;background:var(--gksg-tint);color:var(--gksg-blue);display:grid;place-items:center}
.gksg-ico .gksg-i{width:26px;height:26px}
.gksg-hp-t{font-size:22px;line-height:1.3;color:var(--gksg-blue);font-weight:700}
.gksg-hp-how{border-left:1px solid var(--gksg-line);padding-left:32px;display:flex;flex-direction:column;gap:10px;justify-content:center}
.gksg-path{font-weight:700;font-size:17px;line-height:1.5;color:var(--gksg-ink)}
.gksg-pt{white-space:nowrap}
.gksg-pt-last{color:var(--gksg-blue)}
.gksg-sep{display:inline-block;width:7px;height:7px;border-right:2px solid #8A97A3;border-top:2px solid #8A97A3;transform:rotate(45deg);margin:0 11px 1px 7px}
.gksg-res{display:flex;gap:12px;align-items:flex-start}
.gksg-res-i{flex:0 0 26px;width:26px;height:26px;border-radius:50%;background:var(--gksg-green);color:#fff;display:grid;place-items:center;margin-top:1px}
.gksg-res-i .gksg-i{width:14px;height:14px}


.gksg-nohp{margin-top:24px;background:#fff;border:1px solid var(--gksg-line);border-radius:24px;padding:28px 32px;display:grid;grid-template-columns:1fr auto;gap:32px;align-items:center}
.gksg-nohp-t{font-size:20px;line-height:1.3;font-weight:700;color:var(--gksg-blue)}
.gksg-nohp-p{margin-top:8px;color:var(--gksg-muted);max-width:680px}

/* ===== AKTIVASI ===== */
.gksg-act{margin-top:40px;display:grid;grid-template-columns:repeat(3,1fr);gap:20px;align-items:stretch}
.gksg-act-c{background:var(--gksg-mist);border-radius:24px;padding:28px;display:flex;flex-direction:column;gap:18px;position:relative}
.gksg-act-top{display:flex;flex-direction:column;gap:16px}
.gksg-num{width:48px;height:48px;border-radius:50%;background:var(--gksg-blue);color:#fff;display:grid;place-items:center;font-weight:700;font-size:20px}
.gksg-act-done .gksg-num{background:var(--gksg-green)}
.gksg-act-t{font-size:22px;line-height:1.3;color:var(--gksg-blue);font-weight:700;min-height:58px}
.gksg-act-p{color:#4A545E}
.gksg-act-c:not(:last-child)::after{content:"";position:absolute;top:52px;left:88px;right:-20px;height:2px;background:repeating-linear-gradient(90deg,#B8C4CE 0 6px,transparent 6px 12px)}

/* ===== MENGAPA ===== */
.gksg-sec--blue{background:var(--gksg-blue);color:#fff;padding:88px 0 96px}
.gksg-sec--blue .gksg-h2{color:#fff;font-size:32px;max-width:none}
.gksg-why{margin-top:40px;display:grid;grid-template-columns:repeat(3,1fr);background:rgba(255,255,255,.09);border:1px solid rgba(255,255,255,.18);border-radius:28px;padding:40px 0}
.gksg-why-c{display:flex;flex-direction:column;align-items:flex-start;gap:20px;padding:0 36px}
.gksg-why-c+.gksg-why-c{border-left:1px solid rgba(255,255,255,.22)}
.gksg-badge{display:inline-grid;place-items:center;min-height:48px;padding:0 24px;border-radius:14px;background:#fff;color:var(--gksg-blue);font-size:22px;line-height:1;font-weight:700;white-space:nowrap}
.gksg-why-t{font-size:20px;line-height:1.35;font-weight:700;color:#fff;min-height:54px}
.gksg-why-p{margin-top:-8px;color:#DCEBF7}

/* ===== TESTIMONI ===== */
.gksg-track-rv>*{flex:0 0 380px}
.gksg-rev{background:var(--gksg-mist);border-radius:24px;padding:26px 26px 24px;display:flex;flex-direction:column;gap:14px}
.gksg-stars{display:flex;gap:3px}
.gksg-stars .gksg-i{width:20px;height:20px;color:var(--gksg-star)}
.gksg-q{margin:0;color:var(--gksg-text)}
.gksg-rev-who{margin-top:auto;padding-top:16px;border-top:1px solid var(--gksg-line)}
.gksg-rev-who b{display:block;font-weight:700;color:var(--gksg-ink)}
.gksg-rev-who span{font-size:14px;color:var(--gksg-muted)}
.gksg-rv-ctrl{display:flex;gap:10px;margin-top:20px}

/* ===== FAQ ===== */
.gksg-faq{margin-top:32px;display:flex;flex-direction:column;gap:12px;max-width:820px}
.gksg-faq-i{background:#fff;border-radius:16px;border:1px solid var(--gksg-line)}
.gksg-faq-i[open]{border-color:var(--gksg-blue)}
.gksg-faq-s{list-style:none;cursor:pointer;display:flex;align-items:center;justify-content:space-between;gap:16px;min-height:56px;padding:14px 20px}
.gksg-faq-s::-webkit-details-marker{display:none}
.gksg-faq-s::after{content:"";flex:0 0 12px;width:12px;height:12px;border-right:2px solid var(--gksg-blue);border-bottom:2px solid var(--gksg-blue);transform:rotate(45deg);transition:transform .2s;margin-top:-4px}
.gksg-faq-i[open] .gksg-faq-s::after{transform:rotate(-135deg);margin-top:4px}
.gksg-faq-q{font-size:16px;line-height:1.4;font-weight:700;color:var(--gksg-ink)}
.gksg-faq-a{padding:0 20px 20px;color:var(--gksg-muted)}
.gksg-faq-p+.gksg-faq-p{margin-top:10px}
.gksg-faq-ol{margin-top:10px;display:flex;flex-direction:column;gap:6px;list-style:decimal;padding-left:20px}
.gksg-faq-ol li{display:list-item}
.gksg-link{color:var(--gksg-blue);font-weight:700}

/* ===== CTA AKHIR ===== */
.gksg-final{background:var(--gksg-blue);color:#fff;padding:88px 0;position:relative;overflow:hidden}
.gksg-final::before{content:"";position:absolute;right:-120px;top:-120px;width:360px;height:360px;border-radius:50%;background:linear-gradient(45deg,#005496 0%,#00ADEE 100%);opacity:.55}
.gksg-final .gksg-wrap{position:relative}
.gksg-final .gksg-h2{color:#fff;font-size:34px;max-width:640px}
.gksg-final-p{margin-top:14px;color:#DCEBF7;max-width:560px}
.gksg-final .gksg-btn{margin-top:28px}

/* ===== MOBILE ===== */
@media (max-width:767px){
  .gksg-wrap{padding:0 20px}
  .gksg-sec{padding:48px 0 56px}
  .gksg-h2{font-size:24px}
  .gksg-hero{height:470px}
  .gksg-hero::before{background:linear-gradient(180deg,rgba(0,35,75,.62) 0%,rgba(0,35,75,.52) 58%,rgba(0,35,75,0) 92%)}
  .gksg-hero-in{padding:0 20px}
  .gksg-hero-top{padding-top:20px}
  .gksg-compat{padding:8px 14px;font-size:14px}
  .gksg-cmp-d{display:none}.gksg-cmp-m{display:inline}
  .gksg-hero-row{flex-direction:column;align-items:flex-start;gap:16px;margin-top:64px}
  .gksg-h1-big{font-size:32px;gap:10px}
  .gksg-hl{padding:0 10px 3px;border-radius:10px}
  .gksg-h1-sub{font-size:18px;margin-top:10px}
  .gksg-chips{justify-content:flex-start;max-width:none;padding-bottom:0}
  .gksg-chip{font-size:14px;padding:7px 12px}
  .gksg-intro{padding:4px 20px 0}
  .gksg-cta-row .gksg-btn{width:100%}
  .gksg-head-row{flex-direction:column;align-items:flex-start;gap:20px}
  .gksg-track{margin:28px -20px 0;padding:4px 20px 10px;gap:14px;scroll-padding:0 20px}
  .gksg-track-pk>*{flex:0 0 min(340px,calc(100vw - 40px))}
  .gksg-card{padding:20px}
  .gksg-c-head{min-height:117px}
  .gksg-c-title{font-size:18px}
  .gksg-price b{font-size:24px}
  .gksg-c-foot .gksg-btn{padding:12px 14px;font-size:15px}
  .gksg-c-foot{gap:10px}
  .gksg-gsim{margin-top:44px;grid-template-columns:1fr;gap:24px}
  .gksg-gmsg{width:min(340px,calc(100vw - 40px))}
  .gksg-gsim .gksg-card{width:min(340px,calc(100vw - 40px))}
  .gksg-gh{font-size:22px}
  .gksg-gpts{margin-top:20px;gap:12px}
  .gksg-gpts li{font-size:16px;gap:12px}
  .gksg-gpts li span{flex:0 0 44px;width:44px;height:44px}
  .gksg-seg{display:flex;margin-top:28px;background:var(--gksg-mist);border-radius:999px;padding:4px;gap:4px}
  .gksg-seg-b{flex:1;display:grid;place-items:center;min-height:48px;border:0;border-radius:999px;background:transparent;font-weight:700;font-size:16px;color:var(--gksg-muted);cursor:pointer}
  .gksg-seg-b[data-gksg-tab="esim"].is-on{background:var(--gksg-blue);color:#fff}
  .gksg-seg-b[data-gksg-tab="sim"].is-on{background:#8A97A3;color:#fff}
  .gksg-vs-grid{display:block;margin-top:8px}
  .gksg-vs-esim{background:none;border-radius:0;padding-bottom:0}
  .gksg-vs-h{display:none}
  .gksg-vs[data-active="esim"] .gksg-vs-sim{display:none}
  .gksg-vs[data-active="sim"] .gksg-vs-esim{display:none}
  .gksg-vs-col li{min-height:0;padding:16px 0;border-bottom:1px solid #E3E9EE}
  .gksg-vs-col li:last-child{border-bottom:0}
  .gksg-vs-esim .gksg-ic{background:var(--gksg-tint);color:var(--gksg-blue)}
  .gksg-val{color:var(--gksg-text)}
  .gksg-hp-list{margin-top:28px;gap:12px}
  .gksg-hp{grid-template-columns:1fr;gap:14px;padding:20px;border-radius:22px;min-height:0;align-items:start}
  .gksg-ico{flex:0 0 44px;width:44px;height:44px}.gksg-ico .gksg-i{width:22px;height:22px}
  .gksg-hp-t{font-size:20px}
  .gksg-hp-how{border-left:0;padding-left:0}
  .gksg-path{font-size:16px}
  .gksg-nohp{grid-template-columns:1fr;gap:18px;padding:22px;border-radius:22px;margin-top:16px}
  .gksg-nohp .gksg-btn{width:100%}
  .gksg-act{grid-template-columns:1fr;gap:12px;margin-top:28px}
  .gksg-act-c{padding:22px;gap:14px;border-radius:22px}
  .gksg-act-top{flex-direction:row;align-items:center;gap:14px}
  .gksg-num{flex:0 0 44px;width:44px;height:44px;font-size:18px}
  .gksg-act-t{font-size:19px;min-height:0}
  .gksg-act-c:not(:last-child)::after{display:none}
  .gksg-sec--blue{padding:56px 0 60px}
  .gksg-sec--blue .gksg-h2{font-size:26px}
  .gksg-why{display:flex;flex-direction:column;gap:12px;margin-top:26px;background:none;border:0;padding:0}
  .gksg-why-c{background:rgba(255,255,255,.09);border:1px solid rgba(255,255,255,.18);border-radius:20px;padding:20px;gap:14px}
  .gksg-why-c+.gksg-why-c{border-left:1px solid rgba(255,255,255,.18)}
  .gksg-badge{min-height:40px;padding:0 18px;border-radius:12px;font-size:20px}
  .gksg-why-t{font-size:19px;min-height:0}
  .gksg-why-p{margin-top:-4px}
  .gksg-track-rv>*{flex:0 0 min(340px,calc(100vw - 56px))}
  .gksg-faq{margin-top:24px}
  .gksg-final{padding:56px 0}
  .gksg-final .gksg-h2{font-size:26px}
  .gksg-final .gksg-btn{width:100%}
}
@media (max-width:1000px) and (min-width:768px){
  .gksg-act{grid-template-columns:1fr}
  .gksg-act-c:not(:last-child)::after{display:none}
  .gksg-act-t{min-height:0}
  .gksg-why{grid-template-columns:1fr;padding:12px 0}
  .gksg-why-c{padding:24px 36px}
  .gksg-why-c+.gksg-why-c{border-left:0;border-top:1px solid rgba(255,255,255,.22)}
  .gksg-hp{grid-template-columns:200px 1fr}
  .gksg-nohp{grid-template-columns:1fr;gap:20px}
}
@media (max-width:340px){.gksg-c-foot{flex-wrap:wrap}.gksg-c-foot .gksg-btn{width:100%}}
@media (max-width:380px){.gksg-price b{font-size:21px}.gksg-c-foot .gksg-btn{padding:12px 12px;font-size:14px}}
@media (prefers-reduced-motion:reduce){.gksg-page *{transition:none !important}}

