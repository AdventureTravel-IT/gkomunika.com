{% comment %}
  Shopify Section for Global Komunika eSIM Thailand Landing Page.
  Converted dynamically from LP_eSIM_Thailand_FINAL.html with full Theme Customizer support.
{% endcomment %}

{%- assign hero_img_url = section.settings.hero_image_url -%}
{%- if section.settings.hero_image != blank -%}
  {%- assign hero_img_url = section.settings.hero_image | image_url: width: 1400 -%}
{%- elsif hero_img_url == blank -%}
  {%- assign hero_img_url = 'https://cdn.shopify.com/s/files/1/0735/4204/1817/files/thai_4a559a09-e2e9-4c5b-a212-5d641002ff08.jpg?v=1756893975' -%}
{%- endif -%}

{%- assign wa_number = section.settings.whatsapp_number | default: '628156080055' -%}
{%- assign wa_text = section.settings.whatsapp_text | default: 'Halo Global Komunika, saya ingin tanya seputar eSIM Thailand' | url_encode -%}

<style>

#gk-section-{{ section.id }}.gkth-page,
#gk-section-{{ section.id }} {
  --gkth-blue: {{ section.settings.brand_blue | default: '#005496' }};
  --gkth-cyan: {{ section.settings.brand_sky | default: '#00ADEE' }};
  --gkth-ink: #222222;
  --gkth-text: #2B2F33;
  --gkth-muted: #5A6570;
  --gkth-mist: #F4F7FA;
  --gkth-tint: #CCEFFC;
  --gkth-tint2: #E3F6FD;
  --gkth-line: #DDE4EA;
  --gkth-green: #2E884A;
  --gkth-star: #FBB526;
  box-sizing: border-box;
  color-scheme: light;
  position: relative;
  background: #fff;
  color: var(--gkth-text);
  font-family: "Gotham", "Gotham Rounded", "Montserrat", Arial, Helvetica, sans-serif;
  font-weight: 400;
  font-size: 16px;
  line-height: 1.6;
  -webkit-text-size-adjust: 100%;
  overflow-x: hidden;
  width: 100%;
}
#MainContent:has(#gk-section-{{ section.id }}) {
  max-width: 100% !important;
  padding-left: 0 !important;
  padding-right: 0 !important;
}

.gkth-page *,.gkth-page *::before,.gkth-page *::after{box-sizing:border-box}
:where(.gkth-page) :is(h1,h2,h3,p,ul,ol,li,blockquote,small,figure){margin:0;padding:0}
:where(.gkth-page) :is(ul,ol){list-style:none}
:where(.gkth-page) a{color:inherit}
.gkth-page button{font-family:inherit}
.gkth-page :focus-visible{outline:3px solid var(--gkth-cyan);outline-offset:3px;border-radius:6px}
.gkth-sr{position:absolute;width:1px;height:1px;margin:-1px;padding:0;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
.gkth-i{display:block;width:100%;height:100%}
.gkth-wrap{width:100%;max-width:1120px;margin:0 auto;padding:0 32px}
.gkth-sec{padding:72px 0 80px}
.gkth-sec--mist{background:var(--gkth-mist)}
.gkth-h2{font-size:30px;line-height:1.25;font-weight:700;letter-spacing:-.01em;color:var(--gkth-blue);max-width:760px}
.gkth-lead{margin-top:12px;color:var(--gkth-muted);max-width:640px}
.gkth-btn{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:12px 28px;border-radius:999px;background:var(--gkth-blue);color:#fff;font-family:inherit;font-weight:700;font-size:16px;line-height:1.2;text-decoration:none;border:2px solid var(--gkth-blue);white-space:nowrap;cursor:pointer;transition:background .2s,border-color .2s}
.gkth-btn:hover{background:#003F73;border-color:#003F73}
.gkth-btn--light{background:#fff;color:var(--gkth-blue);border-color:#fff}
.gkth-btn--light:hover{background:var(--gkth-tint2);border-color:var(--gkth-tint2)}
.gkth-tag{display:inline-block;font-weight:700;font-size:15px;line-height:1.45;color:#fff;background:var(--gkth-blue);border-radius:8px;padding:1px 10px;white-space:nowrap}
.gkth-tag-s{background:#8A97A3}
@media (prefers-reduced-motion:no-preference){.gkth-page{scroll-behavior:smooth}}

/* ===== HERO ===== */
.gkth-hero{position:relative;height:440px;overflow:hidden;background:linear-gradient(180deg,#00487F 0%,#0A6BB0 38%,#2F9BD6 68%,#8FCBEA 88%,#fff 100%);color:#fff}
.gkth-hero-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:0}
.gkth-hero-img[src=""]{display:none}
.gkth-hero::before{content:"";position:absolute;inset:0;z-index:1;background:linear-gradient(90deg,rgba(0,35,75,.52) 0%,rgba(0,35,75,.3) 42%,rgba(0,35,75,0) 72%),linear-gradient(180deg,rgba(0,40,80,.34) 0%,rgba(0,40,80,.12) 70%,rgba(0,40,80,0) 100%)}
.gkth-hero::after{content:"";position:absolute;left:0;right:0;bottom:0;height:150px;z-index:1;background:linear-gradient(180deg,rgba(255,255,255,0) 0%,#fff 92%)}
.gkth-hero-in{position:relative;z-index:2;max-width:1120px;margin:0 auto;padding:0 32px;height:100%}
.gkth-hero-top{display:flex;justify-content:flex-end;padding-top:28px}
.gkth-compat{display:inline-flex;align-items:center;gap:8px;min-height:44px;padding:10px 20px;border-radius:999px;background:#FBB526;color:#003F73;font-weight:700;font-size:15px;line-height:1.2;text-decoration:none;white-space:nowrap;box-shadow:0 6px 18px rgba(0,30,70,.25)}
.gkth-compat .gkth-i{width:18px;height:18px;flex:0 0 18px;color:#003F73}
.gkth-cmp-m{display:none}
.gkth-hero-row{display:flex;justify-content:space-between;align-items:flex-end;gap:24px;margin-top:84px}
.gkth-h1{font-weight:700;line-height:1.1;letter-spacing:-.01em;color:#fff;text-shadow:0 2px 14px rgba(0,30,70,.45)}
.gkth-hl{text-shadow:none}
.gkth-h1-big{display:flex;align-items:center;gap:14px;font-size:48px}
.gkth-hl{display:inline-block;background:#FBB526;color:var(--gkth-blue);border-radius:12px;padding:0 14px 4px}
.gkth-h1-sub{display:block;margin-top:14px;font-weight:400;font-size:22px;line-height:1.35;max-width:700px;color:#fff}
.gkth-chips{display:flex;gap:10px;flex-wrap:wrap;justify-content:flex-end;max-width:420px;padding-bottom:6px}
.gkth-chip{display:inline-flex;align-items:center;gap:8px;background:#fff;color:var(--gkth-ink);border-radius:999px;padding:8px 16px;font-weight:700;font-size:15px;line-height:1.3;box-shadow:0 4px 14px rgba(0,30,70,.18)}
.gkth-chip .gkth-i{width:18px;height:18px;flex:0 0 18px;color:var(--gkth-blue)}
.gkth-intro{max-width:1120px;margin:0 auto;padding:8px 32px 8px}
.gkth-intro-p{max-width:680px}
.gkth-cta-row{display:flex;align-items:center;gap:20px;margin-top:24px;flex-wrap:wrap}
.gkth-cta-row .gkth-btn{min-height:52px;padding:12px 28px}
.gkth-note{display:flex;align-items:center;gap:10px;font-size:14px;color:var(--gkth-muted)}
.gkth-note span.gkth-ni{width:24px;height:24px;border-radius:50%;background:var(--gkth-green);color:#fff;display:grid;place-items:center;flex:0 0 24px}
.gkth-note span.gkth-ni .gkth-i{width:13px;height:13px}

/* ===== PAKET ===== */
.gkth-head-row{display:flex;justify-content:space-between;align-items:flex-end;gap:24px}
.gkth-arrows{display:flex;gap:10px;flex:0 0 auto}
.gkth-arrow{width:48px;height:48px;border-radius:50%;border:2px solid var(--gkth-blue);background:#fff;color:var(--gkth-blue);display:grid;place-items:center;cursor:pointer;padding:0;transition:background .2s,color .2s,opacity .2s}
.gkth-arrow .gkth-i{width:20px;height:20px}
.gkth-arrow:hover:not(:disabled){background:var(--gkth-blue);color:#fff}
.gkth-arrow:disabled{opacity:.35;cursor:default}
.gkth-arrows.is-static{display:none}
.gkth-track{display:flex;gap:20px;overflow-x:auto;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;scrollbar-width:none;margin-top:36px;padding:4px 0 10px}
.gkth-track::-webkit-scrollbar{display:none}
.gkth-track>*{scroll-snap-align:start}
.gkth-track-pk>*{flex:0 0 480px}
.gkth-card{background:#fff;border:1px solid var(--gkth-line);border-radius:24px;padding:24px 28px;display:flex;flex-direction:column;gap:14px}
.gkth-c-head{display:flex;align-items:center;gap:16px;min-height:113px;padding-bottom:16px;border-bottom:1px solid var(--gkth-line)}
.gkth-ft{display:block;width:60px;height:60px;border-radius:14px;overflow:hidden;border:1px solid rgba(0,0,0,.12);background:#fff;flex:0 0 auto}
.gkth-fl{display:block;width:100%;height:100%}
.gkth-fg{display:grid;grid-template-columns:repeat(2,28px);grid-auto-rows:28px;gap:4px;width:60px;min-height:60px;align-content:center;flex:0 0 60px}
.gkth-fg .gkth-ft{width:28px;height:28px;border-radius:8px}
.gkth-ft-more{display:grid;place-items:center;background:#E8F0F7;border-color:#D3E0EB;color:var(--gkth-blue);font-weight:700;font-size:13px;line-height:1}
.gkth-c-title{display:flex;align-items:center;flex-wrap:wrap;gap:4px 10px;font-size:22px;line-height:1.3;font-weight:700;color:var(--gkth-blue)}
.gkth-cover{display:flex;align-items:center;gap:10px;font-size:18px;line-height:1.3;color:var(--gkth-ink)}
.gkth-cover .gkth-i{width:22px;height:22px;flex:0 0 22px;color:var(--gkth-blue)}
.gkth-cover b{font-weight:700}
.gkth-c-foot{margin-top:auto;display:flex;justify-content:space-between;align-items:center;gap:16px;border-top:1px solid var(--gkth-line);padding-top:16px}
.gkth-price small{display:block;font-size:14px;color:var(--gkth-muted);line-height:1.2}
.gkth-price b{display:block;font-size:28px;line-height:1.15;color:var(--gkth-ink);font-weight:700}
.gkth-gsim{margin-top:64px;display:grid;grid-template-columns:480px 480px;gap:20px;align-items:stretch}
.gkth-gmsg{display:flex;flex-direction:column}
.gkth-gh{font-size:28px;line-height:1.3;font-weight:700;color:var(--gkth-blue);max-width:480px}
.gkth-gpts{margin-top:24px;display:flex;flex-direction:column;gap:14px}
.gkth-gpts li{display:flex;align-items:center;gap:14px;min-height:48px;font-weight:700;font-size:17px;line-height:1.35;color:var(--gkth-blue)}
.gkth-gpts li span{flex:0 0 48px;width:48px;height:48px;border-radius:50%;background:var(--gkth-tint);color:var(--gkth-blue);display:grid;place-items:center}
.gkth-gpts li span .gkth-i{width:24px;height:24px}
.gkth-gsim .gkth-card{width:100%}
@media (max-width:1100px){.gkth-gsim{grid-template-columns:1fr;gap:28px}.gkth-gsim .gkth-card{max-width:480px}}

/* ===== BANDING ===== */
.gkth-seg{display:none}
.gkth-vs-grid{margin-top:40px;display:grid;grid-template-columns:1fr 1fr;column-gap:20px;align-items:start}
.gkth-vs-esim{background:var(--gkth-tint2);border-radius:24px;padding-bottom:10px}
.gkth-vs-h{display:flex;align-items:center;min-height:64px;padding:22px 28px 6px}
.gkth-vs-col li{display:flex;align-items:center;gap:16px;min-height:96px;padding:14px 28px}
.gkth-ic{flex:0 0 44px;width:44px;height:44px;border-radius:50%;display:grid;place-items:center}
.gkth-ic .gkth-i{width:22px;height:22px}
.gkth-vs-esim .gkth-ic{background:var(--gkth-blue);color:#fff}
.gkth-vs-sim .gkth-ic{background:#EEF2F5;color:#8A97A3}
.gkth-vs-sim li{border-bottom:1px solid #E3E9EE}
.gkth-vs-sim li:last-child{border-bottom:0}
.gkth-vs-col small{display:block;font-size:14px;line-height:1.3;color:var(--gkth-muted)}
.gkth-vs-esim b{display:block;font-size:17px;line-height:1.35;color:var(--gkth-blue);font-weight:700}
.gkth-val{display:block;font-size:17px;line-height:1.35;color:var(--gkth-muted)}

/* ===== CEK HP ===== */
.gkth-hp-list{margin-top:36px;display:flex;flex-direction:column;gap:16px}
.gkth-hp{background:#fff;border:1px solid var(--gkth-line);border-radius:24px;padding:24px 32px;display:grid;grid-template-columns:240px 1fr;gap:32px;align-items:center;min-height:113px}
.gkth-hp-who{display:flex;align-items:center;gap:14px}
.gkth-ico{flex:0 0 52px;width:52px;height:52px;border-radius:50%;background:var(--gkth-tint);color:var(--gkth-blue);display:grid;place-items:center}
.gkth-ico .gkth-i{width:26px;height:26px}
.gkth-hp-t{font-size:22px;line-height:1.3;color:var(--gkth-blue);font-weight:700}
.gkth-hp-how{border-left:1px solid var(--gkth-line);padding-left:32px;display:flex;flex-direction:column;gap:10px;justify-content:center}
.gkth-path{font-weight:700;font-size:17px;line-height:1.5;color:var(--gkth-ink)}
.gkth-pt{white-space:nowrap}
.gkth-pt-last{color:var(--gkth-blue)}
.gkth-sep{display:inline-block;width:7px;height:7px;border-right:2px solid #8A97A3;border-top:2px solid #8A97A3;transform:rotate(45deg);margin:0 11px 1px 7px}
.gkth-res{display:flex;gap:12px;align-items:flex-start}
.gkth-res-i{flex:0 0 26px;width:26px;height:26px;border-radius:50%;background:var(--gkth-green);color:#fff;display:grid;place-items:center;margin-top:1px}
.gkth-res-i .gkth-i{width:14px;height:14px}

/* ===== AKTIVASI ===== */
.gkth-act{margin-top:40px;display:grid;grid-template-columns:repeat(3,1fr);gap:20px;align-items:stretch}
.gkth-act-c{background:var(--gkth-mist);border-radius:24px;padding:28px;display:flex;flex-direction:column;gap:18px;position:relative}
.gkth-act-top{display:flex;flex-direction:column;gap:16px}
.gkth-num{width:48px;height:48px;border-radius:50%;background:var(--gkth-blue);color:#fff;display:grid;place-items:center;font-weight:700;font-size:20px}
.gkth-act-done .gkth-num{background:var(--gkth-green)}
.gkth-act-t{font-size:22px;line-height:1.3;color:var(--gkth-blue);font-weight:700;min-height:58px}
.gkth-act-p{color:#4A545E}
.gkth-act-c:not(:last-child)::after{content:"";position:absolute;top:52px;left:88px;right:-20px;height:2px;background:repeating-linear-gradient(90deg,#B8C4CE 0 6px,transparent 6px 12px)}

/* ===== MENGAPA ===== */
.gkth-sec--blue{background:var(--gkth-blue);color:#fff;padding:88px 0 96px}
.gkth-sec--blue .gkth-h2{color:#fff;font-size:32px;max-width:none}
.gkth-why{margin-top:40px;display:grid;grid-template-columns:repeat(3,1fr);background:rgba(255,255,255,.09);border:1px solid rgba(255,255,255,.18);border-radius:28px;padding:40px 0}
.gkth-why-c{display:flex;flex-direction:column;align-items:flex-start;gap:20px;padding:0 36px}
.gkth-why-c+.gkth-why-c{border-left:1px solid rgba(255,255,255,.22)}
.gkth-badge{display:inline-grid;place-items:center;min-height:48px;padding:0 24px;border-radius:14px;background:#fff;color:var(--gkth-blue);font-size:22px;line-height:1;font-weight:700;white-space:nowrap}
.gkth-why-t{font-size:20px;line-height:1.35;font-weight:700;color:#fff;min-height:54px}
.gkth-why-p{margin-top:-8px;color:#DCEBF7}

/* ===== TESTIMONI ===== */
.gkth-track-rv>*{flex:0 0 380px}
.gkth-rev{background:var(--gkth-mist);border-radius:24px;padding:26px 26px 24px;display:flex;flex-direction:column;gap:14px}
.gkth-stars{display:flex;gap:3px}
.gkth-stars .gkth-i{width:20px;height:20px;color:var(--gkth-star)}
.gkth-q{margin:0;color:var(--gkth-text)}
.gkth-rev-who{margin-top:auto;padding-top:16px;border-top:1px solid var(--gkth-line)}
.gkth-rev-who b{display:block;font-weight:700;color:var(--gkth-ink)}
.gkth-rev-who span{font-size:14px;color:var(--gkth-muted)}
.gkth-rv-ctrl{display:flex;gap:10px;margin-top:20px}

/* ===== FAQ ===== */
.gkth-faq{margin-top:32px;display:flex;flex-direction:column;gap:12px;max-width:820px}
.gkth-faq-i{background:#fff;border-radius:16px;border:1px solid var(--gkth-line)}
.gkth-faq-i[open]{border-color:var(--gkth-blue)}
.gkth-faq-s{list-style:none;cursor:pointer;display:flex;align-items:center;justify-content:space-between;gap:16px;min-height:56px;padding:14px 20px}
.gkth-faq-s::-webkit-details-marker{display:none}
.gkth-faq-s::after{content:"";flex:0 0 12px;width:12px;height:12px;border-right:2px solid var(--gkth-blue);border-bottom:2px solid var(--gkth-blue);transform:rotate(45deg);transition:transform .2s;margin-top:-4px}
.gkth-faq-i[open] .gkth-faq-s::after{transform:rotate(-135deg);margin-top:4px}
.gkth-faq-q{font-size:16px;line-height:1.4;font-weight:700;color:var(--gkth-ink)}
.gkth-faq-a{padding:0 20px 20px;color:var(--gkth-muted)}
.gkth-faq-p+.gkth-faq-p{margin-top:10px}
.gkth-faq-ol{margin-top:10px;display:flex;flex-direction:column;gap:6px;list-style:decimal;padding-left:20px}
.gkth-faq-ol li{display:list-item}
.gkth-link{color:var(--gkth-blue);font-weight:700}

/* ===== CTA AKHIR ===== */
.gkth-final{background:var(--gkth-blue);color:#fff;padding:88px 0;position:relative;overflow:hidden}
.gkth-final::before{content:"";position:absolute;right:-120px;top:-120px;width:360px;height:360px;border-radius:50%;background:linear-gradient(45deg,#005496 0%,#00ADEE 100%);opacity:.55}
.gkth-final .gkth-wrap{position:relative}
.gkth-final .gkth-h2{color:#fff;font-size:34px;max-width:640px}
.gkth-final-p{margin-top:14px;color:#DCEBF7;max-width:560px}
.gkth-final .gkth-btn{margin-top:28px}

/* ===== MOBILE ===== */
@media (max-width:767px){
  .gkth-wrap{padding:0 20px}
  .gkth-sec{padding:48px 0 56px}
  .gkth-h2{font-size:24px}
  .gkth-hero{height:470px}
  .gkth-hero::before{background:linear-gradient(180deg,rgba(0,35,75,.62) 0%,rgba(0,35,75,.52) 58%,rgba(0,35,75,0) 92%)}
  .gkth-hero-in{padding:0 20px}
  .gkth-hero-top{padding-top:20px}
  .gkth-compat{padding:8px 14px;font-size:14px}
  .gkth-cmp-d{display:none}.gkth-cmp-m{display:inline}
  .gkth-hero-row{flex-direction:column;align-items:flex-start;gap:16px;margin-top:64px}
  .gkth-h1-big{font-size:32px;gap:10px}
  .gkth-hl{padding:0 10px 3px;border-radius:10px}
  .gkth-h1-sub{font-size:18px;margin-top:10px}
  .gkth-chips{justify-content:flex-start;max-width:none;padding-bottom:0}
  .gkth-chip{font-size:14px;padding:7px 12px}
  .gkth-intro{padding:4px 20px 0}
  .gkth-cta-row .gkth-btn{width:100%}
  .gkth-head-row{flex-direction:column;align-items:flex-start;gap:20px}
  .gkth-track{margin:28px -20px 0;padding:4px 20px 10px;gap:14px;scroll-padding:0 20px}
  .gkth-track-pk>*{flex:0 0 min(340px,calc(100vw - 40px))}
  .gkth-card{padding:20px}
  .gkth-c-title{font-size:18px}
  .gkth-price b{font-size:24px}
  .gkth-c-foot .gkth-btn{padding:12px 14px;font-size:15px}
  .gkth-c-foot{gap:10px}
  .gkth-gsim{margin-top:44px;grid-template-columns:1fr;gap:24px}
  .gkth-gmsg{width:min(340px,calc(100vw - 40px))}
  .gkth-gsim .gkth-card{width:min(340px,calc(100vw - 40px))}
  .gkth-gh{font-size:22px}
  .gkth-gpts{margin-top:20px;gap:12px}
  .gkth-gpts li{font-size:16px;gap:12px}
  .gkth-gpts li span{flex:0 0 44px;width:44px;height:44px}
  .gkth-seg{display:flex;margin-top:28px;background:var(--gkth-mist);border-radius:999px;padding:4px;gap:4px}
  .gkth-seg-b{flex:1;display:grid;place-items:center;min-height:48px;border:0;border-radius:999px;background:transparent;font-weight:700;font-size:16px;color:var(--gkth-muted);cursor:pointer}
  .gkth-seg-b[data-gkth-tab="esim"].is-on{background:var(--gkth-blue);color:#fff}
  .gkth-seg-b[data-gkth-tab="sim"].is-on{background:#8A97A3;color:#fff}
  .gkth-vs-grid{display:block;margin-top:8px}
  .gkth-vs-esim{background:none;border-radius:0;padding-bottom:0}
  .gkth-vs-h{display:none}
  .gkth-vs[data-active="esim"] .gkth-vs-sim{display:none}
  .gkth-vs[data-active="sim"] .gkth-vs-esim{display:none}
  .gkth-vs-col li{min-height:0;padding:16px 0;border-bottom:1px solid #E3E9EE}
  .gkth-vs-col li:last-child{border-bottom:0}
  .gkth-vs-esim .gkth-ic{background:var(--gkth-tint);color:var(--gkth-blue)}
  .gkth-val{color:var(--gkth-text)}
  .gkth-hp-list{margin-top:28px;gap:12px}
  .gkth-hp{grid-template-columns:1fr;gap:14px;padding:20px;border-radius:22px;min-height:0;align-items:start}
  .gkth-ico{flex:0 0 44px;width:44px;height:44px}.gkth-ico .gkth-i{width:22px;height:22px}
  .gkth-hp-t{font-size:20px}
  .gkth-hp-how{border-left:0;padding-left:0}
  .gkth-path{font-size:16px}
  .gkth-act{grid-template-columns:1fr;gap:12px;margin-top:28px}
  .gkth-act-c{padding:22px;gap:14px;border-radius:22px}
  .gkth-act-top{flex-direction:row;align-items:center;gap:14px}
  .gkth-num{flex:0 0 44px;width:44px;height:44px;font-size:18px}
  .gkth-act-t{font-size:19px;min-height:0}
  .gkth-act-c:not(:last-child)::after{display:none}
  .gkth-sec--blue{padding:56px 0 60px}
  .gkth-sec--blue .gkth-h2{font-size:26px}
  .gkth-why{display:flex;flex-direction:column;gap:12px;margin-top:26px;background:none;border:0;padding:0}
  .gkth-why-c{background:rgba(255,255,255,.09);border:1px solid rgba(255,255,255,.18);border-radius:20px;padding:20px;gap:14px}
  .gkth-why-c+.gkth-why-c{border-left:1px solid rgba(255,255,255,.18)}
  .gkth-badge{min-height:40px;padding:0 18px;border-radius:12px;font-size:20px}
  .gkth-why-t{font-size:19px;min-height:0}
  .gkth-why-p{margin-top:-4px}
  .gkth-track-rv>*{flex:0 0 min(340px,calc(100vw - 56px))}
  .gkth-faq{margin-top:24px}
  .gkth-final{padding:56px 0}
  .gkth-final .gkth-h2{font-size:26px}
  .gkth-final .gkth-btn{width:100%}
}
@media (max-width:1000px) and (min-width:768px){
  .gkth-act{grid-template-columns:1fr}
  .gkth-act-c:not(:last-child)::after{display:none}
  .gkth-act-t{min-height:0}
  .gkth-why{grid-template-columns:1fr;padding:12px 0}
  .gkth-why-c{padding:24px 36px}
  .gkth-why-c+.gkth-why-c{border-left:0;border-top:1px solid rgba(255,255,255,.22)}
  .gkth-hp{grid-template-columns:200px 1fr}
}
@media (max-width:340px){.gkth-c-foot{flex-wrap:wrap}.gkth-c-foot .gkth-btn{width:100%}}
@media (max-width:380px){.gkth-price b{font-size:21px}.gkth-c-foot .gkth-btn{padding:12px 12px;font-size:14px}}
@media (prefers-reduced-motion:reduce){.gkth-page *{transition:none !important}}

