  <!-- ===== HERO ===== -->
  <section class="gkth-hero-wrap" id="gkth-hero">
    <div class="gkth-hero">
      <img
        class="gkth-hero-img"
        src="{{ hero_img_url }}"
        alt="eSIM Thailand Global Komunika"
        width="1440"
        height="440"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      >
      <div class="gkth-hero-in">
        <div class="gkth-hero-top">
          <a class="gkth-compat" href="{{ section.settings.hero_compat_url | default: '#gkth-cek-hp' }}">
            <svg class="gkth-i" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href="#gkth-i-info"/></svg>
            <span>{{ section.settings.hero_compat_text | default: 'Cek HP Support eSIM' }}</span>
          </a>
        </div>
        <div class="gkth-hero-body">
          {%- if section.settings.hero_title != blank -%}
            <h1 class="gkth-h1">{{ section.settings.hero_title }}</h1>
          {%- else -%}
            <h1 class="gkth-h1"><span class="gkth-h1-big"><span class="gkth-hl">eSIM</span> <span>Thailand<span class="gkth-sr">,</span></span></span>
          <span class="gkth-h1-sub">Internet Praktis untuk Traveling Tanpa Ganti SIM Card</span></h1>
          {%- endif -%}
          {%- if section.settings.hero_sub != blank -%}
            <p class="gkth-hero-lead">{{ section.settings.hero_sub }}</p>
          {%- else -%}
            <p class="gkth-hero-lead">Liburan ke Thailand lebih tenang dengan eSIM dari Global Komunika. QR Code dikirim ke email, langsung aktif saat tiba di Thailand, dan nomor WhatsApp Indonesia tetap aktif.</p>
          {%- endif -%}
          <div class="gkth-hero-foot">
            <div class="gkth-hero-price">
              <span class="gkth-hero-price-lbl">Mulai dari</span>
              <b>{{ section.settings.hero_price | default: 'Rp39.000' }}</b>
            </div>
            <a class="gkth-btn" href="{{ section.settings.hero_btn_url | default: '#gkth-paket' }}">{{ section.settings.hero_btn_text | default: 'Lihat paket' }}</a>
          </div>
        </div>
      </div>
    </div>
  </section>

