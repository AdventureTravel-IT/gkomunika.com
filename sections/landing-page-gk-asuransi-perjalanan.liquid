<script>
(function(){
  var root=document.getElementById('gk-ins-root');
  if(!root) root=document.querySelector('.gk-ins');
  if(!root) return;

  /* Foto: kalau src masih kosong, sembunyikan <img> dan tampilkan placeholder */
  root.querySelectorAll('source[srcset^="LINK_"]').forEach(function(s){ s.removeAttribute('srcset'); });
  root.querySelectorAll('img[data-gk-ins-img]').forEach(function(img){
    var ph=img.parentNode.querySelector('.gk-ins-ph');
    if(!ph) ph=img.parentNode.parentNode.querySelector('.gk-ins-ph');
    var src=img.getAttribute('src')||'';
    if(/^LINK_/.test(src)){ img.removeAttribute('src'); src=''; }
    var has=!!src;
    if(!has){ img.style.display='none'; }
    else if(ph){ ph.style.display='none'; }
  });

  /* Smooth scroll ke carousel produk */
  root.querySelectorAll('[data-gk-ins-scroll]').forEach(function(a){
    a.addEventListener('click',function(e){
      var t=document.querySelector(a.getAttribute('href'));
      if(t){ e.preventDefault(); t.scrollIntoView({behavior:'smooth',block:'start'}); }
    });
  });

  /* Carousel produk (swipe di HP, panah di desktop) */
  var track=document.getElementById('gk-ins-track');
  var prev=document.getElementById('gk-ins-prev');
  var next=document.getElementById('gk-ins-next');
  if(track && prev && next){
    function step(){
      var c=track.querySelector('.gk-ins-card');
      var gap=parseFloat(getComputedStyle(track).columnGap)||16;
      return c? c.offsetWidth+gap : 300;
    }
    function updateNav(){
      prev.disabled = track.scrollLeft<=4;
      next.disabled = track.scrollLeft+track.clientWidth >= track.scrollWidth-4;
    }
    prev.addEventListener('click',function(){ track.scrollBy({left:-step(),behavior:'smooth'}); });
    next.addEventListener('click',function(){ track.scrollBy({left:step(),behavior:'smooth'}); });
    track.addEventListener('scroll',updateNav,{passive:true});
    window.addEventListener('resize',updateNav);
    updateNav();
  }

  /* Testimoni: gandakan kartu supaya loop mulus, kecepatan konstan, jeda saat disentuh */
  var mq=document.getElementById('gk-ins-marquee');
  var mt=document.getElementById('gk-ins-mtrack');
  if(mq && mt){
    var reduce=window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    Array.prototype.slice.call(mt.children).forEach(function(card){
      var c=card.cloneNode(true);
      c.setAttribute('aria-hidden','true');
      c.setAttribute('data-clone','1');
      mt.appendChild(c);
    });
    function setSpeed(){
      var pxPerSec=60;
      var half=mt.scrollWidth/2;
      mt.style.setProperty('--gk-ins-dur',(half/pxPerSec).toFixed(1)+'s');
    }
    setSpeed();
    window.addEventListener('resize',setSpeed);
    if(!reduce){
      mq.addEventListener('touchstart',function(){ mq.classList.add('is-paused'); },{passive:true});
      mq.addEventListener('touchend',function(){ setTimeout(function(){ mq.classList.remove('is-paused'); },1500); },{passive:true});
    }
  }

  /* Sticky CTA: muncul setelah hero lewat, sembunyi saat carousel / CTA penutup terlihat */
  var sticky=document.getElementById('gk-ins-sticky');
  if(sticky){
    var state={hero:true,products:false,final:false};
    function renderSticky(){ sticky.classList.toggle('is-on', !state.hero && !state.products && !state.final); }
    if('IntersectionObserver' in window){
      var io=new IntersectionObserver(function(entries){
        entries.forEach(function(en){
          if(en.target.id==='gk-ins-hero') state.hero=en.isIntersecting;
          if(en.target.id==='gk-ins-products') state.products=en.isIntersecting;
          if(en.target.id==='gk-ins-final') state.final=en.isIntersecting;
        });
        renderSticky();
      },{threshold:0.15});
      ['gk-ins-hero','gk-ins-products','gk-ins-final'].forEach(function(id){
        var el=document.getElementById(id);
        if(el) io.observe(el);
      });
    }
  }
})();
</script>

