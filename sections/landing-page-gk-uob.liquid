<script>
(function () {
  var root = document.getElementById("gkuob-page");
  if (!root) root = document.querySelector(".gkuob-page");
  if (!root) return;

  function fallbackCopy(text) {
    var ta = document.createElement("textarea");
    ta.value = text;
    ta.setAttribute("readonly", "");
    ta.style.position = "fixed";
    ta.style.opacity = "0";
    document.body.appendChild(ta);
    ta.select();
    try { document.execCommand("copy"); } catch (e) {}
    document.body.removeChild(ta);
  }
  Array.prototype.forEach.call(root.querySelectorAll(".gkuob-copy"), function (btn) {
    btn.addEventListener("click", function () {
      var codeEl = btn.parentNode.querySelector("[data-gkuob-code]");
      var text = codeEl ? codeEl.getAttribute("data-gkuob-code") : "";
      if (!text) return;
      var done = function () {
        btn.textContent = "Tersalin";
        btn.setAttribute("data-done", "1");
        setTimeout(function () { btn.textContent = "Salin"; btn.removeAttribute("data-done"); }, 2000);
      };
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(done, function () { fallbackCopy(text); done(); });
      } else { fallbackCopy(text); done(); }
    });
  });

})();
</script>

