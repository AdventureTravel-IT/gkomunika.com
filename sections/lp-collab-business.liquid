<script>
(function () {
  var root = document.getElementById('gkmitra-page-{{ section.id }}');
  if (!root) return;
  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Smooth scroll for anchor links
  var scrollLinks = root.querySelectorAll('[data-gkmitra-scroll]');
  Array.prototype.forEach.call(scrollLinks, function (link) {
    link.addEventListener('click', function (e) {
      var id = link.getAttribute('href');
      var target = id ? document.querySelector(id) : null;
      if (!target) return;
      e.preventDefault();
      target.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
    });
  });

  // Mitra logo slider
  var slider = document.getElementById('gkmitra-slider-{{ section.id }}');
  var track = document.getElementById('gkmitra-track-{{ section.id }}');
  if (slider && track) {
    if (reduce) {
      slider.classList.add('gkmitra-slider-static');
    } else {
      var slides = Array.prototype.slice.call(track.children);
      var total = slides.length;
      if (total > 0) {
        var idx = 0;
        var vis = 0;
        var paused = false;
        var getVis = function () {
          return window.innerWidth >= 1024 ? 4 : (window.innerWidth >= 768 ? 3 : 2);
        };
        var build = function () {
          Array.prototype.slice.call(track.querySelectorAll('[data-gkmitra-clone]')).forEach(function (c) {
            track.removeChild(c);
          });
          vis = getVis();
          for (var k = 0; k < vis; k++) {
            var c = slides[k % total].cloneNode(true);
            c.setAttribute('aria-hidden', 'true');
            c.setAttribute('data-gkmitra-clone', '');
            track.appendChild(c);
          }
          idx = 0;
          track.style.transition = 'none';
          track.style.transform = 'translateX(0)';
        };
        var step = function () {
          if (paused || document.hidden) return;
          idx++;
          track.style.transition = 'transform .6s ease';
          track.style.transform = 'translateX(-' + (idx * 100 / vis) + '%)';
        };
        track.addEventListener('transitionend', function () {
          if (idx >= total) {
            track.style.transition = 'none';
            idx = 0;
            track.style.transform = 'translateX(0)';
          }
        });
        slider.addEventListener('mouseenter', function () { paused = true; });
        slider.addEventListener('mouseleave', function () { paused = false; });
        slider.addEventListener('focusin', function () { paused = true; });
        slider.addEventListener('focusout', function () { paused = false; });
        var resizeTimer = null;
        window.addEventListener('resize', function () {
          clearTimeout(resizeTimer);
          resizeTimer = setTimeout(function () {
            if (getVis() !== vis) build();
          }, 200);
        });
        build();
        setInterval(step, 2000);
      }
    }
  }

  // Cards interactive active border
  var cards = root.querySelectorAll('[data-gkmitra-card]');
  function selectCard(active) {
    Array.prototype.forEach.call(cards, function (card) {
      var on = card === active;
      card.classList.toggle('gkmitra-card-active', on);
      card.setAttribute('aria-current', on ? 'true' : 'false');
    });
  }
  Array.prototype.forEach.call(cards, function (card) {
    card.addEventListener('click', function (e) {
      if (e.target.closest('a')) return;
      selectCard(card);
    });
    card.addEventListener('keydown', function (e) {
      if (e.target !== card) return;
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        selectCard(card);
      }
    });
  });
})();
</script>

