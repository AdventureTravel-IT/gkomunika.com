{% style %}
  :root {
    --header-height: 80px;
  }

  .pages-container {
    max-width: 1920px;
    margin: 0 auto;
  }

  .pages-wrapper {
    display: flex;
    flex-wrap: nowrap;
    padding: 50px 10% 10%;
    gap: 50px;
  }

  .pages-summary {
    position: sticky;
    top: calc(var(--header-height) + 20px);
    align-self: flex-start;
    height: fit-content;
    max-height: calc(60vh - var(--header-height) - 40px);
    overflow: auto;
  }

  .page-summary__wrapper {
    margin: 0;
    padding: 0;
  }

  #summary {
    margin-left: 17px;
    color: var(--color-primary);
    list-style-type: disc;
  }

  #summary li {
    margin-top: 10px;
  }

  #summary li a {
    color: var(--color-primary);
    font-size: var(--font-large);
    transition: transform 0.3s;
    text-decoration: none;
  }
  #summary li a.active {
    color: var(--color-secondary);
  }
  #summary li a:hover {
    color: var(--color-secondary);
  }

  .pages-content {
    flex: 2;
    min-width: 0;
  }

  .pages-content__latest {
    display: flex;
    gap: 20px;
    margin-top: 50px;
  }

  .pages-content__latest > .pages-content__prev-container:only-child,
  .pages-content__latest > .pages-content__next-container:only-child {
    flex: 0 0 55%;
    max-width: 700px;
  }

  .pages-content__prev-container,
  .pages-content__next-container {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .pages-content__prev,
  .pages-content__next {
    flex: 1;
    background-color: var(--color-neutral);
    border-radius: 15px;
    padding: 15px;
    display: flex;
    flex-direction: column;
  }

  .pages-content__next-container h2 {
    text-align: right;
  }

  .pages-content__title {
    font-size: var(--font-supper-large);
    color: var(--color-primary);
    margin: 10px 0;
    line-height: 1.5;
  }

  .pages-content__prev img,
  .pages-content__next img {
    width: 100%;
    height: 200px;
    object-fit: cover;
    aspect-ratio: 3 / 2;
    border-radius: 10px;
    border: 1px solid var(--color-border);
  }

  .pages-content__prev a,
  .pages-content__next a {
    text-decoration: none;
  }

  .page-content__title {
    color: var(--color-primary);
    font-weight: bold;
    font-size: 24px;
    margin-top: 0;
  }

  .pages-content__wrapper {
    background-color: var(--color-neutral);
    padding: 15px 30px;
    border-radius: 15px;
  }

  /* =========================
     SPACING FIX (Y spacing)
     ========================= */
  .pages-article__author {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 15px;
    font-weight: 500;
    color: var(--color-primary);
    margin-top: 10px;
    margin-bottom: 2px;
  }

  .pages-article__author-icon,
  .pages-article__author svg {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    color: var(--color-primary);
  }

  .pages-article__author + .pages-article__date {
    margin-top: 4px;
    margin-bottom: 15px;
  }

  .pages-content__wrapper .pages-article__date {
    margin: 15px 0;
  }

  .pages-content__wrapper .page-content__wrapper {
    margin-top: 16px;
  }

  .page-content__wrapper > * + * {
    margin-top: 14px;
  }

  .page-content__wrapper h2,
  .page-content__wrapper h3 {
    margin-top: 28px;
    margin-bottom: 10px;
  }

  .page-content__wrapper p,
  .page-content__wrapper ul,
  .page-content__wrapper ol {
    margin: 0 0 12px;
    font-size: 16px;
  }

  /* =========================
   LIST (UL/OL) di page content tetap tampil bullet/number
   ========================= */
  .page-content__wrapper ul,
  .page-content__wrapper ol {
    padding-left: 1.25em;
    margin-left: 0;
    list-style-position: outside;
  }

  .page-content__wrapper ul {
    list-style-type: disc !important;
  }

  .page-content__wrapper ol {
    list-style-type: decimal !important;
  }

  .page-content__wrapper li {
    display: list-item;
  }

  .page-content__wrapper ul ul {
    list-style-type: circle !important;
  }
  .page-content__wrapper ul ul ul {
    list-style-type: square !important;
  }

  .page-content__wrapper {
    color: var(--color-primary);
    text-align: left !important;
  }

  .page-content__wrapper ul,
  .page-content__wrapper ol {
    text-align: left !important;
    padding-left: 2.1em !important;
    margin-left: 0 !important;
    list-style-position: outside;
  }

  .page-content__wrapper li {
    text-align: left !important;
    display: list-item;
  }

  .page-content__wrapper p,
  .page-content__wrapper h2,
  .page-content__wrapper h3,
  .page-content__wrapper h4 {
    text-align: left !important;
  }

  .page-content__wrapper h2 {
    color: var(--color-primary);
    font-weight: bold;
    font-size: 20px;
  }

  .page-content__wrapper h3 {
    color: var(--color-primary);
    font-weight: bold;
    font-size: 18px;
  }

  .page-content__wrapper img {
    max-width: 100%;
    height: auto;
    border-radius: 15px;
    cursor: zoom-in;
    display: block;
  }

  .page-content__wrapper a {
    color: #00adee;
    text-decoration: underline;
  }

  .page-content__wrapper a:hover,
  .page-content__wrapper a:focus {
    color: #0084b6;
    text-decoration: underline;
  }

  .pages-title {
    color: var(--color-primary);
    font-size: 22px;
    font-weight: bold;
    margin: 0;
  }

  .pages-article {
    display: flex;
    flex-direction: column;
    gap: 15px;
    flex: 1;
    min-width: 0;
  }

  .pages-article__title {
    margin: 0;
    color: var(--color-primary);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
    font-size: var(--font-extra-large);
    font-weight: bold;
  }

  .pages-article__wrapper {
    display: flex;
    flex-direction: column;
    gap: 15px;
  }

  .related-article {
    background-color: var(--color-neutral);
    border-radius: 15px;
    transition: transform 0.3s ease;
  }

  .related-article:hover {
    transform: translateY(-5px);
    box-shadow: var(--box-shadow);
  }

  .related-article a {
    padding: 10px;
    display: flex;
    gap: 10px;
    text-decoration: none;
  }

  .related-article img {
    width: auto;
    height: 70px;
    aspect-ratio: 3 / 2;
    border-radius: 15px;
    border: 1px solid var(--color-border);
  }

  .pages-article__date {
    margin: 0;
    line-height: 1.5;
    color: var(--color-secondary);
  }

  .image-modal {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .image-modal.is-active {
    opacity: 1;
    visibility: visible;
  }

  .image-modal__inner {
    position: relative;
    max-width: 92vw;
    max-height: 92vh;
    line-height: 0;
    transform: scale(0.88);
    opacity: 0;
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.3s ease;
    border-radius: 12px;
    overflow: visible;
  }

  .image-modal.is-active .image-modal__inner {
    transform: scale(1);
    opacity: 1;
  }

  .image-modal__img {
    display: block;
    max-width: 92vw;
    max-height: 88vh;
    width: auto;
    height: auto;
    border-radius: 12px;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.6), 0 0 0 1px rgba(255, 255, 255, 0.08);
    object-fit: contain;
  }

  .image-modal__caption:empty {
    display: none;
  }

  .image-modal__caption {
    position: absolute;
    bottom: -36px;
    left: 0;
    right: 0;
    text-align: center;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.65);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: 1.4;
  }

  .image-modal__close {
    position: absolute;
    top: -14px;
    right: -14px;
    z-index: 10;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: none;
    background: #ffffff;
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.4);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), background 0.2s ease, box-shadow 0.2s ease;
    padding: 0;
    line-height: 1;
    font-size: 0;
  }

  .image-modal__close::before,
  .image-modal__close::after {
    content: '';
    position: absolute;
    width: 14px;
    height: 1.8px;
    background: #222;
    border-radius: 2px;
    transition: background 0.2s ease;
  }
  .image-modal__close::before {
    transform: rotate(45deg);
  }
  .image-modal__close::after {
    transform: rotate(-45deg);
  }

  .image-modal__close:hover {
    transform: rotate(90deg) scale(1.12);
    background: #f4f4f4;
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.5);
  }

  .page-content__wrapper img {
    cursor: zoom-in;
    transition: opacity 0.2s ease, transform 0.3s ease;
  }

  .page-content__wrapper img:hover {
    opacity: 0.92;
  }

  @media (max-width: 768px) {
    .image-modal {
      padding: 16px;
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
    }

    .image-modal__img {
      max-width: 96vw;
      max-height: 80vh;
      border-radius: 10px;
    }

    .image-modal__close {
      top: -12px;
      right: -12px;
      width: 34px;
      height: 34px;
    }

    .image-modal__close::before,
    .image-modal__close::after {
      width: 12px;
    }
  }

  /* =========================
     MOBILE / RESPONSIVE LAYOUT
     ========================= */
  @media (max-width: 1024px) {
    .pages-wrapper {
      flex-direction: column;
    }

    .pages-summary,
    .pages-content,
    .pages-article {
      width: 100%;
      position: static;
    }
  }

  @media (max-width: 768px) {
    .page-content__title {
      font-size: 20px;
    }

    .pages-wrapper {
      flex-direction: column;
      padding: 60px 16px 50px;
      gap: 1px;
    }

    .pages-content__wrapper {
      padding: 15px 16px;
      max-width: 100%;
      box-sizing: border-box;
    }

    .pages-content__latest {
      display: flex;
      flex-direction: column;
    }

    .pages-content__next-container h2 {
      text-align: left;
    }

    .pages-summary {
      display: none;
    }

    .image-modal__inner {
      padding: 8px;
    }
  }

  .pages-content__wrapper .page-content__wrapper {
    padding-left: 10px;
    padding-right: 10px;
  }

  .pages-content__wrapper .page-content__wrapper ul,
  .pages-content__wrapper .page-content__wrapper ol {
    padding-left: 2.1em !important;
    margin-left: 0 !important;
    list-style-position: outside;
  }

  .pages-content__wrapper .page-content__wrapper li {
    margin: 6px 0;
  }

  .pages-content__wrapper .page-content__wrapper img {
    margin: 12px auto;
  }

  @media (max-width: 768px) {
    .pages-content__wrapper .page-content__wrapper {
      padding-left: 12px;
      padding-right: 12px;
    }

    .pages-content__wrapper .page-content__wrapper ul,
    .pages-content__wrapper .page-content__wrapper ol {
      padding-left: 2.2em !important;
    }
  }

  .pages-container,
  .pages-wrapper,
  .pages-content,
  .pages-content__wrapper,
  .page-content__wrapper {
    max-width: 100%;
    box-sizing: border-box;
  }

  .pages-wrapper,
  .pages-content__wrapper {
    overflow: visible;
  }

  .page-content__wrapper {
    overflow-x: hidden;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .page-content__wrapper table {
    width: 100%;
    max-width: 100%;
    border-collapse: collapse;
    margin: 16px 0;
  }

  .page-content__wrapper th,
  .page-content__wrapper td {
    border: 1px solid var(--color-border) !important;
    padding: 10px 12px;
    vertical-align: top;
  }

  .page-content__wrapper th {
    font-weight: 700;
  }

  @media (max-width: 768px) {
    .page-content__wrapper table {
      display: block;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }
  }

  .pages-content__prev a,
  .pages-content__next a {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .pages-content__prev .pages-article__title,
  .pages-content__next .pages-article__title {
    margin: 0 0 8px;
  }

  .pages-content__prev .pages-article__date,
  .pages-content__next .pages-article__date {
    margin: 0;
  }
{% endstyle %}

<div class="pages-container">
  <div class="pages-wrapper">
    <section class="pages-content">
      <div class="pages-content__wrapper">
        <h1 class="page-content__title">{{ article.title | escape }}</h1>
        {%- assign article_author = article.metafields.custom.author.value
          | default: article.metafields.pages.author.value
          | default: article.metafields.custom.author
          | default: article.metafields.pages.author
          | default: article.author
          | strip
        -%}
        {%- if article_author != blank -%}
          <div class="pages-article__author">
            {% render 'icon-profile', class: 'pages-article__author-icon' %}
            <span>{{ article_author }}</span>
          </div>
        {%- endif -%}
        <h2 class="pages-article__date">{{ article.published_at | date: '%d %B %Y' }}</h2>
        <div class="page-content__wrapper">
          {%- if section.settings.show_featured_image and article.image -%}
            <div style="margin-bottom: 24px;">
              <img
                src="{{ article.image | image_url: width: 1200 }}"
                alt="{{ article.image.alt | default: article.title | escape }}"
                style="width: 100%; height: auto; max-height: 520px; object-fit: cover; border-radius: 15px;"
                loading="eager"
              >
            </div>
          {%- endif -%}
          {{ article.content }}
        </div>
      </div>

      <div class="pages-content__latest">
        {%- assign prev_post = null -%}
        {%- assign next_post = null -%}
        {%- assign current_found = false -%}
        {%- for a in blog.articles -%}
          {%- if a.id == article.id -%}
            {%- assign current_found = true -%}
          {%- elsif current_found and next_post == null -%}
            {%- assign next_post = a -%}
            {%- break -%}
          {%- elsif current_found == false -%}
            {%- assign prev_post = a -%}
          {%- endif -%}
        {%- endfor -%}

        {%- if prev_post != null -%}
          <div class="pages-content__prev-container">
            <h2 class="pages-content__title">Previous Article</h2>
            <div class="pages-content__prev">
              <a href="{{ prev_post.url }}">
                {%- assign prev_img = null -%}
                {%- if prev_post.image -%}
                  {%- assign prev_img = prev_post.image | image_url: width: 400 -%}
                {%- else -%}
                  {%- assign img_parts = prev_post.content | split: '<img' -%}
                  {%- if img_parts.size > 1 -%}
                    {%- assign src_parts = img_parts[1] | split: 'src="' -%}
                    {%- if src_parts.size > 1 -%}
                      {%- assign prev_img = src_parts[1] | split: '"' | first -%}
                    {%- endif -%}
                  {%- endif -%}
                {%- endif -%}

                {%- if prev_img and prev_img contains 'http' -%}
                  <img src="{{ prev_img }}" alt="{{ prev_post.title | escape }}">
                {%- endif -%}
                <div>
                  <h3 class="pages-article__title" title="{{ prev_post.title | escape }}">{{ prev_post.title }}</h3>
                  <p class="pages-article__date">{{ prev_post.published_at | date: '%d %B %Y' }}</p>
                </div>
              </a>
            </div>
          </div>
        {%- endif -%}

        {%- if next_post != null -%}
          <div class="pages-content__next-container">
            <h2 class="pages-content__title">Next Article</h2>
            <div class="pages-content__next">
              <a href="{{ next_post.url }}">
                {%- assign next_img = null -%}
                {%- if next_post.image -%}
                  {%- assign next_img = next_post.image | image_url: width: 400 -%}
                {%- else -%}
                  {%- assign img_parts = next_post.content | split: '<img' -%}
                  {%- if img_parts.size > 1 -%}
                    {%- assign src_parts = img_parts[1] | split: 'src="' -%}
                    {%- if src_parts.size > 1 -%}
                      {%- assign next_img = src_parts[1] | split: '"' | first -%}
                    {%- endif -%}
                  {%- endif -%}
                {%- endif -%}

                {%- if next_img and next_img contains 'http' -%}
                  <img src="{{ next_img }}" alt="{{ next_post.title | escape }}">
                {%- endif -%}
                <div>
                  <h3 class="pages-article__title" title="{{ next_post.title | escape }}">{{ next_post.title }}</h3>
                  <p class="pages-article__date">{{ next_post.published_at | date: '%d %B %Y' }}</p>
                </div>
              </a>
            </div>
          </div>
        {%- endif -%}
      </div>
    </section>

    <section class="pages-article">
      {%- assign rel_count = 0 -%}
      {%- for rel in blog.articles -%}
        {%- if rel.id != article.id -%}
          {%- assign rel_count = rel_count | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}

      {%- if rel_count > 0 -%}
        <h2 class="pages-title">Related Articles</h2>
        <div class="pages-article__wrapper">
          {%- assign shown = 0 -%}
          {%- for rel in blog.articles -%}
            {%- if rel.id == article.id -%}{%- continue -%}{%- endif -%}
            {%- if shown >= 4 -%}{%- break -%}{%- endif -%}
            {%- assign shown = shown | plus: 1 -%}
            {%- assign rel_img = null -%}
            {%- if rel.image -%}
              {%- assign rel_img = rel.image | image_url: width: 300 -%}
            {%- else -%}
              {%- assign img_parts = rel.content | split: '<img' -%}
              {%- if img_parts.size > 1 -%}
                {%- assign src_parts = img_parts[1] | split: 'src="' -%}
                {%- if src_parts.size > 1 -%}
                  {%- assign rel_img = src_parts[1] | split: '"' | first -%}
                {%- endif -%}
              {%- endif -%}
            {%- endif -%}
            <div class="related-article">
              <a href="{{ rel.url }}">
                {%- if rel_img and rel_img contains 'http' -%}
                  <img src="{{ rel_img }}" alt="{{ rel.title | escape }}">
                {%- endif -%}
                <div>
                  <h3 class="pages-article__title" title="{{ rel.title | escape }}">{{ rel.title }}</h3>
                  <h3 class="pages-article__date">{{ rel.published_at | date: '%d %B %Y' }}</h3>
                </div>
              </a>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <section class="pages-summary">
        <h2 class="pages-title">Article Summary</h2>
        <ul id="summary" class="page-summary__wrapper"></ul>
      </section>
    </section>
  </div>
</div>

<div id="imageModal" class="image-modal" role="dialog" aria-modal="true" aria-label="Image preview" aria-hidden="true">
  <div class="image-modal__inner">
    <button type="button" class="image-modal__close" aria-label="Tutup preview gambar"></button>
    <img src="" alt="" class="image-modal__img">
    <p class="image-modal__caption"></p>
  </div>
</div>

<script type="application/ld+json">
  {{ article | structured_data }}
</script>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const headings = document.querySelectorAll('.page-content__wrapper h2');
    const summary = document.getElementById('summary');
    const summarySection = document.querySelector('.pages-summary');

    const modal = document.getElementById('imageModal');
    const modalImg = modal ? modal.querySelector('.image-modal__img') : null;
    const modalCaption = modal ? modal.querySelector('.image-modal__caption') : null;
    const modalCloseBtn = modal ? modal.querySelector('.image-modal__close') : null;

    headings.forEach((heading, i) => {
      const id = `section-${i}`;
      heading.id = id;
      if (summary) {
        summary.innerHTML += `<li><a href="#${id}">${heading.textContent}</a></li>`;
      }
    });

    if (summary && summary.children.length === 0 && summarySection) {
      summarySection.style.display = 'none';
    }

    const links = summary ? summary.querySelectorAll('a') : [];

    links.forEach((link) => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        links.forEach((l) => l.classList.remove('active'));
        link.classList.add('active');
        const target = document.querySelector(link.getAttribute('href'));
        if (target) {
          target.scrollIntoView({ behavior: 'smooth' });
        }
      });
    });

    const observerOptions = {
      root: null,
      rootMargin: '0px 0px -60% 0px',
      threshold: 0,
    };

    if (headings.length && summary) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          const id = entry.target.id;
          const tocLink = summary.querySelector(`a[href="#${id}"]`);

          if (entry.isIntersecting) {
            links.forEach((l) => l.classList.remove('active'));
            if (tocLink) tocLink.classList.add('active');
          }
        });
      }, observerOptions);

      headings.forEach((heading) => observer.observe(heading));
    }

    if (modal && modalImg) {
      const articleImages = document.querySelectorAll('.page-content__wrapper img');

      articleImages.forEach((img) => {
        img.addEventListener('click', () => {
          const src = img.getAttribute('src');
          const alt = img.getAttribute('alt') || '';

          modalImg.src = src;
          modalImg.alt = alt;
          if (modalCaption) {
            modalCaption.textContent = alt;
          }

          modal.classList.add('is-active');
          document.body.style.overflow = 'hidden';
        });
      });

      const closeModal = () => {
        modal.classList.remove('is-active');
        document.body.style.overflow = '';
        modalImg.src = '';
      };

      if (modalCloseBtn) {
        modalCloseBtn.addEventListener('click', closeModal);
      }

      modal.addEventListener('click', (e) => {
        if (e.target === modal) {
          closeModal();
        }
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && modal.classList.contains('is-active')) {
          closeModal();
        }
      });
    }
  });
</script>

<script>
  (function () {
    const localeRootRaw = {{ request.locale.root_url | json }};
    const primaryHostRaw = {{ shop.primary_domain.host | json }};

    function normalizeLocaleRoot(root) {
      if (!root || root === '/') return '';
      return root.replace(/\/+$/, '');
    }

    const localeRoot = normalizeLocaleRoot(localeRootRaw);

    function normalizeHost(host) {
      return (host || '').replace(/^www\./, '').toLowerCase();
    }

    function isInternalUrl(url) {
      const linkHost = normalizeHost(url.hostname);
      const currentHost = normalizeHost(window.location.hostname);
      const primaryHost = normalizeHost(primaryHostRaw);

      return !linkHost || linkHost === currentHost || linkHost === primaryHost;
    }

    function hasLocalePrefix(pathname) {
      if (!localeRoot) return false;
      return pathname === localeRoot || pathname.startsWith(localeRoot + '/');
    }

    function buildLocalizedPath(pathname) {
      if (!pathname.startsWith('/')) {
        pathname = '/' + pathname;
      }

      if (!localeRoot || hasLocalePrefix(pathname)) {
        return pathname;
      }

      return localeRoot + pathname;
    }

    function applyContentLinkRules() {
      const container = document.querySelector('.page-content__wrapper');
      if (!container) return;

      container.querySelectorAll('a[href]').forEach((link) => {
        const rawHref = (link.getAttribute('href') || '').trim();

        if (
          !rawHref ||
          rawHref.startsWith('#') ||
          rawHref.startsWith('javascript:') ||
          rawHref.startsWith('mailto:') ||
          rawHref.startsWith('tel:')
        ) {
          return;
        }

        let url;

        try {
          url = new URL(rawHref, window.location.origin);
        } catch (e) {
          return;
        }

        if (isInternalUrl(url)) {
          const localizedPath = buildLocalizedPath(url.pathname);
          link.setAttribute('href', localizedPath + url.search + url.hash);
        }

        link.setAttribute('target', '_blank');
        link.setAttribute('rel', 'noopener noreferrer');
      });
    }

    function initContentLinkRules() {
      applyContentLinkRules();

      const container = document.querySelector('.page-content__wrapper');
      if (!container || container.dataset.linkRulesObserverAttached === 'true') return;

      const mo = new MutationObserver(() => applyContentLinkRules());
      mo.observe(container, { childList: true, subtree: true });
      container.dataset.linkRulesObserverAttached = 'true';
    }

    document.addEventListener('DOMContentLoaded', initContentLinkRules);
    document.addEventListener('shopify:section:load', initContentLinkRules);
  })();
</script>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const contentWrapper = document.querySelector('.page-content__wrapper');
    if (!contentWrapper) return;

    function cleanNbsp(node) {
      if (node.nodeType === Node.TEXT_NODE) {
        node.textContent = node.textContent.replace(/\u00A0/g, ' ').trim()
          ? node.textContent.replace(/\u00A0/g, ' ')
          : node.textContent;
      } else {
        node.childNodes.forEach(cleanNbsp);
      }
    }

    cleanNbsp(contentWrapper);
  });
</script>

