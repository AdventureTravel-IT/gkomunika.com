{%- assign is_au = false -%}
{%- if request.path contains '/en-au' -%}
  {%- assign is_au = true -%}
{%- endif -%}

<div class="container">
  <div class="wrapper md:wrapper-base">
    {%- assign all_collection = collections.all -%}

    {%- assign country_map = '' -%}
    {%- assign region_map = '' -%}

    {%- comment -%}
      Detect language:
      - English => use entry.country & reg.region
      - Indonesian => use entry.country_id & reg.region_id
    {%- endcomment -%}
    {%- assign current_lang = request.locale.iso_code | default: localization.language.iso_code | downcase -%}
    {%- assign is_en = false -%}
    {%- if current_lang contains 'en' -%}
      {%- assign is_en = true -%}
    {%- endif -%}

    {%- assign display_mode = section.settings.country_mode | default: 'all' -%}

    {%- paginate all_collection.products by 250 -%}
      {%- for product in all_collection.products -%}
        {%- assign key_list = product.metafields.search.key.value -%}
        {%- assign p_price = product.price_min | plus: 0 -%}

        {%- if key_list != blank -%}
          {%- for entry in key_list -%}
            {%- comment -%}
              ==========================
                LAND (COUNTRY)
              ===========================
            {%- endcomment -%}
            {%- assign c_en = entry.country.value | strip -%}
            {%- assign c_id = entry.country_id.value | strip -%}
            {%- assign c_flag = entry.flag.value | strip -%}

            {%- assign c_key_compare = c_en -%}
            {%- if c_key_compare == blank -%}
              {%- assign c_key_compare = c_id -%}
            {%- endif -%}

            {%- if c_key_compare != blank -%}
              {%- assign found = false -%}
              {%- assign new_map = '' -%}

              {%- if country_map != '' -%}
                {%- assign pairs = country_map | split: '||' -%}
                {%- for pair in pairs -%}
                  {%- if pair != blank -%}
                    {%- assign parts = pair | split: '::' -%}
                    {%- assign old_en = parts[0] | strip -%}
                    {%- assign old_id = parts[1] | strip -%}
                    {%- assign old_price = parts[2] | plus: 0 -%}
                    {%- assign old_flag = parts[3] | strip -%}

                    {%- assign old_key_compare = old_en -%}
                    {%- if old_key_compare == blank -%}
                      {%- assign old_key_compare = old_id -%}
                    {%- endif -%}

                    {%- if old_key_compare == c_key_compare -%}
                      {%- assign found = true -%}

                      {%- if p_price < old_price -%}
                        {%- assign old_price = p_price -%}
                      {%- endif -%}

                      {%- if old_en == blank and c_en != blank -%}
                        {%- assign old_en = c_en -%}
                      {%- endif -%}
                      {%- if old_id == blank and c_id != blank -%}
                        {%- assign old_id = c_id -%}
                      {%- endif -%}

                      {%- if old_flag == blank and c_flag != blank -%}
                        {%- assign old_flag = c_flag -%}
                      {%- endif -%}
                    {%- endif -%}

                    {%- assign new_map = new_map
                      | append: old_en
                      | append: '::'
                      | append: old_id
                      | append: '::'
                      | append: old_price
                      | append: '::'
                      | append: old_flag
                      | append: '||'
                    -%}
                  {%- endif -%}
                {%- endfor -%}
                {%- assign country_map = new_map -%}
              {%- endif -%}

              {%- if found == false -%}
                {%- assign country_map = country_map
                  | append: c_en
                  | append: '::'
                  | append: c_id
                  | append: '::'
                  | append: p_price
                  | append: '::'
                  | append: c_flag
                  | append: '||'
                -%}
              {%- endif -%}
            {%- endif -%}

            {%- comment -%}
              ==========================
                REGION (Metaobject Region)
              ===========================
            {%- endcomment -%}
            {%- assign region_list = entry.region.value -%}
            {%- assign entry_region_flag = entry.region_flag.value | strip -%}

            {%- if region_list != blank -%}
              {%- for reg in region_list -%}
                {%- assign r_en = reg.region.value | strip -%}
                {%- assign r_id = reg.region_id.value | strip -%}

                {%- assign r_flag = reg.region_flag.value | strip -%}
                {%- if r_flag == blank and entry_region_flag != blank -%}
                  {%- assign r_flag = entry_region_flag -%}
                {%- endif -%}

                {%- assign r_key_compare = r_en -%}
                {%- if r_key_compare == blank -%}
                  {%- assign r_key_compare = r_id -%}
                {%- endif -%}

                {%- if r_key_compare != blank -%}
                  {%- assign r_found = false -%}
                  {%- assign r_new_map = '' -%}

                  {%- if region_map != '' -%}
                    {%- assign r_pairs = region_map | split: '||' -%}
                    {%- for r_pair in r_pairs -%}
                      {%- if r_pair != blank -%}
                        {%- assign r_parts = r_pair | split: '::' -%}
                        {%- assign old_r_en = r_parts[0] | strip -%}
                        {%- assign old_r_id = r_parts[1] | strip -%}
                        {%- assign old_r_price = r_parts[2] | plus: 0 -%}
                        {%- assign old_r_flag = r_parts[3] | strip -%}

                        {%- assign old_r_key_compare = old_r_en -%}
                        {%- if old_r_key_compare == blank -%}
                          {%- assign old_r_key_compare = old_r_id -%}
                        {%- endif -%}

                        {%- if old_r_key_compare == r_key_compare -%}
                          {%- assign r_found = true -%}

                          {%- if p_price < old_r_price -%}
                            {%- assign old_r_price = p_price -%}
                          {%- endif -%}

                          {%- if old_r_en == blank and r_en != blank -%}
                            {%- assign old_r_en = r_en -%}
                          {%- endif -%}
                          {%- if old_r_id == blank and r_id != blank -%}
                            {%- assign old_r_id = r_id -%}
                          {%- endif -%}

                          {%- if old_r_flag == blank and r_flag != blank -%}
                            {%- assign old_r_flag = r_flag -%}
                          {%- endif -%}
                        {%- endif -%}

                        {%- assign r_new_map = r_new_map
                          | append: old_r_en
                          | append: '::'
                          | append: old_r_id
                          | append: '::'
                          | append: old_r_price
                          | append: '::'
                          | append: old_r_flag
                          | append: '||'
                        -%}
                      {%- endif -%}
                    {%- endfor -%}
                    {%- assign region_map = r_new_map -%}
                  {%- endif -%}

                  {%- if r_found == false -%}
                    {%- assign region_map = region_map
                      | append: r_en
                      | append: '::'
                      | append: r_id
                      | append: '::'
                      | append: p_price
                      | append: '::'
                      | append: r_flag
                      | append: '||'
                    -%}
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      {%- endfor -%}

      {% if template.name != 'index' %}
        <div class="w-full lg:max-w-[50%] mt-[20px] mb-[50px] md:mt-[100px] md:mb-[100px] space-y-5">
          <div class="mb-5 space-y-5">
            <h2 class="text-[36px] font-bold text-primary">All Destinations</h2>
            <p class="text-primary text-[18px] tracking-wider leading-normal">
              Find the perfect Internet Data for your travel and enjoy internet connection for more than 150 Countries
            </p>
          </div>

          {% render 'search-bar' %}
        </div>
      {% endif %}

      <div class="gkh-wrap" data-popular-countries>
        {% if template.name == 'index' %}
          <h2 class="gkh-title">{{ 'homepage.popular_country.heading' | t }}</h2>
        {% else %}
          <h1 class="gkh-title">{{ 'homepage.popular_country.heading_all' | t }}</h1>
        {% endif %}

        <div class="gkh-tabs" role="tablist">
          <button type="button" class="gkh-tab gkh-is-active" role="tab" aria-selected="true" data-gkh-tab="land">
            {{ 'homepage.popular_country.details.button_land' | t }}
          </button>
          <button type="button" class="gkh-tab" role="tab" aria-selected="false" data-gkh-tab="region">
            {{ 'homepage.popular_country.details.button_region' | t }}
          </button>
        </div>

        {%- comment -%}
          ==========================
            PANEL: LAND
          ===========================
        {%- endcomment -%}
        <div class="gkh-panel" data-gkh-panel="land">
          {%- assign display_map = '' -%}
          {%- assign pairs = country_map | split: '||' -%}

          {%- for pair in pairs -%}
            {%- if pair != blank -%}
              {%- assign parts = pair | split: '::' -%}
              {%- assign country_en_out = parts[0] | strip -%}
              {%- assign country_id_out = parts[1] | strip -%}
              {%- assign min_price = parts[2] | plus: 0 -%}
              {%- assign flag_out = parts[3] | strip -%}

              {%- assign display_name = country_id_out -%}
              {%- if is_en -%}{%- assign display_name = country_en_out -%}{%- endif -%}

              {%- if display_name == blank -%}{%- assign display_name = country_en_out -%}{%- endif -%}
              {%- if display_name == blank -%}{%- assign display_name = country_id_out -%}{%- endif -%}

              {%- assign display_map = display_map
                | append: display_name
                | append: '::'
                | append: min_price
                | append: '::'
                | append: flag_out
                | append: '||'
              -%}
            {%- endif -%}
          {%- endfor -%}

          <div class="gkh-grid-c">
            {%- assign display_pairs = display_map | split: '||' | sort -%}

            {%- if display_mode == 'top' -%}
              {%- assign top_countries_data = 'Singapore:::https://gkomunika.com/cdn/shop/files/Singapore.svg?v=5285233666947339274:::Rp 20.000|Malaysia:::https://gkomunika.com/cdn/shop/files/Malaysia.svg?v=12842823618677623280:::Rp 20.000|Thailand:::https://gkomunika.com/cdn/shop/files/Thailand.svg?v=16773415897375716824:::Rp 29.000|China:::https://gkomunika.com/cdn/shop/files/China.svg?v=5412872211976829782:::Rp 20.000|Japan:::https://gkomunika.com/cdn/shop/files/Japan.svg?v=9947011595981139404:::Rp 19.000|South Korea:::https://gkomunika.com/cdn/shop/files/South_Korea.svg?v=13655143242951941689:::Rp 29.000|Australia:::https://cdn.shopify.com/s/files/1/0735/4204/1817/files/Flag_of_Australia.jpg?v=1792734139:::Rp 19.000|Europe:::https://gkomunika.com/cdn/shop/files/Europe_Top.svg?v=1482087602594110665:::Rp 79.000|Saudi Arabia:::https://gkomunika.com/cdn/shop/files/Saudi_Arabia.svg?v=14176695740459012418:::Rp 29.000|Hong Kong:::https://gkomunika.com/cdn/shop/files/Hong_Kong.svg?v=5890400936816029061:::Rp 19.000|Vietnam:::https://gkomunika.com/cdn/shop/files/Vietnam.svg?v=12664013080022461533:::Rp 20.000|Taiwan:::https://gkomunika.com/cdn/shop/files/Taiwan.svg?v=6301535944797681651:::Rp 19.000' | split: '|' -%}

              {%- for top_item in top_countries_data -%}
                {%- assign top_fields = top_item | split: ':::' -%}
                {%- assign top_name = top_fields[0] -%}
                {%- assign fallback_flag = top_fields[1] -%}
                {%- assign fallback_price = top_fields[2] -%}

                {%- assign top_key = top_name | strip | downcase | replace: '_', ' ' | replace: '-', ' ' | replace: ' ', '' -%}

                {%- assign dynamic_price = 0 -%}
                {%- assign dynamic_flag = '' -%}
                {%- assign found_item = false -%}

                {%- for item in display_pairs -%}
                  {%- if item != blank and found_item == false -%}
                    {%- assign parts = item | split: '::' -%}
                    {%- assign item_name = parts[0] | strip -%}
                    {%- assign item_price = parts[1] | plus: 0 -%}
                    {%- assign item_flag = parts[2] | strip -%}

                    {%- assign item_compact = item_name | strip | downcase | replace: 'taiwam', 'taiwan' | replace: '_', ' ' | replace: '-', ' ' | replace: ' ', '' -%}

                    {%- if item_compact == top_key -%}
                      {%- assign found_item = true -%}
                      {%- assign dynamic_price = item_price -%}
                      {%- if item_flag != blank -%}
                        {%- assign dynamic_flag = item_flag | split: '/' | last | file_url -%}
                      {%- endif -%}
                    {%- endif -%}
                  {%- endif -%}
                {%- endfor -%}

                {%- assign flag_src = fallback_flag -%}
                {%- if dynamic_flag != blank -%}
                  {%- assign flag_src = dynamic_flag -%}
                {%- endif -%}

                {%- assign price_display = fallback_price -%}
                {%- if dynamic_price > 0 -%}
                  {%- assign price_display = dynamic_price | money_with_currency -%}
                  {%- if is_au -%}{%- assign price_display = price_display | append: ' AUD' -%}{%- endif -%}
                {%- endif -%}

                <a
                  href="{{ routes.search_url }}?q={{ top_name | replace: '_', ' ' | url_encode }}"
                  class="gkh-country"
                >
                  <div class="gkh-country__l">
                    <div class="gkh-country__flag">
                      <img
                        src="{{ flag_src }}"
                        width="50"
                        height="50"
                        alt="{{ top_name }}"
                        loading="lazy"
                      >
                    </div>
                    <div>
                      <span class="gkh-country__name">{{ top_name }}</span>
                      <p class="gkh-country__price">Start From {{ price_display }}</p>
                    </div>
                  </div>

                  <svg class="gkh-country__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
                </a>
              {%- endfor -%}

            {%- else -%}
              {%- for item in display_pairs -%}
                {%- if item != blank -%}
                  {%- assign parts = item | split: '::' -%}
                  {%- assign country_name = parts[0] | strip -%}
                  {%- assign min_price = parts[1] | plus: 0 -%}
                  {%- assign flag_out = parts[2] | strip -%}

                  {%- if flag_out != blank -%}
                    <a
                      href="{{ routes.search_url }}?q={{ country_name | replace: '_', ' ' | url_encode }}"
                      class="gkh-country"
                    >
                      {%- assign flag_filename = flag_out | split: '/' | last -%}
                      <div class="gkh-country__l">
                        <div class="gkh-country__flag">
                          <img
                            src="{{ flag_filename | file_url }}"
                            width="50"
                            height="50"
                            alt="{{ country_name }}"
                            loading="lazy"
                          >
                        </div>
                        <div>
                          <span class="gkh-country__name">
                            {{- country_name | replace: '_', ' ' -}}
                          </span>
                          <p class="gkh-country__price">Start From {{ min_price | money_with_currency }}{% if is_au %} AUD{% endif %}</p>
                        </div>
                      </div>

                      <svg class="gkh-country__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
                    </a>
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}
          </div>
        </div>

        {%- comment -%}
          ==========================
            PANEL: REGION
          ===========================
        {%- endcomment -%}
        <div class="gkh-panel" data-gkh-panel="region" hidden>
          {%- assign region_display_map = '' -%}
          {%- assign r_pairs = region_map | split: '||' -%}

          {%- for r_pair in r_pairs -%}
            {%- if r_pair != blank -%}
              {%- assign r_parts = r_pair | split: '::' -%}
              {%- assign region_en_out = r_parts[0] | strip -%}
              {%- assign region_id_out = r_parts[1] | strip -%}
              {%- assign min_price = r_parts[2] | plus: 0 -%}
              {%- assign reg_flag_out = r_parts[3] | strip -%}

              {%- assign region_name = region_id_out -%}
              {%- if is_en -%}{%- assign region_name = region_en_out -%}{%- endif -%}

              {%- if region_name == blank -%}{%- assign region_name = region_en_out -%}{%- endif -%}
              {%- if region_name == blank -%}{%- assign region_name = region_id_out -%}{%- endif -%}

              {%- assign region_display_map = region_display_map
                | append: region_name
                | append: '::'
                | append: min_price
                | append: '::'
                | append: reg_flag_out
                | append: '||'
              -%}
            {%- endif -%}
          {%- endfor -%}

          <div class="gkh-grid-c">
            {%- assign region_display_pairs = region_display_map | split: '||' | sort -%}

            {%- assign fallback_regions_data = 'Africa:::https://cdn.shopify.com/s/files/1/0735/4204/1817/files/Afrika.png?v=1792734174:::Rp 29.000|Asia:::https://cdn.shopify.com/s/files/1/0735/4204/1817/files/Asia.png?v=1792734174:::Rp 19.000|Central America:::https://cdn.shopify.com/s/files/1/0735/4204/1817/files/Amerika_Tengah.png?v=1792734170:::Rp 109.000|Central Asia:::https://cdn.shopify.com/s/files/1/0735/4204/1817/files/Asia_Tengah.png?v=1792734174:::Rp 19.000|East Asia:::https://cdn.shopify.com/s/files/1/0735/4204/1817/files/Asia_Timur.png?v=1792734174:::Rp 19.000|Eastern Asia:::https://cdn.shopify.com/s/files/1/0735/4204/1817/files/eastern_asia.png?v=1792734174:::Rp 79.000|Europe:::https://cdn.shopify.com/s/files/1/0735/4204/1817/files/Europe.png?v=1792734175:::Rp 19.000|Middle East:::https://cdn.shopify.com/s/files/1/0735/4204/1817/files/Timur_Tengah.png?v=1792734175:::Rp 19.000|North Africa:::https://cdn.shopify.com/s/files/1/0735/4204/1817/files/Afrika_utara.png?v=1792734173:::Rp 20.000|North America:::https://cdn.shopify.com/s/files/1/0735/4204/1817/files/Amerika_Utara.png?v=1792734174:::Rp 19.000|Oceania:::https://cdn.shopify.com/s/files/1/0735/4204/1817/files/Osenia.png?v=1792734169:::Rp 19.000|South America:::https://cdn.shopify.com/s/files/1/0735/4204/1817/files/Amerika_Selatan.png?v=1792734169:::Rp 20.000|South Asia:::https://cdn.shopify.com/s/files/1/0735/4204/1817/files/Asia_Selatan.png?v=1792734171:::Rp 19.000|Southeast Asia:::https://cdn.shopify.com/s/files/1/0735/4204/1817/files/Asia_Tenggara.png?v=1792734174:::Rp 19.000|West Africa:::https://cdn.shopify.com/s/files/1/0735/4204/1817/files/Afrika_Barat.png?v=1792734173:::Rp 20.000' | split: '|' -%}

            {%- for r_item in fallback_regions_data -%}
              {%- assign r_fields = r_item | split: ':::' -%}
              {%- assign r_name = r_fields[0] -%}
              {%- assign r_flag_fallback = r_fields[1] -%}
              {%- assign r_price_fallback = r_fields[2] -%}

              {%- assign r_key = r_name | strip | downcase | replace: '_', ' ' | replace: '-', ' ' | replace: ' ', '' -%}
              {%- assign r_dyn_price = 0 -%}
              {%- assign r_dyn_flag = '' -%}
              {%- assign r_found = false -%}

              {%- for item in region_display_pairs -%}
                {%- if item != blank and r_found == false -%}
                  {%- assign parts = item | split: '::' -%}
                  {%- assign item_rname = parts[0] | strip -%}
                  {%- assign item_rprice = parts[1] | plus: 0 -%}
                  {%- assign item_rflag = parts[2] | strip -%}

                  {%- assign item_rcompact = item_rname | strip | downcase | replace: '_', ' ' | replace: '-', ' ' | replace: ' ', '' -%}
                  {%- if item_rcompact == r_key -%}
                    {%- assign r_found = true -%}
                    {%- assign r_dyn_price = item_rprice -%}
                    {%- if item_rflag != blank -%}
                      {%- assign r_dyn_flag = item_rflag | split: '/' | last | file_url -%}
                    {%- endif -%}
                  {%- endif -%}
                  {%- endif -%}
                {%- endfor -%}

                {%- assign flag_src = r_flag_fallback -%}
                {%- if r_dyn_flag != blank -%}
                  {%- assign flag_src = r_dyn_flag -%}
                {%- endif -%}

                {%- assign price_display = r_price_fallback -%}
                {%- if r_dyn_price > 0 -%}
                  {%- assign price_display = r_dyn_price | money_with_currency -%}
                  {%- if is_au -%}{%- assign price_display = price_display | append: ' AUD' -%}{%- endif -%}
                {%- endif -%}

                <a
                  href="{{ routes.search_url }}?q={{ r_name | replace: '_', ' ' | url_encode }}"
                  class="gkh-country"
                >
                  <div class="gkh-country__l">
                    <div class="gkh-country__flag">
                      <img
                        src="{{ flag_src }}"
                        width="50"
                        height="50"
                        alt="{{ r_name }}"
                        loading="lazy"
                      >
                    </div>
                    <div>
                      <span class="gkh-country__name">{{ r_name }}</span>
                      <p class="gkh-country__price">Start From {{ price_display }}</p>
                    </div>
                  </div>

                  <svg class="gkh-country__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
                </a>
            {%- endfor -%}
          </div>
        </div>

        {%- if section.settings.show_cta -%}
          <div class="gkh-more">
            <a
              href="{{ pages['all-destination'].url | default: '/pages/all-destination' }}"
              class="gkh-btn-o"
            >
              {{ 'homepage.popular_country.details.cta' | t }}
            </a>
          </div>
        {%- endif -%}
      </div>

      {{ paginate | default_pagination }}
    {%- endpaginate -%}

    <script>
      (function () {
        const root = document.querySelector('[data-popular-countries]') || document;
        const btns = root.querySelectorAll('.gkh-tab');
        const panels = root.querySelectorAll('.gkh-panel');

        function setActive(tab) {
          btns.forEach((b) => {
            const active = b.dataset.gkhTab === tab;
            b.classList.toggle('gkh-is-active', active);
            b.setAttribute('aria-selected', active ? 'true' : 'false');
          });
          panels.forEach((p) => {
            p.hidden = p.dataset.gkhPanel !== tab;
          });
          try { localStorage.setItem('activeTabSearch', tab); } catch(e){}
        }

        btns.forEach((btn) => {
          btn.addEventListener('click', () => {
            if (btn.dataset.gkhTab) setActive(btn.dataset.gkhTab);
          });
        });

        try {
          const saved = localStorage.getItem('activeTabSearch');
          if (saved) setActive(saved);
        } catch(e){}
      })();
    </script>
  </div>
</div>

<script type="application/ld+json">
  {{ page | structured_data }}
</script>

{% schema %}
{
  "name": "Popular Countries",
  "settings": [
    {
      "type": "select",
      "id": "country_mode",
      "label": "Display mode",
      "default": "all",
