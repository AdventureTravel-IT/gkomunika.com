<section class="gkh-sec">
  <div class="gkh-wrap">
    <div class="gkh-bhead">
      <h2 class="gkh-title">{{ section.settings.title | default: 'Blog Posts' }}</h2>
      <a class="gkh-btn-o" href="{{ section.settings.see_more_url | default: '/pages/news' }}">
        {{ section.settings.see_more_text | default: 'See More' }}
      </a>
    </div>

    <div class="gkh-blog">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          {% assign page_item = block.settings.page %}

          {% if page_item != blank %}
            {% assign first_img = '' %}
            {% assign parts = page_item.content | split: 'src="' %}
            {% if parts.size > 1 %}
              {% assign first_img = parts[1] | split: '"' | first %}
            {% endif %}

            {% if first_img == blank %}
              {% case page_item.handle %}
                {% when 'how-to-get-free-domestic-flight-tickets-in-thailand-for-tourists' %}
                  {% assign first_img = 'https://cdn.shopify.com/s/files/1/0735/4204/1817/files/thai_4a559a09-e2e9-4c5b-a212-5d641002ff08.jpg?v=1756893975' %}
                {% when 'blocked-imei-phones-can-use-esim-without-customs-registration-here-s-how' %}
                  {% assign first_img = 'https://cdn.shopify.com/s/files/1/0735/4204/1817/files/DALL_E_2025-02-24_17.07.28_-_A_conceptual_illustration_of_a_smartphone_surrounded_by_a_digital_barrier_symbolizing_an_IMEI-blocked_device._The_phone_screen_shows_a_subtle_IMEI_B.webp?v=1744270627' %}
                {% when 'can-a-passport-be-rejected-here-are-examples-of-damaged-passports-you-need-to-know' %}
                  {% assign first_img = 'https://cdn.shopify.com/s/files/1/0735/4204/1817/files/indonesia_passport_12b51a93-31a3-4d4e-bf5d-6b42e2118339.jpg?v=1754637061' %}
                {% when 'bca-poket-valas-a-convenient-solution-for-foreign-currency-transactions-abroad' %}
                  {% assign first_img = 'https://cdn.shopify.com/s/files/1/0735/4204/1817/files/poket_valas.jpg?v=1745298601' %}
              {% endcase %}
            {% endif %}

            <a class="gkh-post" href="{{ page_item.url }}" {{ block.shopify_attributes }}>
              <div class="gkh-post__img">
                {% if first_img != blank %}
                  <img src="{{ first_img }}" alt="{{ page_item.title | escape }}" loading="lazy">
                {% else %}
                  <div style="width:100%;height:100%;background:#cbd5e1;"></div>
                {% endif %}
              </div>
              <div class="gkh-post__body">
                <h3 class="gkh-post__t">{{ page_item.title }}</h3>
                <p class="gkh-post__p">{{ page_item.content | strip_html | truncate: 160 }}</p>
                <span class="gkh-post__more">
                  Read article
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </span>
              </div>
            </a>
          {% endif %}
        {% endfor %}

      {% else %}
        <!-- DEFAULT FALLBACK POSTS -->
        <a class="gkh-post" href="/pages/how-to-get-free-domestic-flight-tickets-in-thailand-for-tourists">
          <div class="gkh-post__img">
            <img src="https://cdn.shopify.com/s/files/1/0735/4204/1817/files/thai_4a559a09-e2e9-4c5b-a212-5d641002ff08.jpg?v=1756893975" alt="How to Get Free Domestic Flight Tickets in Thailand for Tourists" loading="lazy">
          </div>
          <div class="gkh-post__body">
            <h3 class="gkh-post__t">How to Get Free Domestic Flight Tickets in Thailand for Tourists</h3>
            <p class="gkh-post__p">Good news for tourists planning to travel to Thailand! Starting this September, the Thai government is launching a new program that allows international tourists...</p>
            <span class="gkh-post__more">Read article <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
          </div>
        </a>

        <a class="gkh-post" href="/pages/blocked-imei-phones-can-use-esim-without-customs-registration-here-s-how">
          <div class="gkh-post__img">
            <img src="https://cdn.shopify.com/s/files/1/0735/4204/1817/files/DALL_E_2025-02-24_17.07.28_-_A_conceptual_illustration_of_a_smartphone_surrounded_by_a_digital_barrier_symbolizing_an_IMEI-blocked_device._The_phone_screen_shows_a_subtle_IMEI_B.webp?v=1744270627" alt="Blocked IMEI Phones Can Use eSIM Without Customs Registration: Here’s How" loading="lazy">
          </div>
          <div class="gkh-post__body">
            <h3 class="gkh-post__t">Blocked IMEI Phones Can Use eSIM Without Customs Registration: Here’s How</h3>
            <p class="gkh-post__p">IMEI (International Mobile Equipment Identity) is a unique identification number found on every mobile phone, whether it&#x27;s an Android or iPhone. This number...</p>
            <span class="gkh-post__more">Read article <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
          </div>
        </a>

        <a class="gkh-post" href="/pages/can-a-passport-be-rejected-here-are-examples-of-damaged-passports-you-need-to-know">
          <div class="gkh-post__img">
            <img src="https://cdn.shopify.com/s/files/1/0735/4204/1817/files/indonesia_passport_12b51a93-31a3-4d4e-bf5d-6b42e2118339.jpg?v=1754637061" alt="Can a Passport Be Rejected? Here Are Examples of Damaged Passports You Need to Know" loading="lazy">
          </div>
          <div class="gkh-post__body">
            <h3 class="gkh-post__t">Can a Passport Be Rejected? Here Are Examples of Damaged Passports You Need to Know</h3>
            <p class="gkh-post__p">Recently, the French Embassy announced that they no longer accept passports with staple holes, as these are considered defective or damaged passports. This...</p>
            <span class="gkh-post__more">Read article <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
          </div>
        </a>

        <a class="gkh-post" href="/pages/bca-poket-valas-a-convenient-solution-for-foreign-currency-transactions-abroad">
          <div class="gkh-post__img">
            <img src="https://cdn.shopify.com/s/files/1/0735/4204/1817/files/poket_valas.jpg?v=1745298601" alt="BCA Poket Valas: A Convenient Solution for Foreign Currency Transactions Abroad" loading="lazy">
          </div>
          <div class="gkh-post__body">
            <h3 class="gkh-post__t">BCA Poket Valas: A Convenient Solution for Foreign Currency Transactions Abroad</h3>
            <p class="gkh-post__p">Poket Valas is a smart and practical solution for travelers looking to make foreign currency transactions abroad! Managing multiple currencies with ease is...</p>
            <span class="gkh-post__more">Read article <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
          </div>
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Top Article",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Blog Posts"
    },
    {
      "type": "text",
      "id": "see_more_text",
      "label": "Button Label",
      "default": "See More"
    },
    {
      "type": "url",
      "id": "see_more_url",
      "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Post Card",
      "settings": [
        {
          "type": "page",
          "id": "page",
          "label": "Select Page"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Top Article",
      "category": "Custom Sections"
    }
  ]
}
{% endschema %}
