{%- comment -%}
  Enrich Shopify purchase dataLayer events for Google Ads Enhanced Conversions.
  Intended for checkout/thank-you contexts where `checkout` and `first_time_accessed`
  are available. It does not emit a duplicate purchase event; it patches existing
  purchase pushes with prioritized email user data.
{%- endcomment -%}

{%- liquid
  assign purchase_email = checkout.email | default: checkout.customer.email | default: customer.email
  assign purchase_address = checkout.billing_address | default: checkout.shipping_address
  assign purchase_first_name = purchase_address.first_name | default: checkout.customer.first_name
  assign purchase_last_name = purchase_address.last_name | default: checkout.customer.last_name
  assign purchase_region = purchase_address.province_code | default: purchase_address.province
  assign purchase_country = purchase_address.country_code | default: purchase_address.country
  assign purchase_phone = checkout.phone | default: purchase_address.phone
  assign purchase_address_complete = false

  if purchase_first_name != blank and purchase_last_name != blank and purchase_address.address1 != blank and purchase_address.city != blank and purchase_region != blank and purchase_address.zip != blank and purchase_country != blank
    assign purchase_address_complete = true
  endif
-%}

{%- if first_time_accessed and purchase_email != blank -%}
  <script>
    (function () {
      window.dataLayer = window.dataLayer || [];

      var purchaseUserData = {
        email: {{ purchase_email | strip | downcase | json }}
      };

      {%- if purchase_phone != blank -%}
        purchaseUserData.phone_number = {{ purchase_phone | strip | json }};
      {%- endif -%}

      {%- if purchase_address_complete -%}
        purchaseUserData.address = {
          first_name: {{ purchase_first_name | strip | json }},
          last_name: {{ purchase_last_name | strip | json }},
          street: {{ purchase_address.address1 | strip | json }},
          city: {{ purchase_address.city | strip | json }},
          region: {{ purchase_region | strip | json }},
          postal_code: {{ purchase_address.zip | strip | json }},
          country: {{ purchase_country | strip | upcase | json }}
        };
      {%- endif -%}

      function cleanAddress(userData) {
        if (!purchaseUserData.address && userData && Object.prototype.hasOwnProperty.call(userData, 'address')) {
          delete userData.address;
        }
      }

      function enrichPurchasePayload(payload) {
        if (!payload || typeof payload !== 'object' || payload.event !== 'purchase') {
          return payload;
        }

        var userData = Object.assign({}, payload.user_data || {});
        userData.email = purchaseUserData.email;

        if (purchaseUserData.phone_number && !userData.phone_number) {
          userData.phone_number = purchaseUserData.phone_number;
        }

        if (purchaseUserData.address) {
          userData.address = purchaseUserData.address;
        } else {
          cleanAddress(userData);
        }

        payload.user_data = userData;
        payload.enhanced_conversion_data = Object.assign({}, payload.enhanced_conversion_data || {}, userData);
        payload.customer = Object.assign({}, payload.customer || {}, {
          email: purchaseUserData.email
        });
        payload.email = purchaseUserData.email;

        if (!purchaseUserData.address) {
          cleanAddress(payload.enhanced_conversion_data);
        }

        return payload;
      }

      function enrichExistingPurchases() {
        window.dataLayer.forEach(enrichPurchasePayload);
      }

      function patchDataLayerPush() {
        if (window.dataLayer.push && window.dataLayer.push.gkomunikaPurchaseUserDataPatched) {
          return;
        }

        var originalPush = window.dataLayer.push;

        window.dataLayer.push = function () {
          for (var index = 0; index < arguments.length; index += 1) {
            enrichPurchasePayload(arguments[index]);
          }

          return originalPush.apply(window.dataLayer, arguments);
        };

        window.dataLayer.push.gkomunikaPurchaseUserDataPatched = true;
      }

      enrichExistingPurchases();
      patchDataLayerPush();
      setTimeout(function () {
        enrichExistingPurchases();
        patchDataLayerPush();
      }, 0);
      setTimeout(patchDataLayerPush, 500);
      setTimeout(patchDataLayerPush, 1500);

      window.gkomunikaPurchaseUserData = purchaseUserData;
    })();
  </script>
{%- endif -%}
