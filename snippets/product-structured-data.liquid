{%- comment -%}
  Product & BreadcrumbList JSON-LD for GEO and Google Product Snippets / Merchant Listings.
  Aligns @id with Judge.me (jdgm-aggregate-rating-jld) and omits aggregateRating to avoid duplicate schemas.
{%- endcomment -%}
{%- liquid
  assign origin_url = request.origin | default: shop.secure_url
  assign product_clean_path = product.url | split: '?' | first
  assign product_fallback_url = origin_url | append: product_clean_path
  assign product_canonical_url = canonical_url | default: product_fallback_url | split: '?' | first
  assign product_schema_id = product_canonical_url | append: '#product'
  assign schema_currency = cart.currency.iso_code | default: shop.currency | default: 'IDR'
  assign primary_variant = product.selected_or_first_available_variant

  assign clean_description = product.description | newline_to_br | replace: '<br />', ' ' | replace: '<br>', ' ' | replace: '</p>', ' ' | replace: '</li>', ' ' | strip_html | replace: '&nbsp;', ' ' | replace: '&amp;', '&' | strip_newlines | split: ' ' | join: ' ' | strip

  assign home_path = routes.root_url | default: '/'
  assign home_url = origin_url | append: home_path

  assign images_json_str = ''
  if product.media.size > 0
    for media in product.media limit: 5
      if media.preview_image
        assign media_src = media.preview_image | image_url: width: 1200
        unless media_src contains 'http'
          assign media_src = 'https:' | append: media_src
        endunless
        assign media_src_json = media_src | json
        if images_json_str != blank
          assign images_json_str = images_json_str | append: ',' | append: media_src_json
        else
          assign images_json_str = media_src_json
        endif
      endif
    endfor
  elsif product.featured_image
    assign featured_src = product.featured_image | image_url: width: 1200
    unless featured_src contains 'http'
      assign featured_src = 'https:' | append: featured_src
    endunless
    assign images_json_str = featured_src | json
  endif
-%}

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "@id": {{ product_schema_id | json }},
    "name": {{ product.title | json }},
    {%- if clean_description != blank %}
    "description": {{ clean_description | json }},
    {%- endif %}
    {%- if product.type != blank %}
    "category": {{ product.type | json }},
    {%- endif %}
    {%- if primary_variant.sku != blank %}
    "sku": {{ primary_variant.sku | json }},
    {%- endif %}
    {%- if images_json_str != blank %}
    "image": [{{ images_json_str }}],
    {%- endif %}
    "brand": {
      "@type": "Brand",
      "name": {{ product.vendor | default: shop.name | json }}
    },
    "url": {{ product_canonical_url | json }},
    {%- if product.variants.size > 0 %}
    "offers": [
      {%- for variant in product.variants -%}
        {%- capture v_price -%}{%- render 'format-idr', cents: variant.price, mode: 'numeric' -%}{%- endcapture -%}
        {%- assign v_price = v_price | strip -%}
        {%- assign v_url = origin_url | append: variant.url -%}
        {%- assign v_name = variant.title -%}
        {%- if v_name == 'Default Title' or v_name == blank -%}
          {%- assign v_name = product.title -%}
        {%- endif -%}
        {%- assign bc_len = variant.barcode | size -%}
      {
        "@type": "Offer",
        "name": {{ v_name | json }},
        "price": {{ v_price | json }},
        "priceCurrency": {{ schema_currency | json }},
        "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
        {%- if variant.sku != blank %}
        "sku": {{ variant.sku | json }},
        {%- endif %}
        {%- if variant.barcode != blank -%}
          {%- if bc_len == 12 %}
        "gtin12": {{ variant.barcode | json }},
          {%- elsif bc_len == 13 %}
        "gtin13": {{ variant.barcode | json }},
          {%- elsif bc_len == 14 %}
        "gtin14": {{ variant.barcode | json }},
          {%- endif -%}
        {%- endif %}
        "itemCondition": "https://schema.org/NewCondition",
        "url": {{ v_url | json }}
      }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor %}
    ]
    {%- else %}
      {%- capture p_price -%}{%- render 'format-idr', cents: product.price, mode: 'numeric' -%}{%- endcapture -%}
      {%- assign p_price = p_price | strip -%}
    "offers": {
      "@type": "Offer",
      "name": {{ product.title | json }},
      "price": {{ p_price | json }},
      "priceCurrency": {{ schema_currency | json }},
      "availability": "https://schema.org/{% if product.available %}InStock{% else %}OutOfStock{% endif %}",
      "itemCondition": "https://schema.org/NewCondition",
      "url": {{ product_canonical_url | json }}
    }
    {%- endif %}
  }
</script>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": {{ home_url | json }}
      },
      {%- if collection != blank -%}
        {%- assign col_url = origin_url | append: collection.url -%}
      {
        "@type": "ListItem",
        "position": 2,
        "name": {{ collection.title | json }},
        "item": {{ col_url | json }}
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": {{ product.title | json }},
        "item": {{ product_canonical_url | json }}
      }
      {%- else -%}
      {
        "@type": "ListItem",
        "position": 2,
        "name": {{ product.title | json }},
        "item": {{ product_canonical_url | json }}
      }
      {%- endif %}
    ]
  }
</script>
