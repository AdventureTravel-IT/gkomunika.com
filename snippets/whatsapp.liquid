<div
  class="whatsapp-fab"
  aria-label="Chat WhatsApp dengan kami"
>
  <script async src="https://chat.gkomunika.com/widget/v1/embed.js?key=wid_b7865048688cd7f840a8407cddcc5e0e"></script>

  <span class="sr-only">Chat WhatsApp dengan kami</span>
</div>

<script>
  (function () {
    var params = new URLSearchParams(window.location.search);
    var required = {
      utm_source: 'gk_qontak',
      utm_medium: 'Organic',
      utm_campaign: 'GK_Qontak',
      utm_content: 'gk_qontak'
    };
    for (var key in required) {
      if (params.get(key) !== required[key]) return;
    }

    // embed.js loads async and exposes window.GKChat once ready.
    var attempts = 0;
    var timer = setInterval(function () {
      if (window.GKChat && typeof window.GKChat.open === 'function') {
        clearInterval(timer);
        window.GKChat.open();
      } else if (++attempts > 50) {
        clearInterval(timer);
      }
    }, 200);
  })();
</script>

{% style %}
  .whatsapp-fab {
    position: fixed;
    bottom: 85px;
    right: 50px;
    width: 70px;
    height: 70px;
    border-radius: 50%;
    box-shadow: var(--box-shadow);
    z-index: 999;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    border: none;
    outline: none;
  }

  .whatsapp-fab:focus-visible {
    box-shadow: 0 0 0 3px #fff, 0 0 0 6px #1e9e56;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media screen and (min-width: 430px) and (max-width: 440px) {
    .whatsapp-fab {
      right: 15px !important;
      bottom: 100px !important;
    }
  }

  @media (max-width: 426px) {
    .whatsapp-fab {
      width: 60px;
      height: 60px;
      right: 20px;
      bottom: 120px;
    }
  }
{% endstyle %}
